@using N4Sentinel.Domain
@using N4Sentinel.Web.State

@inject ReferentialService Referential
@inject SupervisionStateCache SupervisionCache
@inject NodeVitalsService Vitals
@inject CurrentEnvironmentState EnvState
@implements IDisposable

<div class="w-full max-w-full overflow-hidden space-y-6">

    <!-- Top Filter & Smart Search Header -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 p-5 rounded-3xl bg-slate-900/80 border border-slate-800 backdrop-blur-xl shadow-xl">
        <div class="flex items-center gap-4">
            <div class="w-11 h-11 rounded-2xl bg-theme-gradient text-white flex items-center justify-center text-xl font-black shadow-lg glow-theme">
                <i class="bi bi-diagram-3-fill"></i>
            </div>
            <div>
                <h3 class="text-base font-extrabold text-white tracking-tight">Cartographie Topologique Navis N4 (Architecture CIT)</h3>
                <p class="text-xs text-slate-400">Disposition officielle selon la cartographie Navis N4 &middot; Cliquer sur un nœud pour ouvrir ses télémétries</p>
            </div>
        </div>

        <div class="flex flex-wrap items-center gap-3 text-xs font-semibold">
            <!-- Smart Search Input Bar -->
            <div class="relative min-w-[220px]">
                <i class="bi bi-search absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                <input type="text"
                       placeholder="Rechercher nœud, IP, service..."
                       class="w-full bg-slate-950 border border-slate-700 focus:border-sky-400 text-white rounded-xl pl-9 pr-3 py-1.5 text-xs font-medium focus:ring-2 focus:ring-sky-500/20 focus:outline-none placeholder-slate-500 transition"
                       @bind="_searchQuery" @bind:event="oninput" />
            </div>

            <!-- Environment Selector Dropdown -->
            @if (_environments.Count > 0)
            {
                <div class="flex items-center gap-2.5 bg-slate-950 px-3.5 py-1.5 rounded-xl border border-slate-800 shadow-md">
                    <i class="bi bi-hdd-network text-theme-primary text-xs"></i>
                    <select class="bg-transparent text-white font-bold text-xs focus:outline-none cursor-pointer"
                            value="@_selectedEnvironmentId" @onchange="OnEnvironmentSelected">
                        @foreach (var env in _environments)
                        {
                            <option value="@env.Id" class="bg-slate-900 text-white">@env.Code — @env.Name @(env.IsProduction ? "(PROD)" : "")</option>
                        }
                    </select>
                </div>
            }

            <!-- Legend Indicators -->
            <div class="flex items-center gap-3 flex-wrap bg-slate-950 px-3.5 py-1.5 rounded-xl border border-slate-800 shadow-md">
                <span class="flex items-center gap-1.5 text-emerald-400 font-bold">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse shadow-sm"></span> Running
                </span>
                <span class="flex items-center gap-1.5 text-amber-400 font-bold">
                    <span class="w-2.5 h-2.5 rounded-full bg-amber-400 shadow-sm"></span> Démarrage
                </span>
                <span class="flex items-center gap-1.5 text-rose-400 font-bold">
                    <span class="w-2.5 h-2.5 rounded-full bg-rose-400 shadow-sm"></span> À l'arrêt
                </span>
                <span class="flex items-center gap-1.5 text-slate-400 font-bold">
                    <span class="w-2.5 h-2.5 rounded-full bg-slate-500 shadow-sm"></span> Non supervisé
                </span>
            </div>
        </div>
    </div>

    <!-- MAIN DIAGRAM CONTAINER (Fit 100% width, No Horizontal Scrollbar) -->
    <div class="w-full max-w-full overflow-hidden p-4 sm:p-6 lg:p-8 rounded-[2rem] border-2 border-theme-primary/30 bg-slate-950/90 backdrop-blur-2xl relative shadow-2xl space-y-6">
        
        <!-- Watermark Badge -->
        <div class="absolute top-4 right-6 hidden sm:flex items-center gap-2 px-3 py-1 rounded-xl bg-theme-subtle border border-theme-border text-xs font-black text-theme-primary uppercase tracking-widest">
            <span>Navis N4 Architecture</span>
            <i class="bi bi-shield-check"></i>
        </div>

        <!-- TOP / LEFT SYSTEM LAYOUT GRID -->
        <div class="grid grid-cols-1 xl:grid-cols-12 gap-6 items-stretch">
            
            <!-- LEFT COLUMN: EXTERNAL SYSTEMS (GOS, SFTP, IPAK) -->
            <div class="xl:col-span-2 space-y-4 flex flex-col justify-between p-4 rounded-2xl bg-slate-900/40 border border-slate-800">
                <div class="text-[11px] font-black text-slate-400 uppercase tracking-widest border-b border-slate-800 pb-2 text-center">
                    <i class="bi bi-diagram-2-fill text-slate-400"></i> Système Externe
                </div>

                <!-- Gate Operating System (GOS) -->
                <div @onclick='() => OpenStaticNodeModal("Gate Operating System (GOS)", "Interface Portuaire GOS", "SRV-GOS-01", "10.88.190.10", "GOSGateService")'
                     class="p-3.5 rounded-2xl bg-slate-900 border border-slate-700 hover:border-sky-400 transition-all duration-200 cursor-pointer shadow-lg hover:scale-105 text-center space-y-1 @(IsMatchQuery("GOS") ? "ring-2 ring-sky-400 shadow-sky-500/50" : "")">
                    <div class="w-8 h-8 rounded-xl bg-slate-800 text-sky-400 flex items-center justify-center mx-auto text-base">
                        <i class="bi bi-door-open-fill"></i>
                    </div>
                    <div class="text-xs font-bold text-white leading-tight">Gate Operating System</div>
                    <div class="text-[10px] font-mono text-slate-400">GOS / Guérites</div>
                </div>

                <!-- Server SFTP (EDI) -->
                <div @onclick='() => OpenStaticNodeModal("Server SFTP EDI", "Serveur Envoi/Réception EDI", "SRV-EDI-SFTP01", "10.88.190.12", "SftpEDIDaemon")'
                     class="p-3.5 rounded-2xl bg-slate-900 border border-slate-700 hover:border-indigo-400 transition-all duration-200 cursor-pointer shadow-lg hover:scale-105 text-center space-y-1 @(IsMatchQuery("SFTP") || IsMatchQuery("EDI") ? "ring-2 ring-indigo-400 shadow-indigo-500/50" : "")">
                    <div class="w-8 h-8 rounded-xl bg-slate-800 text-indigo-400 flex items-center justify-center mx-auto text-base">
                        <i class="bi bi-folder-symlink-fill"></i>
                    </div>
                    <div class="text-xs font-bold text-white leading-tight">Server SFTP (EDI)</div>
                    <div class="text-[10px] font-mono text-slate-400">Flux EDI / Partenaires</div>
                </div>

                <!-- Billing System (IPAK) -->
                <div @onclick='() => OpenStaticNodeModal("Billing System (IPAK)", "Système de Facturation Portuaire", "SRV-IPAK-BILL01", "10.88.190.14", "IpakBillingService")'
                     class="p-3.5 rounded-2xl bg-slate-900 border border-slate-700 hover:border-emerald-400 transition-all duration-200 cursor-pointer shadow-lg hover:scale-105 text-center space-y-1 @(IsMatchQuery("IPAK") || IsMatchQuery("Billing") ? "ring-2 ring-emerald-400 shadow-emerald-500/50" : "")">
                    <div class="w-8 h-8 rounded-xl bg-slate-800 text-emerald-400 flex items-center justify-center mx-auto text-base">
                        <i class="bi bi-receipt-cutoff"></i>
                    </div>
                    <div class="text-xs font-bold text-white leading-tight">Billing System (IPAK)</div>
                    <div class="text-[10px] font-mono text-slate-400">Facturation N4</div>
                </div>
            </div>

            <!-- CENTER & RIGHT AREA: MAIN NAVIS N4 ECOSYSTEM CONTAINER (Columns 3-12) -->
            <div class="xl:col-span-10 p-5 sm:p-6 rounded-3xl border-2 border-slate-800 bg-slate-900/30 space-y-6">
                
                <!-- TOP BANNER: CLIENTS & LOAD BALANCER -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-center">
                    <!-- N4 Mobile & Clients -->
                    <div class="flex items-center justify-center gap-3">
                        <div @onclick='() => OpenStaticNodeModal("N4 Mobile", "Client Mobile Terminal", "MOB-N4-01", "10.88.195.50", "N4MobileApp")'
                             class="px-3.5 py-2 rounded-2xl bg-slate-900 border border-slate-700 hover:border-sky-400 transition cursor-pointer text-center space-y-0.5 @(IsMatchQuery("Mobile") ? "ring-2 ring-sky-400" : "")">
                            <i class="bi bi-phone-fill text-sky-400 text-base"></i>
                            <div class="text-[11px] font-bold text-white">N4 Mobile</div>
                        </div>
                        <div @onclick='() => OpenStaticNodeModal("N4 Clients", "Stations de Travail Clients", "CLI-N4-ALL", "10.88.195.100", "NavisClientGui")'
                             class="px-3.5 py-2 rounded-2xl bg-slate-900 border border-slate-700 hover:border-sky-400 transition cursor-pointer text-center space-y-0.5 @(IsMatchQuery("Clients") ? "ring-2 ring-sky-400" : "")">
                            <i class="bi bi-display-fill text-sky-400 text-base"></i>
                            <div class="text-[11px] font-bold text-white">N4 Clients</div>
                        </div>
                    </div>

                    <!-- Load Balancer -->
                    <div @onclick='() => OpenStaticNodeModal("Load Balancer", "Répartiteur de Charge N4", "N4-LB-VIP01", "10.88.180.100", "N4LoadBalancerService")'
                         class="p-3.5 rounded-2xl bg-amber-500/10 border-2 border-amber-500/40 hover:border-amber-400 transition cursor-pointer text-center shadow-lg space-y-1 @(IsMatchQuery("Balancer") || IsMatchQuery("LB") ? "ring-2 ring-amber-400" : "")">
                        <div class="text-xs font-black text-amber-400 uppercase tracking-wider flex items-center justify-center gap-1.5">
                            <i class="bi bi-arrow-down-up"></i> Load Balancer
                        </div>
                        <div class="text-[11px] font-bold text-white">VIP Cluster &middot; Dispatch TCP / HTTP</div>
                    </div>

                    <!-- XPS Clients -->
                    <div class="flex items-center justify-center">
                        <div @onclick='() => OpenStaticNodeModal("XPS Clients", "Postes Clients XPS Decking/Dispatcher", "CLI-XPS-ALL", "10.88.195.200", "XpsClientApp")'
                             class="px-4 py-2 rounded-2xl bg-slate-900 border border-slate-700 hover:border-purple-400 transition cursor-pointer text-center space-y-0.5 @(IsMatchQuery("XPS") ? "ring-2 ring-purple-400" : "")">
                            <i class="bi bi-pc-display text-purple-400 text-base"></i>
                            <div class="text-[11px] font-bold text-white">XPS Clients</div>
                        </div>
                    </div>
                </div>

                <!-- MIDDLE SECTION: CLUSTER NODES vs CENTER/STANDBY vs XPS/ECN4 -->
                <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
                    
                    <!-- BOX 1: CLUSTER NODES (Columns 1-6) -->
                    <div class="md:col-span-6 p-5 rounded-2xl border-2 border-sky-500/30 bg-sky-950/20 space-y-4">
                        <div class="flex items-center justify-between border-b border-sky-500/30 pb-2">
                            <h4 class="text-xs font-black text-sky-400 uppercase tracking-wider flex items-center gap-2">
                                <i class="bi bi-cpu-fill"></i> CLUSTER NODES
                            </h4>
                            <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-sky-500/20 text-sky-300">
                                @GetClusterNodes().Count nœud(s)
                            </span>
                        </div>

                        @if (GetClusterNodes().Count == 0)
                        {
                            <div class="text-center text-slate-500 text-xs py-6 italic">Aucun nœud cluster configuré.</div>
                        }
                        else
                        {
                            <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-3">
                                @foreach (var c in GetClusterNodes())
                                {
                                    @RenderInteractiveNode(c)
                                }
                            </div>
                        }
                    </div>

                    <!-- BOX 2: CENTER / STANDBY NODE (Columns 7-9) -->
                    <div class="md:col-span-3 p-5 rounded-2xl border-2 border-emerald-500/30 bg-emerald-950/20 space-y-4 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between border-b border-emerald-500/30 pb-2 mb-3">
                                <h4 class="text-xs font-black text-emerald-400 uppercase tracking-wider flex items-center gap-2">
                                    <i class="bi bi-hdd-network-fill"></i> CENTER / STANDBY
                                </h4>
                            </div>

                            @if (GetMasterNodes().Count == 0)
                            {
                                <div class="text-center text-slate-500 text-xs py-6 italic">Aucun nœud maître.</div>
                            }
                            else
                            {
                                <div class="space-y-3">
                                    @foreach (var c in GetMasterNodes())
                                    {
                                        @RenderInteractiveNode(c)
                                    }
                                </div>
                            }
                        </div>

                    </div>

                    <!-- BOX 3: XPS / BRIDGE & ECN4 (Columns 10-12) -->
                    <div class="md:col-span-3 p-5 rounded-2xl border-2 border-purple-500/30 bg-purple-950/20 space-y-4 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between border-b border-purple-500/30 pb-2 mb-3">
                                <h4 class="text-xs font-black text-purple-400 uppercase tracking-wider flex items-center gap-2">
                                    <i class="bi bi-display-fill"></i> MODULES XPS &amp; ECN
                                </h4>
                            </div>

                            @if (GetXpsNodes().Count == 0)
                            {
                                <div class="text-center text-slate-500 text-xs py-6 italic">Aucun module XPS / ECN.</div>
                            }
                            else
                            {
                                <div class="space-y-3">
                                    @foreach (var c in GetXpsNodes())
                                    {
                                        @RenderInteractiveNode(c)
                                    }
                                </div>
                            }
                        </div>

                    </div>
                </div>

                <!-- BOTTOM AREA: CLUSTER DATABASE (Columns 1-12) -->
                <div class="p-5 rounded-2xl border-2 border-indigo-500/30 bg-indigo-950/20 space-y-4">
                    <div class="flex items-center justify-between border-b border-indigo-500/30 pb-2">
                        <h4 class="text-xs font-black text-indigo-400 uppercase tracking-wider flex items-center gap-2">
                            <i class="bi bi-database-fill-gear"></i> CLUSTER DATABASE (HAUTE DISPONIBILITÉ)
                        </h4>
                        <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-indigo-500/20 text-indigo-300">
                            @GetDatabaseNodes().Count base(s)
                        </span>
                    </div>

                    @if (GetDatabaseNodes().Count == 0)
                    {
                        <div class="text-center text-slate-500 text-xs py-6 italic">Aucune base de données déclarée.</div>
                    }
                    else
                    {
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            @foreach (var c in GetDatabaseNodes())
                            {
                                @RenderInteractiveNode(c, isLarge: true)
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- BOTTOM ROW: EXTERNAL SYSTEMS -->
        @if (GetExternalNodes().Count > 0)
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 pt-2 border-t border-slate-800">
                @foreach (var c in GetExternalNodes())
                {
                    @RenderInteractiveNode(c)
                }
            </div>
        }
    </div>
</div>

<!-- TELEMETRY MODAL DIALOG (Opened on node click) -->
@if (_showTelemetryModal && _activeTelemetry is not null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-md animate-fadeIn">
        <div class="w-full max-w-2xl rounded-3xl bg-slate-900 border border-slate-800 shadow-2xl overflow-hidden space-y-0">
            <!-- Modal Header -->
            <div class="p-5 bg-slate-950 border-b border-slate-800 flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-2xl bg-theme-gradient text-white flex items-center justify-center text-lg font-black shadow-lg">
                        <i class="bi bi-cpu-fill"></i>
                    </div>
                    <div>
                        <h3 class="text-base font-extrabold text-white">@_activeTelemetry.Name</h3>
                        <p class="text-xs font-mono text-slate-400">@_activeTelemetry.Role &middot; @_activeTelemetry.HostName (@_activeTelemetry.IpAddress)</p>
                    </div>
                </div>
                <button @onclick="CloseTelemetryModal" class="p-2 rounded-xl text-slate-400 hover:text-white bg-slate-900 border border-slate-800 transition">
                    <i class="bi bi-x-lg text-sm"></i>
                </button>
            </div>

            <!-- Modal Content -->
            <div class="p-6 space-y-6 max-h-[80vh] overflow-y-auto text-xs">

                @if (_activeTelemetry.IsStatic)
                {
                    <!-- Système périphérique hors référentiel N4 : jamais de télémétrie réelle -->
                    <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800 text-slate-400 leading-relaxed flex items-start gap-2">
                        <i class="bi bi-info-circle-fill text-sky-400 mt-0.5"></i>
                        <span>
                            Système périphérique non intégré au référentiel N4 Sentinel — fiche de référence
                            uniquement, aucune mesure en temps réel.
                        </span>
                    </div>
                    <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800 font-mono text-[11px] text-slate-300">
                        Service / rôle : @_activeTelemetry.ServiceName
                    </div>
                }
                else if (_loadingTelemetry)
                {
                    <div class="p-10 text-center text-slate-400">
                        <div class="animate-spin inline-block w-6 h-6 border-2 border-sky-400 border-t-transparent rounded-full mb-3"></div>
                        <div>Interrogation du serveur en cours…</div>
                    </div>
                }
                else if (_activeTelemetry.Vitals is not { Reachable: true } && _activeTelemetry.Vitals is var injoignable)
                {
                    <div class="p-5 rounded-2xl bg-slate-800/40 border border-slate-700 text-slate-300 leading-relaxed flex items-start gap-2">
                        <i class="bi bi-exclamation-octagon-fill text-slate-400 mt-0.5"></i>
                        <span>
                            <strong class="text-white">Serveur injoignable.</strong>
                            @(injoignable?.Error ?? "Aucune information technique disponible pour ce composant.")
                        </span>
                    </div>
                }
                else
                {
                    var vitals = _activeTelemetry.Vitals;

                    <!-- System Telemetry Grid: CPU & RAM -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <!-- CPU Usage -->
                        <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800 space-y-2">
                            <div class="flex items-center justify-between font-bold">
                                <span class="text-slate-400 flex items-center gap-1.5"><i class="bi bi-cpu text-sky-400"></i> Charge CPU</span>
                                <span class="text-white font-mono text-sm">@Pourcent(vitals.Metrics?.CpuPercent)</span>
                            </div>
                            <div class="w-full bg-slate-800 rounded-full h-2 overflow-hidden">
                                <div class="h-full rounded-full @Barre(vitals.Metrics?.CpuPercent, 75, 90)"
                                     style="width: @Largeur(vitals.Metrics?.CpuPercent)"></div>
                            </div>
                            <div class="text-[10px] text-slate-500 font-medium">
                                @if (vitals.Metrics?.LogicalProcessors is { } coeurs)
                                {
                                    <text>@coeurs cœur(s) logique(s)</text>
                                }
                                else
                                {
                                    <text>Charge processeur serveur nœud</text>
                                }
                            </div>
                        </div>

                        <!-- RAM Usage -->
                        <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800 space-y-2">
                            <div class="flex items-center justify-between font-bold">
                                <span class="text-slate-400 flex items-center gap-1.5"><i class="bi bi-memory text-purple-400"></i> Mémoire RAM</span>
                                <span class="text-white font-mono text-sm">@Octets(vitals.Metrics?.UsedMemoryBytes) / @Octets(vitals.Metrics?.TotalMemoryBytes)</span>
                            </div>
                            <div class="w-full bg-slate-800 rounded-full h-2 overflow-hidden">
                                <div class="h-full rounded-full @Barre(vitals.Metrics?.MemoryUsedPercent, 85, 93)"
                                     style="width: @Largeur(vitals.Metrics?.MemoryUsedPercent)"></div>
                            </div>
                            <div class="text-[10px] text-slate-500 font-medium">@Pourcent(vitals.Metrics?.MemoryUsedPercent) occupé</div>
                        </div>
                    </div>

                    <!-- NTP Domain Sync & Windows Updates -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <!-- NTP Compliance -->
                        <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800 space-y-2">
                            <div class="text-slate-400 font-bold flex items-center gap-1.5">
                                <i class="bi bi-clock-history text-emerald-400"></i> Horloge &amp; Synchronisation NTP
                            </div>
                            @if (vitals.Clock is { } horloge)
                            {
                                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full font-extrabold border @PastilleHorloge(horloge.State)">
                                    <i class="bi @(horloge.State == ClockState.Conforme ? "bi-check-circle-fill" : horloge.State == ClockState.NonConforme ? "bi-x-circle-fill" : "bi-question-circle-fill")"></i>
                                    @horloge.Summary
                                </span>
                                <p class="text-[10px] text-slate-500 leading-relaxed">@horloge.Detail</p>
                            }
                            else
                            {
                                <span class="text-slate-500">État non relevé.</span>
                            }
                        </div>

                        <!-- Windows Updates -->
                        <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800 space-y-2">
                            <div class="text-slate-400 font-bold flex items-center gap-1.5">
                                <i class="bi bi-box-seam text-amber-400"></i> Mises à Jour Windows
                            </div>
                            @if (vitals.Updates is null)
                            {
                                <p class="text-[11px] text-slate-500 leading-relaxed">
                                    Jamais relevé — le relevé est lent (30 s à 2 min). Lancez-le depuis
                                    <a href="/vitalite" class="text-theme-primary hover:underline">Vitalité des nœuds</a>.
                                </p>
                            }
                            else if (!vitals.Updates.Succeeded)
                            {
                                <p class="text-[11px] text-rose-300 leading-relaxed">@vitals.Updates.Error</p>
                            }
                            else if (vitals.Updates.Snapshot is { } maj)
                            {
                                <div class="font-bold text-white text-xs">
                                    <span class="px-2.5 py-1 rounded-full bg-amber-500/10 text-amber-300 border border-amber-500/30">
                                        @maj.PendingCount patch(s) en attente
                                    </span>
                                </div>
                                <p class="text-[10px] @(vitals.Updates.IsStale ? "text-amber-400" : "text-slate-500")">
                                    Mesuré à @vitals.Updates.MeasuredAt.ToLocalTime().ToString("dd/MM HH:mm")
                                    @(vitals.Updates.IsStale ? " — mesure périmée." : ".")
                                </p>
                            }
                        </div>
                    </div>

                    <!-- Pending KB List -->
                    @if (vitals.Updates?.Snapshot?.Sample is { Count: > 0 } echantillon)
                    {
                        <div class="space-y-2">
                            <div class="text-slate-400 font-bold text-[11px] uppercase tracking-wider">Patchs Windows Update sur ce Nœud</div>
                            <div class="p-3 rounded-2xl bg-slate-950 border border-slate-800 space-y-1 font-mono text-[11px] text-slate-300">
                                @foreach (var kb in echantillon)
                                {
                                    <div class="flex items-center gap-2">
                                        <i class="bi bi-shield-exclamation text-amber-400"></i>
                                        <span>@kb</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- Disks Storage List -->
                    <div class="space-y-2">
                        <div class="text-slate-400 font-bold text-[11px] uppercase tracking-wider">Disques de Stockage</div>
                        @if (vitals.Metrics?.Disks is { Count: > 0 } disques)
                        {
                            <div class="grid grid-cols-1 gap-2.5">
                                @foreach (var disk in disques)
                                {
                                    <div class="p-3 rounded-2xl bg-slate-950 border border-slate-800 flex items-center justify-between gap-4 font-mono">
                                        <div>
                                            <div class="font-bold text-white">@disk.Drive</div>
                                            <div class="text-[10px] text-slate-500">@Octets(disk.FreeBytes) libre sur @Octets(disk.TotalBytes)</div>
                                        </div>
                                        <div class="text-right">
                                            <span class="font-bold text-sky-400">@((100 - disk.FreePercent).ToString("F0"))% occupé</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-slate-500 text-[11px]">Aucun disque relevé.</div>
                        }
                    </div>
                }
            </div>

            <!-- Modal Footer -->
            <div class="p-4 bg-slate-950 border-t border-slate-800 flex items-center justify-end">
                <button @onclick="CloseTelemetryModal" class="px-5 py-2 rounded-xl bg-theme-gradient text-white font-bold text-xs shadow-md">
                    Fermer
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid? EnvironmentId { get; set; }

    private string _searchQuery = string.Empty;
    private List<N4Environment> _environments = [];
    private Guid? _selectedEnvironmentId;
    private List<N4Component> _allComponents = [];

    /// <summary>FR-050 : dépendances déclarées, par composant dépendant.</summary>
    private Dictionary<Guid, List<ComponentDependency>> _dependances = [];

    /// <summary>
    /// FR-050 : composant dont on met les dépendances en évidence. La carte est
    /// une grille responsive, pas un canevas à coordonnées : tracer des traits
    /// entre cases exigerait de mesurer les positions en JavaScript et de les
    /// recalculer à chaque changement de taille. Éclairer les nœuds liés dit la
    /// même chose — « ceci dépend de cela » — sans dépendre d'une mesure qui
    /// peut se désaligner sans prévenir.
    /// </summary>
    private Guid? _dependancesMisesEnEvidence;

    private List<ComponentDependency> DependancesDe(Guid componentId)
        => _dependances.TryGetValue(componentId, out var d) ? d : [];

    /// <summary>Vrai si ce composant est une dépendance du composant mis en évidence.</summary>
    private bool EstDependanceMiseEnEvidence(Guid componentId)
        => _dependancesMisesEnEvidence is { } source
           && DependancesDe(source).Any(d => d.DependsOnComponentId == componentId);

    private string NomComposant(Guid id)
        => _allComponents.FirstOrDefault(c => c.Id == id)?.LogicalName ?? "composant retiré du référentiel";
    private List<N4Server> _allServers = [];

    private readonly List<N4Component> _clusterNodes = [];
    private readonly List<N4Component> _databaseNodes = [];
    private readonly List<N4Component> _masterNodes = [];
    private readonly List<N4Component> _xpsNodes = [];
    private readonly List<N4Component> _externalNodes = [];

    private bool _showTelemetryModal;
    private bool _loadingTelemetry;
    private NodeModalDto? _activeTelemetry;

    /// <summary>
    /// Fiche affichée dans le modal de nœud. Pour un composant réel du
    /// référentiel, <see cref="Vitals"/> porte la mesure effective, relevée à
    /// l'ouverture — plus aucune valeur inventée. Pour un système périphérique
    /// (GOS, DGPS...), <see cref="IsStatic"/> est vrai et aucune télémétrie
    /// n'est prétendue.
    /// </summary>
    public class NodeModalDto
    {
        public string Name { get; set; } = string.Empty;
        public string Role { get; set; } = string.Empty;
        public string HostName { get; set; } = string.Empty;
        public string IpAddress { get; set; } = string.Empty;
        public string ServiceName { get; set; } = string.Empty;
        public bool IsStatic { get; set; }
        public NodeVitals? Vitals { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        SupervisionCache.OnStateChanged += OnCacheStateChanged;
        EnvState.Changed += OnEnvStateChanged;
        await RefreshEnvironmentsAndComponentsAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (EnvironmentId.HasValue && EnvironmentId.Value != _selectedEnvironmentId)
        {
            _selectedEnvironmentId = EnvironmentId.Value;
            await LoadComponentsAsync();
        }
    }

    private void OnEnvStateChanged()
    {
        InvokeAsync(async () =>
        {
            if (EnvState.Current is not null && EnvState.Current.Id != _selectedEnvironmentId)
            {
                _selectedEnvironmentId = EnvState.Current.Id;
                await LoadComponentsAsync();
                StateHasChanged();
            }
        });
    }

    private async Task RefreshEnvironmentsAndComponentsAsync()
    {
        _environments = await Referential.GetEnvironmentsAsync();

        if (EnvironmentId.HasValue)
        {
            _selectedEnvironmentId = EnvironmentId.Value;
        }
        else if (EnvState.Current is not null)
        {
            _selectedEnvironmentId = EnvState.Current.Id;
        }
        else if (_environments.Count > 0)
        {
            var defaultEnv = _environments.FirstOrDefault(e => e.IsProduction) ?? _environments.First();
            _selectedEnvironmentId = defaultEnv.Id;
            EnvState.Set(defaultEnv);
        }

        await LoadComponentsAsync();
    }

    private async Task OnEnvironmentSelected(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var envId))
        {
            _selectedEnvironmentId = envId;
            var env = _environments.FirstOrDefault(x => x.Id == envId);
            if (env is not null)
            {
                EnvState.Set(env);
            }
            await LoadComponentsAsync();
            StateHasChanged();
        }
    }

    private async Task LoadComponentsAsync()
    {
        if (_selectedEnvironmentId.HasValue)
        {
            _allComponents = await Referential.GetComponentsAsync(_selectedEnvironmentId.Value);
            _allServers = await Referential.GetServersAsync(_selectedEnvironmentId.Value);

            // FR-050 : les dépendances déclarées, pour les rendre visibles sur
            // la carte. Elles n'existaient jusqu'ici que sur la fiche d'un
            // composant, où il fallait déjà savoir lequel ouvrir.
            _dependances = await Referential.GetDependenciesByEnvironmentAsync(
                _selectedEnvironmentId.Value);
        }
        else
        {
            _allComponents = [];
            _allServers = [];
            _dependances = [];
        }

        CategorizeComponents();
    }

    private void OnCacheStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private bool IsMatchQuery(string? text)
    {
        if (string.IsNullOrWhiteSpace(_searchQuery) || string.IsNullOrWhiteSpace(text)) return false;
        return text.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase);
    }

    private List<N4Component> GetEffectiveComponents()
    {
        var result = new List<N4Component>(_allComponents);

        foreach (var s in _allServers)
        {
            if (!_allComponents.Any(c => c.ServerId == s.Id))
            {
                var hostUpper = (s.HostName ?? string.Empty).ToUpperInvariant();
                ComponentRole inferredRole = ComponentRole.ClusterNode;

                if (hostUpper.Contains("CENTER") || hostUpper.Contains("MASTER") || hostUpper.Contains("STANDBY"))
                    inferredRole = ComponentRole.CenterNode;
                else if (hostUpper.Contains("XPS") || hostUpper.Contains("ECN") || hostUpper.Contains("BRIDGE"))
                    inferredRole = ComponentRole.Xps;
                else if (hostUpper.Contains("DB") || hostUpper.Contains("SQL") || hostUpper.Contains("ORACLE"))
                    inferredRole = ComponentRole.BaseDeDonnees;

                result.Add(new N4Component
                {
                    Id = s.Id,
                    EnvironmentId = s.EnvironmentId,
                    ServerId = s.Id,
                    Server = s,
                    LogicalName = s.HostName ?? string.Empty,
                    Role = inferredRole,
                    WindowsServiceName = string.Empty,
                    Status = s.Status,
                    ControlMode = ControlMode.SuperviseSeulement
                });
            }
        }

        return result;
    }

    private void CategorizeComponents()
    {
        _clusterNodes.Clear();
        _databaseNodes.Clear();
        _masterNodes.Clear();
        _xpsNodes.Clear();
        _externalNodes.Clear();

        var effective = GetEffectiveComponents();

        foreach (var c in effective)
        {
            var service = c.WindowsServiceName ?? string.Empty;
            var name = c.LogicalName ?? string.Empty;
            var host = c.Server?.HostName ?? string.Empty;

            if (c.Role == ComponentRole.CenterNode ||
                c.Role == ComponentRole.StandbyCenterNode ||
                c.Role == ComponentRole.DossierPartage ||
                service.Contains("Center", StringComparison.OrdinalIgnoreCase) ||
                service.Contains("Standby", StringComparison.OrdinalIgnoreCase) ||
                name.Contains("Center", StringComparison.OrdinalIgnoreCase) ||
                name.Contains("Standby", StringComparison.OrdinalIgnoreCase) ||
                host.Contains("CENTER", StringComparison.OrdinalIgnoreCase) ||
                host.Contains("STANDBY", StringComparison.OrdinalIgnoreCase))
            {
                _masterNodes.Add(c);
            }
            else if (c.Role == ComponentRole.Xps ||
                     c.Role == ComponentRole.Ecn4 ||
                     c.Role == ComponentRole.Ecn4Web ||
                     c.Role == ComponentRole.BridgeDaemon ||
                     service.Contains("XPS", StringComparison.OrdinalIgnoreCase) ||
                     service.Contains("ECN", StringComparison.OrdinalIgnoreCase) ||
                     name.Contains("XPS", StringComparison.OrdinalIgnoreCase) ||
                     name.Contains("ECN", StringComparison.OrdinalIgnoreCase))
            {
                _xpsNodes.Add(c);
            }
            else if (c.Role == ComponentRole.BaseDeDonnees ||
                     service.Contains("SQL", StringComparison.OrdinalIgnoreCase) ||
                     service.Contains("Oracle", StringComparison.OrdinalIgnoreCase) ||
                     name.Contains("Database", StringComparison.OrdinalIgnoreCase) ||
                     name.Contains("DB", StringComparison.OrdinalIgnoreCase))
            {
                _databaseNodes.Add(c);
            }
            else if (c.Role == ComponentRole.SystemeExterne ||
                     c.Role == ComponentRole.InterfaceEdi ||
                     name.Contains("VBS", StringComparison.OrdinalIgnoreCase) ||
                     name.Contains("Hyperion", StringComparison.OrdinalIgnoreCase) ||
                     name.Contains("Reefer", StringComparison.OrdinalIgnoreCase) ||
                     name.Contains("DGPS", StringComparison.OrdinalIgnoreCase))
            {
                _externalNodes.Add(c);
            }
            else
            {
                _clusterNodes.Add(c);
            }
        }
    }

    private List<N4Component> GetClusterNodes() => _clusterNodes;
    private List<N4Component> GetDatabaseNodes() => _databaseNodes;
    private List<N4Component> GetMasterNodes() => _masterNodes;
    private List<N4Component> GetXpsNodes() => _xpsNodes;
    private List<N4Component> GetExternalNodes() => _externalNodes;

    private RenderFragment RenderInteractiveNode(N4Component comp, bool isLarge = false) => __builder =>
    {
        var snapshot = SupervisionCache.GetSnapshot(comp.Id);
        var state = snapshot?.State ?? ComponentState.Inconnu;
        var serverStatus = comp.Server?.Status ?? LifecycleStatus.Actif;
        var isMatch = IsMatchQuery(comp.LogicalName) || IsMatchQuery(comp.WindowsServiceName) || IsMatchQuery(comp.Server?.IpAddress ?? "");

        string bgGradient;
        string borderStyle;
        string textStyle;
        string dotStyle;
        string stateLabel;

        if (serverStatus == LifecycleStatus.Desactive || state == ComponentState.NonSupervise)
        {
            bgGradient = "bg-gradient-to-b from-slate-750 to-slate-900";
            borderStyle = "border-slate-600/70 shadow-slate-950/70";
            textStyle = "text-slate-100 font-extrabold";
            dotStyle = "bg-slate-400";
            stateLabel = "Non supervisé";
        }
        else if (state == ComponentState.Disponible)
        {
            bgGradient = "bg-gradient-to-b from-emerald-600 to-emerald-850";
            borderStyle = "border-emerald-400/80 shadow-emerald-500/40 glow-theme";
            textStyle = "text-white font-extrabold";
            dotStyle = "bg-emerald-300 animate-pulse";
            stateLabel = "Running (Vert)";
        }
        else if (state == ComponentState.Arret || state == ComponentState.Indisponible)
        {
            bgGradient = "bg-gradient-to-b from-rose-600 to-rose-850";
            borderStyle = "border-rose-400/80 shadow-rose-500/40";
            textStyle = "text-white font-extrabold";
            dotStyle = "bg-rose-300 animate-ping";
            stateLabel = "À l'arrêt (Rouge)";
        }
        else if (state == ComponentState.Demarrage)
        {
            bgGradient = "bg-gradient-to-b from-amber-600 to-amber-850";
            borderStyle = "border-amber-400/80 shadow-amber-500/40";
            textStyle = "text-white font-extrabold";
            dotStyle = "bg-amber-300 animate-pulse";
            stateLabel = "Démarrage (Ambre)";
        }
        else if (state == ComponentState.Inconnu)
        {
            // Gris : soit jamais evalue, soit serveur injoignable au dernier
            // controle (import, ou balayage de fond). Label distinct de
            // « Non supervise », qui lui signale une exclusion deliberee.
            bgGradient = "bg-gradient-to-b from-slate-750 to-slate-900";
            borderStyle = "border-slate-600/70 shadow-slate-950/70";
            textStyle = "text-slate-100 font-extrabold";
            dotStyle = "bg-slate-400";
            stateLabel = "Injoignable";
        }
        else
        {
            bgGradient = "bg-gradient-to-b from-slate-750 to-slate-900";
            borderStyle = "border-slate-600/70 shadow-slate-950/70";
            textStyle = "text-slate-100 font-extrabold";
            dotStyle = "bg-slate-400";
            stateLabel = "Non supervisé";
        }

        @* FR-050 : nœud dont dépend le composant actuellement mis en évidence. *@
        var estDependance = EstDependanceMiseEnEvidence(comp.Id);

        <div @onclick="() => OpenComponentNodeModalAsync(comp)"
             class="flex flex-col items-center p-3.5 sm:p-4 rounded-3xl border-2 transition-all duration-300 shadow-xl relative group cursor-pointer hover:scale-105 hover:-translate-y-1 @bgGradient @borderStyle w-full min-w-0 @(isMatch ? "ring-4 ring-sky-400 shadow-sky-500/80 animate-pulse" : "") @(estDependance ? "ring-4 ring-amber-400 shadow-amber-500/60" : "")">
            <!-- Cylinder Top Oval Cap -->
            <div class="w-full h-3 rounded-t-full bg-white/20 border-b border-white/30 mb-1.5 flex items-center justify-center">
                <div class="w-1/2 h-1 bg-white/50 rounded-full"></div>
            </div>
            
            <!-- Cylinder Content Body -->
            <div class="text-center space-y-1.5 py-1 px-2 w-full min-w-0">
                <div class="flex items-center justify-center gap-1.5 w-full min-w-0">
                    <span class="w-2.5 h-2.5 rounded-full @dotStyle shrink-0 shadow-md"></span>
                    <span class="text-xs sm:text-sm font-black @textStyle leading-tight text-center line-clamp-2 break-words" title="@comp.LogicalName">
                        @comp.LogicalName
                    </span>
                </div>

                <!-- State Badge -->
                <div class="inline-block px-2.5 py-0.5 rounded-full bg-black/40 border border-white/10 text-[10px] font-bold text-white/90 uppercase tracking-wider">
                    @stateLabel
                </div>

                <!-- Service Windows Tag -->
                @if (!string.IsNullOrWhiteSpace(comp.WindowsServiceName) && !comp.WindowsServiceName.Contains('.'))
                {
                    <div class="text-[10px] font-mono text-cyan-200/90 bg-cyan-950/60 px-2 py-0.5 rounded-lg border border-cyan-700/40 inline-flex items-center gap-1 max-w-full truncate" title="@comp.WindowsServiceName">
                        <i class="bi bi-gear-fill text-cyan-400"></i> @comp.WindowsServiceName
                    </div>
                }

                @* FR-050 : dépendances déclarées, visibles depuis la carte. *@
                @{
                    var liens = DependancesDe(comp.Id);
                }
                @if (liens.Count > 0)
                {
                    var noms = string.Join(", ", liens.Select(d => NomComposant(d.DependsOnComponentId)));
                    var actif = _dependancesMisesEnEvidence == comp.Id;

                    <button type="button"
                            @onclick:stopPropagation="true"
                            @onclick="() => _dependancesMisesEnEvidence = actif ? null : comp.Id"
                            title="Dépend de : @noms"
                            aria-label="Mettre en évidence les @liens.Count dépendance(s) de @comp.LogicalName"
                            class="text-[10px] font-bold px-2 py-0.5 rounded-lg border inline-flex items-center gap-1 max-w-full truncate transition-colors @(actif ? "bg-amber-500/25 border-amber-400/60 text-amber-200" : "bg-slate-950/50 border-slate-600/40 text-slate-300 hover:border-amber-400/50")">
                        <i class="bi bi-diagram-3"></i> dépend de @liens.Count
                    </button>
                }
            </div>

            <!-- Cylinder Bottom Oval Cap -->
            <div class="w-full h-2.5 rounded-b-full bg-black/30 mt-1.5 border-t border-black/20"></div>
        </div>
    };

    /// <summary>
    /// Ouvre le modal et relève la vitalité réelle du serveur (FR-051). Le
    /// modal s'ouvre immédiatement en état de chargement : l'interrogation
    /// WinRM prend jusqu'à quelques secondes, elle ne doit pas bloquer le clic.
    /// </summary>
    private async Task OpenComponentNodeModalAsync(N4Component comp)
    {
        _activeTelemetry = new NodeModalDto
        {
            Name = comp.LogicalName,
            Role = comp.Role.ToString(),
            HostName = comp.Server?.HostName ?? "—",
            IpAddress = comp.Server?.IpAddress ?? "—",
            ServiceName = comp.WindowsServiceName ?? "—",
            IsStatic = false
        };
        _showTelemetryModal = true;
        _loadingTelemetry = true;
        StateHasChanged();

        _activeTelemetry.Vitals = comp.ServerId is { } serverId
            ? await Vitals.ReadAsync(serverId)
            : NodeVitals.Injoignable(comp.Id, comp.Server?.HostName ?? comp.LogicalName,
                "Ce composant n'est rattaché à aucun serveur du référentiel.");

        _loadingTelemetry = false;
        StateHasChanged();
    }

    /// <summary>
    /// Systèmes périphériques (GOS, DGPS, VBS...) hors référentiel N4 :
    /// aucun serveur à interroger, donc aucune télémétrie prétendue.
    /// </summary>
    private void OpenStaticNodeModal(string name, string role, string hostName, string ipAddress, string serviceName)
    {
        _activeTelemetry = new NodeModalDto
        {
            Name = name,
            Role = role,
            HostName = hostName,
            IpAddress = ipAddress,
            ServiceName = serviceName,
            IsStatic = true
        };
        _showTelemetryModal = true;
        _loadingTelemetry = false;
    }

    private void CloseTelemetryModal()
    {
        _showTelemetryModal = false;
        _activeTelemetry = null;
    }

    // -----------------------------------------------------------------------
    // Présentation (mêmes règles que la page Vitalité des nœuds)
    // -----------------------------------------------------------------------
    private static string Pourcent(double? v) => v is null ? "—" : $"{v.Value:0.0} %";

    private static string Largeur(double? v) =>
        v is null ? "0%" : $"{Math.Clamp(v.Value, 0, 100).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)}%";

    private static string Octets(long? v)
    {
        if (v is null) return "—";
        double o = v.Value;
        string[] unites = ["o", "Ko", "Mo", "Go", "To"];
        var i = 0;
        while (o >= 1024 && i < unites.Length - 1) { o /= 1024; i++; }
        return $"{o:0.0} {unites[i]}";
    }

    private static string Barre(double? v, double attention, double critique) => v switch
    {
        null => "bg-slate-700",
        var x when x >= critique => "bg-rose-400",
        var x when x >= attention => "bg-amber-400",
        _ => "bg-sky-400"
    };

    private static string PastilleHorloge(ClockState s) => s switch
    {
        ClockState.Conforme => "bg-emerald-500/10 text-emerald-300 border-emerald-500/30",
        ClockState.NonConforme => "bg-rose-500/10 text-rose-300 border-rose-500/30",
        ClockState.AConfirmer => "bg-amber-500/10 text-amber-300 border-amber-500/30",
        _ => "bg-slate-800 text-slate-400 border-slate-700"
    };

    public void Dispose()
    {
        SupervisionCache.OnStateChanged -= OnCacheStateChanged;
        EnvState.Changed -= OnEnvStateChanged;
    }
}
