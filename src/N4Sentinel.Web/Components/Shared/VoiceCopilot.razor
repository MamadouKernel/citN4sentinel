@using Microsoft.JSInterop
@using N4Sentinel.Infrastructure.Ai
@inject VoiceCopilotService VoiceService
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="fixed bottom-6 right-6 z-50">
    <div class="glass-card p-3 rounded-2xl border border-purple-500/40 shadow-2xl bg-slate-950/90 backdrop-blur-md flex items-center gap-3">
        <button @onclick="ToggleListen" class="p-3.5 rounded-xl transition flex items-center justify-center shadow-lg @(_isListening ? "bg-rose-600 text-white animate-pulse" : "bg-purple-600 hover:bg-purple-500 text-white")">
            <i class="bi @(_isListening ? "bi-mic-fill text-lg" : "bi-mic text-lg")"></i>
        </button>

        <div class="pr-2 hidden sm:block">
            <div class="text-xs font-bold text-white flex items-center gap-1.5">
                <span>Sentinel Copilot Vocale</span>
                <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            </div>
            <div class="text-[11px] text-slate-400 max-w-[200px] truncate">
                @(_transcript ?? "Dites 'Vérifier la santé' ou 'EDI'")
            </div>
        </div>
    </div>
</div>

@code {
    private bool _isListening;
    private string? _transcript;

    private async Task ToggleListen()
    {
        _isListening = !_isListening;

        if (_isListening)
        {
            _transcript = "Écoute en cours…";
            // Simulation après 2 sec
            await Task.Delay(2000);
            _transcript = "Vérifier la santé du cluster N4";
            _isListening = false;

            var res = VoiceService.ProcessVoiceCommand(_transcript);
            _transcript = res.SpeechSynthesisText;

            if (res.TargetRoute != Nav.Uri)
            {
                Nav.NavigateTo(res.TargetRoute);
            }
        }
    }
}
