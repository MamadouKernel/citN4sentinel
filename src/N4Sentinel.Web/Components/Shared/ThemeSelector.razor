@using Microsoft.JSInterop
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="relative inline-block text-left">
    <!-- Icon-Only Theme Selector Button -->
    <button type="button" @onclick="ToggleDropdown"
            aria-haspopup="true" aria-expanded="@(_isOpen ? "true" : "false")"
            class="w-9 h-9 rounded-full bg-slate-900/60 border border-slate-800/60 hover:border-theme-primary text-slate-300 hover:text-white flex items-center justify-center transition-all duration-200 shadow-sm"
            title="Changer la palette de couleurs">
        <i class="bi bi-palette-fill text-theme-primary text-sm"></i>
    </button>

    @if (_isOpen)
    {
        <!-- Backdrop to close dropdown -->
        <div class="fixed inset-0 z-40" @onclick="CloseDropdown"></div>

        <!-- Dropdown Card -->
        <div class="absolute right-0 mt-2 w-64 rounded-2xl app-bg-sidebar border border-slate-700/80 shadow-2xl p-2 z-50 space-y-1 backdrop-blur-xl animate-fadeIn">
            <div class="px-3 py-2 text-[10px] font-bold text-slate-400 uppercase tracking-widest border-b border-slate-800 mb-1 flex items-center justify-between">
                <span>Palette de Couleurs</span>
                <i class="bi bi-sliders text-theme-primary"></i>
            </div>

            @foreach (var t in _themes)
            {
                <button type="button" @onclick="() => SelectTheme(t.Id)"
                        class="w-full flex items-center justify-between px-3 py-2.5 rounded-xl text-xs font-medium transition text-slate-300 hover:text-white hover:bg-white/10 @(_activeTheme == t.Id ? "bg-white/10 text-white font-bold border border-theme-primary" : "")">
                    <div class="flex items-center gap-3">
                        <span class="w-4 h-4 rounded-full @t.SwatchClass border border-white/20 shadow-md flex-shrink-0"></span>
                        <span>@t.Name</span>
                    </div>
                    @if (_activeTheme == t.Id)
                    {
                        <i class="bi bi-check-circle-fill text-theme-primary font-bold text-sm"></i>
                    }
                </button>
            }
        </div>
    }
</div>

@code {
    private bool _isOpen;
    private string _activeTheme = "ocean";

    private record ThemeOption(string Id, string Name, string SwatchClass);

    private readonly List<ThemeOption> _themes = new()
    {
        new("ocean", "Bleu Océan N4", "bg-sky-500"),
        new("emerald", "Émeraude Supervision", "bg-emerald-500"),
        new("amber", "Ambre Industriel", "bg-amber-500"),
        new("purple", "Violet Cyber Ops", "bg-purple-500"),
        new("crimson", "Rouge Alerte", "bg-rose-500"),
        new("light", "Blanc Épuré (Light)", "bg-white border border-slate-300")
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var theme = await JS.InvokeAsync<string>("getSentinelTheme");
                if (!string.IsNullOrEmpty(theme))
                {
                    _activeTheme = theme;
                    StateHasChanged();
                }
            }
            catch { }
        }
    }

    private void ToggleDropdown() => _isOpen = !_isOpen;
    private void CloseDropdown() => _isOpen = false;

    private async Task SelectTheme(string themeId)
    {
        _activeTheme = themeId;
        _isOpen = false;
        try
        {
            await JS.InvokeVoidAsync("setSentinelTheme", themeId);
        }
        catch { }
    }
}
