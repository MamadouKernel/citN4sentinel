@* Champ mot de passe avec bouton « afficher/masquer » : une saisie fausse
   sur un mot de passe masqué ne se remarque qu'à l'échec de connexion,
   parfois après plusieurs tentatives et un verrouillage de compte.

   Bascule en JavaScript pur, sans @@onclick Blazor : les pages de compte
   (Compte/Connexion, Inscription, ...) sont rendues en SSR statique, sans
   circuit interactif — un gestionnaire C# n'y serait jamais déclenché. *@
@using System.Linq.Expressions

<div class="relative">
    <InputText type="password"
               Value="@Value"
               ValueChanged="@ValueChanged"
               ValueExpression="@ValueExpression"
               id="@Id"
               class="@CssClass"
               autocomplete="@AutoComplete"
               placeholder="@Placeholder"
               @attributes="AdditionalAttributes" />
    <button type="button"
            class="absolute inset-y-0 right-0 pr-3.5 flex items-center @ButtonClass transition"
            tabindex="-1"
            aria-label="Afficher le mot de passe"
            onclick="const i=this.previousElementSibling; const show=i.type==='password'; i.type=show?'text':'password'; this.querySelector('i').className='bi '+(show?'bi-eye-slash':'bi-eye'); this.setAttribute('aria-label', show?'Masquer le mot de passe':'Afficher le mot de passe');">
        <i class="bi bi-eye"></i>
    </button>
</div>

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public Expression<Func<string>>? ValueExpression { get; set; }
    [Parameter] public string? Id { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter] public string? AutoComplete { get; set; }
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Classes du bouton, à adapter au thème (sombre par défaut, plus foncé au survol pour les pages claires non retouchées).</summary>
    [Parameter] public string ButtonClass { get; set; } = "text-slate-500 hover:text-slate-200";

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
