@* Champ mot de passe avec bouton « afficher/masquer » : une saisie fausse
   sur un mot de passe masqué ne se remarque qu'à l'échec de connexion,
   parfois après plusieurs tentatives et un verrouillage de compte.

   Bascule en JavaScript pur, sans @@onclick Blazor : les pages de compte
   (Compte/Connexion, Inscription, ...) sont rendues en SSR statique, sans
   circuit interactif — un gestionnaire C# n'y serait jamais déclenché.

   Le geste vit dans wwwroot/js/password-toggle.js et NON dans un attribut
   onclick en ligne : la politique de sécurité de contenu déclare
   script-src 'self' sans 'unsafe-inline', qui bloque tout script en ligne.
   Le bouton restait donc sans effet. Les deux attributs data- ci-dessous
   sont ce que l'écouteur délégué recherche. *@
@using System.Linq.Expressions

<div class="relative" data-champ-mot-de-passe>
    <InputText type="password"
               Value="@Value"
               ValueChanged="@ValueChanged"
               ValueExpression="@ValueExpression"
               id="@Id"
               class="@CssClass"
               autocomplete="@AutoComplete"
               placeholder="@Placeholder"
               @attributes="AdditionalAttributes" />
    <button type="button"
            class="absolute inset-y-0 right-0 pr-3.5 flex items-center @ButtonClass transition"
            tabindex="-1"
            aria-label="Afficher le mot de passe"
            data-bascule-mot-de-passe>
        <i class="bi bi-eye"></i>
    </button>
</div>

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public Expression<Func<string>>? ValueExpression { get; set; }
    [Parameter] public string? Id { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter] public string? AutoComplete { get; set; }
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Classes du bouton, à adapter au thème (sombre par défaut, plus foncé au survol pour les pages claires non retouchées).</summary>
    [Parameter] public string ButtonClass { get; set; } = "text-slate-500 hover:text-slate-200";

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
