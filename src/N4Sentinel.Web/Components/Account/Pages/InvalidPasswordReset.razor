@page "/Account/InvalidPasswordReset"

<PageTitle>Lien invalide — N4 Sentinel</PageTitle>

<div class="text-center space-y-4 py-2">
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-rose-500/10 text-rose-400 text-2xl border border-rose-500/20 shadow-lg shadow-rose-500/10">
        <i class="bi bi-exclamation-triangle-fill"></i>
    </div>

    <div>
        <h2 class="text-xl font-bold text-white tracking-tight">Lien invalide ou expiré</h2>
        <p class="text-xs text-slate-400 mt-1 leading-relaxed">
            Le lien de réinitialisation du mot de passe que vous avez utilisé est invalide ou a expiré pour des raisons de sécurité.
        </p>
    </div>

    <div class="pt-2 space-y-2">
        <a href="Account/ForgotPassword" class="w-full inline-flex justify-center items-center gap-2 px-4 py-2.5 rounded-xl bg-sky-600 hover:bg-sky-500 text-white font-bold text-xs shadow-lg shadow-sky-600/20 transition">
            Demander un nouveau lien
        </a>
        <a href="Account/Login" class="w-full inline-flex justify-center items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs transition">
            &larr; Retour à la connexion
        </a>
    </div>
</div>
