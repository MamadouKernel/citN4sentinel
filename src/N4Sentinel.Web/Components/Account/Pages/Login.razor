@page "/Account/Login"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using N4Sentinel.Domain
@using N4Sentinel.Infrastructure.Identity
@using N4Sentinel.Infrastructure.Persistence

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IAuditWriter AuditWriter
@inject ILogger<Login> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Connexion — N4 Sentinel</PageTitle>

<div class="space-y-6">
    <div>
        <h2 class="text-xl font-bold text-white tracking-tight">Connexion</h2>
        <p class="text-xs text-slate-400 mt-1">Accédez au portail de supervision N4 Sentinel</p>
    </div>

    <StatusMessage Message="@errorMessage" />

    <EditForm EditContext="editContext" method="post" OnSubmit="LoginUser" FormName="login" class="space-y-4">
        <DataAnnotationsValidator />
        
        <div>
            <label for="Input.Email" class="block text-xs font-semibold text-slate-300 mb-1.5">
                Adresse courriel
            </label>
            <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500">
                    <i class="bi bi-envelope"></i>
                </div>
                <InputText @bind-Value="Input.Email" id="Input.Email" class="w-full bg-slate-900/80 border border-slate-700/80 rounded-xl pl-10 pr-4 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-slate-500 transition" autocomplete="username webauthn" placeholder="nom@exemple.com" />
            </div>
            <ValidationMessage For="() => Input.Email" class="text-xs text-rose-400 mt-1" />
        </div>

        <div>
            <label for="Input.Password" class="block text-xs font-semibold text-slate-300 mb-1.5">
                Mot de passe
            </label>
            <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500">
                    <i class="bi bi-lock"></i>
                </div>
                <PasswordInput @bind-Value="Input.Password" Id="Input.Password" CssClass="w-full bg-slate-900/80 border border-slate-700/80 rounded-xl pl-10 pr-10 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-slate-500 transition" AutoComplete="current-password" Placeholder="••••••••" />
            </div>
            <ValidationMessage For="() => Input.Password" class="text-xs text-rose-400 mt-1" />
        </div>

        <div class="flex items-center justify-between pt-1">
            <label class="flex items-center gap-2 cursor-pointer text-xs text-slate-300">
                <InputCheckbox @bind-Value="Input.RememberMe" class="w-4 h-4 rounded border-slate-700 bg-slate-900 text-theme-primary focus:ring-slate-500" />
                <span>Se souvenir de moi</span>
            </label>

            <a href="Account/ForgotPassword" class="text-xs text-theme-primary hover:underline transition">
                Mot de passe oublié ?
            </a>
        </div>

        <button type="submit" class="w-full bg-theme-gradient hover:opacity-90 text-white font-bold py-3 rounded-xl shadow-lg glow-theme transition transform active:scale-[0.99] text-sm">
            Se connecter
        </button>

        <div class="pt-3 border-t border-slate-800 space-y-2">
            <!-- SSO Azure AD Button (SEC-001 V2 / Lot 4) -->
            <a href="/Account/Login" class="w-full py-2.5 px-4 bg-indigo-950/60 hover:bg-indigo-900/80 border border-indigo-500/40 rounded-xl text-xs font-bold text-indigo-200 hover:text-white transition flex items-center justify-center gap-2 shadow-md">
                <i class="bi bi-microsoft text-sky-400"></i>
                Se connecter avec Azure AD (SSO CIT)
            </a>

            <PasskeySubmit Operation="PasskeyOperation.Request" Name="Input.Passkey" EmailName="Input.Email" class="w-full py-2.5 px-4 bg-slate-900 hover:bg-slate-800 border border-slate-700/80 rounded-xl text-xs font-semibold text-slate-300 hover:text-white transition flex items-center justify-center gap-2">
                <i class="bi bi-key-fill text-theme-primary"></i>
                Connexion par clé de sécurité (Passkey)
            </PasskeySubmit>
        </div>
    </EditForm>
</div>

@code {
    private string? errorMessage;
    private EditContext editContext = default!;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        editContext = new EditContext(Input);

        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
        }
    }

    public async Task LoginUser()
    {
        if (!string.IsNullOrEmpty(Input.Passkey?.Error))
        {
            errorMessage = $"Erreur Passkey : {Input.Passkey.Error}";
            return;
        }

        SignInResult result;
        if (!string.IsNullOrEmpty(Input.Passkey?.CredentialJson))
        {
            result = await SignInManager.PasskeySignInAsync(Input.Passkey.CredentialJson);
        }
        else
        {
            if (!editContext.Validate())
            {
                return;
            }

            result = await SignInManager.PasswordSignInAsync(Input.Email, Input.Password, Input.RememberMe, lockoutOnFailure: true);
        }

        var ip = HttpContext.Connection.RemoteIpAddress?.ToString();
        var correlationId = HttpContext.TraceIdentifier;

        if (result.Succeeded)
        {
            Logger.LogInformation("Utilisateur connecté.");
            await AuditWriter.WriteAsync(AuditAction.Connexion, AuditOutcome.Succes, Input.Email,
                ip, correlationId: correlationId);

            if (await RequiertSecondFacteurObligatoireAsync(Input.Email))
            {
                // SEC-001 : le texte du CdC demande un MFA obligatoire pour les
                // comptes sensibles. Tant qu'aucun second facteur n'est activé,
                // la connexion aboutit (pas de blocage sans issue) mais redirige
                // systematiquement vers son activation plutot que vers la
                // destination demandee - voir ApplicationUser.cs pour l'ecart
                // assume avec le texte exact (TOTP au lieu de MFA e-mail).
                RedirectManager.RedirectTo("Account/Manage/EnableAuthenticator");
            }
            else
            {
                RedirectManager.RedirectTo(ReturnUrl);
            }
        }
        else if (result.RequiresTwoFactor)
        {
            // La connexion n'est pas encore etablie : le second facteur peut
            // encore echouer. L'entree d'audit se pose a l'issue reelle, dans
            // LoginWith2fa.razor.
            RedirectManager.RedirectTo(
                "Account/LoginWith2fa",
                new() { ["returnUrl"] = ReturnUrl, ["rememberMe"] = Input.RememberMe });
        }
        else if (result.IsLockedOut)
        {
            Logger.LogWarning("Compte utilisateur verrouillé.");
            await AuditWriter.WriteAsync(AuditAction.DeconnexionOuEchecAuthentification, AuditOutcome.Refuse,
                Input.Email, ip, detail: "Compte verrouille apres echecs successifs.", correlationId: correlationId);
            RedirectManager.RedirectTo("Account/Lockout");
        }
        else
        {
            await AuditWriter.WriteAsync(AuditAction.DeconnexionOuEchecAuthentification, AuditOutcome.Echec,
                Input.Email, ip, detail: "Identifiants incorrects.", correlationId: correlationId);
            errorMessage = "Erreur : Identifiants incorrects.";
        }
    }

    /// <summary>
    /// SEC-001 : second facteur obligatoire pour les rôles pouvant exécuter ou
    /// approuver une opération (PeutExecuter/PeutApprouver) et pour
    /// l'administration (PeutAdministrerReferentiel/PeutAdministrerConnecteurs) —
    /// pas pour les rôles de consultation seule, moins sensibles.
    /// </summary>
    private static readonly string[] RolesExigeantSecondFacteur =
    [
        N4Roles.OperateurN4,
        N4Roles.AdministrateurN4,
        N4Roles.Validateur,
        N4Roles.AdministrateurSolution,
        N4Roles.AdministrateurInfrastructure
    ];

    private async Task<bool> RequiertSecondFacteurObligatoireAsync(string email)
    {
        var user = await UserManager.FindByEmailAsync(email);
        if (user is null || user.TwoFactorEnabled) return false;

        var roles = await UserManager.GetRolesAsync(user);
        return roles.Any(RolesExigeantSecondFacteur.Contains);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "L'adresse courriel est obligatoire.")]
        [EmailAddress(ErrorMessage = "Saisissez une adresse courriel valide.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Le mot de passe est obligatoire.")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [Display(Name = "Se souvenir de moi")]
        public bool RememberMe { get; set; }

        public PasskeyInputModel? Passkey { get; set; }
    }
}
