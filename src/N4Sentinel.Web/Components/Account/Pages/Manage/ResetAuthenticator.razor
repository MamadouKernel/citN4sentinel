@page "/Account/Manage/ResetAuthenticator"

@using Microsoft.AspNetCore.Identity
@using N4Sentinel.Infrastructure.Identity

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ResetAuthenticator> Logger

<PageTitle>Réinitialiser les clés d'authentificateur — N4 Sentinel</PageTitle>

<div class="space-y-6 max-w-xl">
    <div class="border-b border-slate-800 pb-4">
        <h2 class="text-lg font-bold text-white flex items-center gap-2">
            <i class="bi bi-arrow-repeat text-amber-400"></i>
            Réinitialiser les clés d'authentificateur (TOTP)
        </h2>
        <p class="text-xs text-slate-400 mt-1">
            Re-générez une nouvelle clé secrète pour votre application TOTP (Microsoft Authenticator / Google Authenticator).
        </p>
    </div>

    <StatusMessage />

    <div class="p-4 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-200 text-xs space-y-2">
        <div class="font-bold flex items-center gap-2 text-amber-400">
            <i class="bi bi-exclamation-triangle-fill text-base"></i>
            Attention : Votre application actuelle cessera de fonctionner
        </div>
        <p class="leading-relaxed text-amber-200/90">
            Si vous réinitialisez la clé, les codes générés par votre application d'authentification actuelle ne fonctionneront plus.
            Le second facteur sera désactivé jusqu'à ce que vous scanniez le nouveau QR Code et validiez un code de confirmation.
        </p>
    </div>

    <form @formname="reset-authenticator" @onsubmit="OnSubmitAsync" method="post" class="space-y-4">
        <AntiforgeryToken />
        
        <div class="flex items-center gap-3 pt-2">
            <button class="py-2.5 px-4 rounded-xl bg-amber-600 hover:bg-amber-500 text-white font-bold text-xs shadow-lg shadow-amber-600/30 transition flex items-center gap-2" type="submit">
                <i class="bi bi-arrow-counterclockwise"></i>
                <span>Réinitialiser la clé secrète d'authentification</span>
            </button>
            <a href="Account/Manage/TwoFactorAuthentication" class="px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs transition">
                Annuler
            </a>
        </div>
    </form>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private async Task OnSubmitAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        await UserManager.SetTwoFactorEnabledAsync(user, false);
        await UserManager.ResetAuthenticatorKeyAsync(user);
        var userId = await UserManager.GetUserIdAsync(user);
        Logger.LogInformation("L'utilisateur {UserId} a réinitialisé la clé de son application d'authentification.", userId);

        await SignInManager.RefreshSignInAsync(user);

        RedirectManager.RedirectToWithStatus(
            "Account/Manage/EnableAuthenticator",
            "Votre clé d'authentification a été réinitialisée. Scannez le nouveau QR Code ci-dessous pour reconfigurer votre application.",
            HttpContext);
    }
}
