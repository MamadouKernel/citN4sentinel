@page "/Account/Manage/GenerateRecoveryCodes"

@using Microsoft.AspNetCore.Identity
@using N4Sentinel.Infrastructure.Identity

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<GenerateRecoveryCodes> Logger

<PageTitle>Générer des codes de secours (2FA) — N4 Sentinel</PageTitle>

@if (recoveryCodes is not null)
{
    <ShowRecoveryCodes RecoveryCodes="recoveryCodes.ToArray()" StatusMessage="@message" />
}
else
{
    <div class="space-y-6 max-w-xl">
        <div class="border-b border-slate-800 pb-4">
            <h2 class="text-lg font-bold text-white flex items-center gap-2">
                <i class="bi bi-key-fill text-amber-400"></i>
                Nouveaux codes de secours d'urgence
            </h2>
            <p class="text-xs text-slate-400 mt-1">
                Générez un nouveau lot de 10 codes de secours à utiliser en cas de perte de votre dispositif mobile.
            </p>
        </div>

        <div class="p-4 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-200 text-xs space-y-2">
            <div class="font-bold flex items-center gap-2 text-amber-400">
                <i class="bi bi-shield-exclamation text-base"></i>
                Attention : Vos anciens codes de secours seront annulés
            </div>
            <p class="leading-relaxed text-amber-200/90">
                La génération d'un nouveau jeu de codes invalide immédiatement tous les codes de récupération créés précédemment.
            </p>
        </div>

        <form @formname="generate-recovery-codes" @onsubmit="OnSubmitAsync" method="post" class="space-y-4">
            <AntiforgeryToken />
            <div class="flex items-center gap-3 pt-2">
                <button class="py-2.5 px-4 rounded-xl bg-amber-600 hover:bg-amber-500 text-white font-bold text-xs shadow-lg shadow-amber-600/30 transition flex items-center gap-2" type="submit">
                    <i class="bi bi-arrow-clockwise"></i>
                    <span>Générer de nouveaux codes de secours</span>
                </button>
                <a href="Account/Manage/TwoFactorAuthentication" class="px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs transition">
                    Annuler
                </a>
            </div>
        </form>
    </div>
}

@code {
    private string? message;
    private ApplicationUser? user;
    private IEnumerable<string>? recoveryCodes;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        var isTwoFactorEnabled = await UserManager.GetTwoFactorEnabledAsync(user);
        if (!isTwoFactorEnabled)
        {
            throw new InvalidOperationException("Impossible de générer des codes de secours car la 2FA n'est pas active sur votre compte.");
        }
    }

    private async Task OnSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        var userId = await UserManager.GetUserIdAsync(user);
        recoveryCodes = await UserManager.GenerateNewTwoFactorRecoveryCodesAsync(user, 10);
        message = "Nouveaux codes de secours générés avec succès.";

        Logger.LogInformation("L'utilisateur {UserId} a généré un nouveau jeu de codes de secours 2FA.", userId);
    }
}
