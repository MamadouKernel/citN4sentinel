@page "/Account/Manage/TwoFactorAuthentication"

@using Microsoft.AspNetCore.Http.Features
@using Microsoft.AspNetCore.Identity
@using N4Sentinel.Domain
@using N4Sentinel.Infrastructure.Identity

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Authentification à Deux Facteurs (2FA) — N4 Sentinel</PageTitle>

<div class="space-y-6">
    <div>
        <h2 class="text-xl font-extrabold text-white tracking-tight">Authentification à Deux Facteurs (2FA)</h2>
        <p class="text-xs text-slate-400 mt-1">
            Renforcez la sécurité de votre compte administrateur en associant un code à usage unique (TOTP) généré par votre téléphone.
        </p>
    </div>

    <StatusMessage />

    @if (estPrivilegie && !is2faEnabled)
    {
        <div class="rounded-xl p-4 bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs flex items-start gap-3">
            <i class="bi bi-shield-exclamation text-amber-400 text-lg flex-shrink-0 mt-0.5"></i>
            <div>
                <strong class="font-bold text-white block mb-0.5">Recommandé pour votre rôle d'administration.</strong>
                Votre compte dispose de privilèges élevés permettant d'agir sur l'écosystème Navis N4. L'activation de la 2FA protège les opérations portuaires contre toute usurpation.
            </div>
        </div>
    }

    @if (canTrack)
    {
        <!-- Current Status Card -->
        <div class="glass-card p-5 rounded-2xl border border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
                <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Statut du second facteur</div>
                <div class="flex items-center gap-2">
                    @if (is2faEnabled)
                    {
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-extrabold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                            Actif
                        </span>
                        <span class="text-xs text-slate-300">Un code TOTP sera demandé lors de chaque connexion.</span>
                    }
                    else
                    {
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-extrabold bg-slate-800 text-slate-400 border border-slate-700">
                            <i class="bi bi-x-circle"></i> Inactif
                        </span>
                        <span class="text-xs text-slate-400">Seul votre mot de passe est actuellement exigé.</span>
                    }
                </div>
            </div>

            <div>
                @if (!is2faEnabled)
                {
                    <a href="Account/Manage/EnableAuthenticator" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl btn-theme-primary text-white font-bold text-xs transition shadow-lg">
                        <i class="bi bi-qr-code-scan"></i>
                        <span>@(hasAuthenticator ? "Activer le second facteur" : "Configurer une application")</span>
                    </a>
                }
                else
                {
                    <a href="Account/Manage/Disable2fa" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 text-xs font-bold transition">
                        <i class="bi bi-shield-x"></i> Désactiver la 2FA
                    </a>
                }
            </div>
        </div>

        @if (is2faEnabled)
        {
            @if (recoveryCodesLeft == 0)
            {
                <div class="rounded-xl p-4 bg-rose-500/15 border border-rose-500/40 text-rose-300 text-xs space-y-1">
                    <strong class="font-bold text-white block">Aucun code de récupération restant.</strong>
                    <p>En cas de perte de votre téléphone, l'accès au compte sera bloqué. <a href="Account/Manage/GenerateRecoveryCodes" class="underline text-white font-bold">Générez une nouvelle série</a> dès que possible.</p>
                </div>
            }
            else if (recoveryCodesLeft <= 3)
            {
                <div class="rounded-xl p-4 bg-amber-500/15 border border-amber-500/30 text-amber-300 text-xs space-y-1">
                    <strong class="font-bold text-white block">Il vous reste seulement @recoveryCodesLeft code(s) de récupération.</strong>
                    <p><a href="Account/Manage/GenerateRecoveryCodes" class="underline text-white font-bold">Générez une nouvelle série de secours</a>.</p>
                </div>
            }

            <div class="glass-card p-5 rounded-2xl border border-slate-800 space-y-3">
                <h3 class="text-sm font-bold text-white flex items-center gap-2">
                    <i class="bi bi-phone-vibrate text-theme-primary"></i>
                    Application Authentificateur (TOTP)
                </h3>
                <p class="text-xs text-slate-400 leading-relaxed">
                    Compatible avec Microsoft Authenticator, Google Authenticator ou toute application standard TOTP. Les jetons sont calculés hors-ligne.
                </p>
                <div class="flex flex-wrap gap-2 pt-1">
                    <a href="Account/Manage/EnableAuthenticator" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl btn-theme-subtle text-xs font-semibold">
                        <i class="bi bi-arrow-repeat"></i> Reconfigurer l'application
                    </a>
                    <a href="Account/Manage/ResetAuthenticator" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white/5 hover:bg-white/10 text-slate-300 border border-white/10 text-xs font-semibold transition">
                        <i class="bi bi-arrow-counterclockwise"></i> Réinitialiser la clé
                    </a>
                    <a href="Account/Manage/GenerateRecoveryCodes" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white/5 hover:bg-white/10 text-slate-300 border border-white/10 text-xs font-semibold transition">
                        <i class="bi bi-key"></i> Codes de secours (@recoveryCodesLeft restant(s))
                    </a>
                </div>
            </div>

            @if (isMachineRemembered)
            {
                <div class="glass-card p-5 rounded-2xl border border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                        <div class="text-xs font-bold text-white">Navigateur Mémorisé</div>
                        <div class="text-xs text-slate-400">Le second facteur ne sera pas demandé lors de vos prochaines connexions sur ce poste.</div>
                    </div>
                    <form @formname="forget-browser" @onsubmit="OnSubmitForgetBrowserAsync" method="post">
                        <AntiforgeryToken />
                        <button type="submit" class="px-3.5 py-2 rounded-xl bg-white/5 hover:bg-white/10 text-slate-300 border border-white/10 text-xs font-semibold transition">
                            Oublier ce navigateur
                        </button>
                    </form>
                </div>
            }
        }
    }
    else
    {
        <div class="rounded-xl p-4 bg-rose-500/15 border border-rose-500/40 text-rose-300 text-xs">
            <strong class="font-bold text-white">Consentement de suivi requis.</strong>
            Vous devez accepter la politique de confidentialité avant de configurer la 2FA.
        </div>
    }
</div>

@code {
    private bool canTrack;
    private bool hasAuthenticator;
    private int recoveryCodesLeft;
    private bool is2faEnabled;
    private bool isMachineRemembered;
    private bool estPrivilegie;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        canTrack = HttpContext.Features.Get<ITrackingConsentFeature>()?.CanTrack ?? true;
        hasAuthenticator = await UserManager.GetAuthenticatorKeyAsync(user) is not null;
        is2faEnabled = await UserManager.GetTwoFactorEnabledAsync(user);
        isMachineRemembered = await SignInManager.IsTwoFactorClientRememberedAsync(user);
        recoveryCodesLeft = await UserManager.CountRecoveryCodesAsync(user);

        var roles = await UserManager.GetRolesAsync(user);
        estPrivilegie = roles.Any(r => r is N4Roles.OperateurN4
                                         or N4Roles.AdministrateurN4
                                         or N4Roles.AdministrateurInfrastructure
                                         or N4Roles.Validateur
                                         or N4Roles.AdministrateurSolution);
    }

    private async Task OnSubmitForgetBrowserAsync()
    {
        await SignInManager.ForgetTwoFactorClientAsync();

        RedirectManager.RedirectToCurrentPageWithStatus(
            "Ce navigateur a été oublié. Le code 2FA sera demandé lors de la prochaine connexion.",
            HttpContext);
    }
}
