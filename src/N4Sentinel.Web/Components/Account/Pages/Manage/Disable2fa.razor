@page "/Account/Manage/Disable2fa"

@using Microsoft.AspNetCore.Identity
@using N4Sentinel.Infrastructure.Identity

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<Disable2fa> Logger

<PageTitle>Désactiver l'authentification à deux facteurs — N4 Sentinel</PageTitle>

<div class="space-y-6 max-w-xl">
    <div class="border-b border-slate-800 pb-4">
        <h2 class="text-lg font-bold text-white flex items-center gap-2">
            <i class="bi bi-shield-slash-fill text-rose-400"></i>
            Désactiver le second facteur (2FA)
        </h2>
        <p class="text-xs text-slate-400 mt-1">
            Désactiver le second facteur réduit le niveau de protection global de votre compte d'habilitation.
        </p>
    </div>

    <StatusMessage />

    <div class="p-4 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-200 text-xs space-y-2">
        <div class="font-bold flex items-center gap-2 text-amber-400">
            <i class="bi bi-exclamation-triangle-fill text-base"></i>
            Remarque importante sur la clé d'authentification
        </div>
        <p class="leading-relaxed text-amber-200/90">
            Cette action désactive l'exigence de code à la connexion. Elle ne réinitialise pas votre secret TOTP dans votre application.
            Si vous souhaitez modifier la clé enregistrée dans votre application, visitez la page <a href="Account/Manage/ResetAuthenticator" class="text-amber-300 font-bold underline">réinitialiser les clés d'authentificateur</a>.
        </p>
    </div>

    <form @formname="disable-2fa" @onsubmit="OnSubmitAsync" method="post" class="space-y-4">
        <AntiforgeryToken />
        
        <div class="flex items-center gap-3 pt-2">
            <button class="py-2.5 px-4 rounded-xl bg-rose-600 hover:bg-rose-500 text-white font-bold text-xs shadow-lg shadow-rose-600/30 transition flex items-center gap-2" type="submit">
                <i class="bi bi-shield-slash"></i>
                <span>Désactiver le second facteur (2FA)</span>
            </button>
            <a href="Account/Manage/TwoFactorAuthentication" class="px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs transition">
                Annuler
            </a>
        </div>
    </form>
</div>

@code {
    private ApplicationUser? user;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        if (HttpMethods.IsGet(HttpContext.Request.Method) && !await UserManager.GetTwoFactorEnabledAsync(user))
        {
            throw new InvalidOperationException("Impossible de désactiver la 2FA pour un utilisateur qui ne l'a pas encore activée.");
        }
    }

    private async Task OnSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        var disable2faResult = await UserManager.SetTwoFactorEnabledAsync(user, false);
        if (!disable2faResult.Succeeded)
        {
            throw new InvalidOperationException("Une erreur inattendue s'est produite lors de la désactivation du 2FA.");
        }

        var userId = await UserManager.GetUserIdAsync(user);
        Logger.LogInformation("L'utilisateur {UserId} a désactivé son second facteur 2FA.", userId);
        RedirectManager.RedirectToWithStatus(
            "Account/Manage/TwoFactorAuthentication",
            "Le second facteur (2FA) a été désactivé avec succès.",
            HttpContext);
    }
}
