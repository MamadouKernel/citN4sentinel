@page "/Account/LoginWithRecoveryCode"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using N4Sentinel.Infrastructure.Identity

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<LoginWithRecoveryCode> Logger

<PageTitle>Vérification du code de récupération — N4 Sentinel</PageTitle>

<div class="space-y-6">
    <div>
        <h2 class="text-xl font-bold text-white tracking-tight">Code de récupération</h2>
        <p class="text-xs text-slate-400 mt-1">
            Connexion d'urgence via l'un de vos 10 codes de récupération à usage unique.
        </p>
    </div>

    <StatusMessage Message="@message" />

    <EditForm Model="Input" FormName="login-with-recovery-code" OnValidSubmit="OnValidSubmitAsync" method="post" class="space-y-4">
        <DataAnnotationsValidator />
        
        <div>
            <label for="Input.RecoveryCode" class="block text-xs font-semibold text-slate-300 mb-1.5">
                Code de récupération d'urgence
            </label>
            <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500">
                    <i class="bi bi-key-fill"></i>
                </div>
                <InputText @bind-Value="Input.RecoveryCode" id="Input.RecoveryCode" class="w-full bg-slate-900/80 border border-slate-700/80 rounded-xl pl-10 pr-4 py-3 text-center text-sm font-mono text-white placeholder-slate-600 focus:outline-none focus:ring-2 focus:ring-sky-500/50 focus:border-sky-500 transition" autocomplete="off" placeholder="abcdef-12345" />
            </div>
            <ValidationMessage For="() => Input.RecoveryCode" class="text-xs text-rose-400 mt-1" />
        </div>
        
        <button type="submit" class="w-full bg-gradient-to-r from-sky-600 to-sky-500 hover:from-sky-500 hover:to-sky-400 text-white font-bold py-3 rounded-xl shadow-lg shadow-sky-600/30 transition transform active:scale-[0.99] text-sm">
            Se connecter avec ce code
        </button>
    </EditForm>
</div>

@code {
    private string? message;
    private ApplicationUser user = default!;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        // Même situation que LoginWith2fa : cette page dépend d'un cookie posé
        // par la première étape de connexion. Quand il manque, on renvoie à la
        // connexion avec une explication — quelqu'un qui en est réduit à son
        // code de secours a déjà perdu son téléphone, il n'a pas besoin d'une
        // trace d'exception en plus.
        var utilisateur = await SignInManager.GetTwoFactorAuthenticationUserAsync();

        if (utilisateur is null)
        {
            Logger.LogInformation(
                "Code de secours demandé sans étape de connexion préalable : cookie absent ou expiré.");

            RedirectManager.RedirectToWithStatus(
                "Account/Login",
                "Erreur : votre session de connexion a expiré avant la saisie du code de secours. "
                + "Saisissez à nouveau votre identifiant et votre mot de passe.",
                HttpContext);
            return;
        }

        user = utilisateur;
    }

    private async Task OnValidSubmitAsync()
    {
        var recoveryCode = Input.RecoveryCode.Replace(" ", string.Empty);

        var result = await SignInManager.TwoFactorRecoveryCodeSignInAsync(recoveryCode);
        var userId = await UserManager.GetUserIdAsync(user);

        if (result.Succeeded)
        {
            Logger.LogInformation("L'utilisateur {UserId} s'est connecté à l'aide d'un code de récupération.", userId);
            RedirectManager.RedirectTo(ReturnUrl);
        }
        else if (result.IsLockedOut)
        {
            Logger.LogWarning("Compte utilisateur verrouillé.");
            RedirectManager.RedirectTo("Account/Lockout");
        }
        else
        {
            Logger.LogWarning("Code de récupération invalide saisi pour l'utilisateur {UserId}.", userId);
            message = "Erreur : Code de récupération incorrect.";
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Le code de récupération est obligatoire.")]
        [DataType(DataType.Text)]
        [Display(Name = "Code de récupération")]
        public string RecoveryCode { get; set; } = "";
    }
}
