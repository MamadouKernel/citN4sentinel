@page "/Account/AccessDenied"

<PageTitle>Accès refusé — N4 Sentinel</PageTitle>

<div class="max-w-md mx-auto text-center space-y-4">
    <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-rose-500/10 text-rose-400 text-xl border border-rose-500/20">
        <i class="bi bi-shield-lock-fill"></i>
    </div>
    <h1 class="text-xl font-bold text-white tracking-tight">Accès refusé</h1>
    <p class="text-xs text-slate-400 leading-relaxed">
        Votre compte est authentifié, mais n'a pas l'habilitation nécessaire pour cette page.
        Cette tentative a été enregistrée dans le journal d'audit (SEC-008).
    </p>
    <a href="/" class="inline-block px-4 py-2 rounded-xl bg-theme-gradient text-white font-bold text-xs shadow-lg glow-theme transition">
        Retour au tableau de bord
    </a>
</div>
