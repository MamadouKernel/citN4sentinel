@page "/Account/ResetPasswordConfirmation"

<PageTitle>Mot de passe réinitialisé — N4 Sentinel</PageTitle>

<div class="text-center space-y-4 py-2">
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-emerald-500/10 text-emerald-400 text-2xl border border-emerald-500/20 shadow-lg shadow-emerald-500/10">
        <i class="bi bi-check-circle-fill"></i>
    </div>

    <div>
        <h2 class="text-xl font-bold text-white tracking-tight">Mot de passe réinitialisé !</h2>
        <p class="text-xs text-slate-400 mt-1 leading-relaxed">
            Votre mot de passe a été mis à jour avec succès. Vous pouvez désormais vous connecter à la plateforme N4 Sentinel.
        </p>
    </div>

    <div class="pt-2">
        <a href="Account/Login" class="w-full inline-flex justify-center items-center gap-2 px-4 py-3 rounded-xl bg-gradient-to-r from-sky-600 to-sky-500 hover:from-sky-500 hover:to-sky-400 text-white font-bold text-xs shadow-lg shadow-sky-600/30 transition">
            Se connecter
        </a>
    </div>
</div>
