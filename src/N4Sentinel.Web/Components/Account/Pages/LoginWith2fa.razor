@page "/Account/LoginWith2fa"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using N4Sentinel.Domain
@using N4Sentinel.Infrastructure.Identity
@using N4Sentinel.Infrastructure.Persistence

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IAuditWriter AuditWriter
@inject IdentityRedirectManager RedirectManager
@inject ILogger<LoginWith2fa> Logger

<PageTitle>Authentification à deux facteurs — N4 Sentinel</PageTitle>

<div class="space-y-6">
    <div>
        <h2 class="text-xl font-bold text-white tracking-tight">Authentification à deux facteurs</h2>
        <p class="text-xs text-slate-400 mt-1">
            Saisissez le code à 6 chiffres généré par votre application (ex. Microsoft Authenticator).
        </p>
    </div>

    <StatusMessage Message="@message" />

    <EditForm Model="Input" FormName="login-with-2fa" OnValidSubmit="OnValidSubmitAsync" method="post" class="space-y-4">
        <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
        <input type="hidden" name="RememberMe" value="@RememberMe" />
        <DataAnnotationsValidator />
        
        <div>
            <label for="Input.TwoFactorCode" class="block text-xs font-semibold text-slate-300 mb-1.5">
                Code de vérification TOTP
            </label>
            <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500">
                    <i class="bi bi-shield-lock"></i>
                </div>
                <InputText @bind-Value="Input.TwoFactorCode" id="Input.TwoFactorCode" class="w-full bg-slate-900/80 border border-slate-700/80 rounded-xl pl-10 pr-4 py-3 text-center text-lg font-mono tracking-widest text-white placeholder-slate-600 focus:outline-none focus:ring-2 focus:ring-sky-500/50 focus:border-sky-500 transition" autocomplete="off" inputmode="numeric" placeholder="123 456" />
            </div>
            <ValidationMessage For="() => Input.TwoFactorCode" class="text-xs text-rose-400 mt-1" />
        </div>

        <div class="flex items-center gap-2 pt-1">
            <InputCheckbox @bind-Value="Input.RememberMachine" id="remember-machine" class="w-4 h-4 rounded border-slate-700 bg-slate-900 text-sky-500 focus:ring-sky-500/50" />
            <label for="remember-machine" class="text-xs text-slate-300 cursor-pointer">
                Mémoriser ce navigateur
            </label>
        </div>

        <button type="submit" class="w-full bg-gradient-to-r from-sky-600 to-sky-500 hover:from-sky-500 hover:to-sky-400 text-white font-bold py-3 rounded-xl shadow-lg shadow-sky-600/30 transition transform active:scale-[0.99] text-sm">
            Valider et se connecter
        </button>
    </EditForm>

    <div class="pt-4 border-t border-slate-800 text-center">
        <a href="Account/LoginWithRecoveryCode?ReturnUrl=@ReturnUrl" class="text-xs text-slate-400 hover:text-sky-400 transition">
            Utiliser un code de récupération d'urgence &rarr;
        </a>
    </div>
</div>

@code {
    private string? message;
    private ApplicationUser user = default!;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    private bool RememberMe { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        user = await SignInManager.GetTwoFactorAuthenticationUserAsync() ??
            throw new InvalidOperationException("Impossible de charger l'utilisateur pour l'authentification à deux facteurs.");
    }

    private async Task OnValidSubmitAsync()
    {
        var authenticatorCode = Input.TwoFactorCode!.Replace(" ", string.Empty).Replace("-", string.Empty);
        var result = await SignInManager.TwoFactorAuthenticatorSignInAsync(authenticatorCode, RememberMe, Input.RememberMachine);
        var userId = await UserManager.GetUserIdAsync(user);
        var email = await UserManager.GetEmailAsync(user) ?? userId;
        var ip = HttpContext.Connection.RemoteIpAddress?.ToString();
        var correlationId = HttpContext.TraceIdentifier;

        if (result.Succeeded)
        {
            Logger.LogInformation("L'utilisateur {UserId} s'est connecté avec le second facteur.", userId);
            await AuditWriter.WriteAsync(AuditAction.Connexion, AuditOutcome.Succes, email,
                ip, detail: "Second facteur TOTP verifie.", correlationId: correlationId);
            RedirectManager.RedirectTo(ReturnUrl);
        }
        else if (result.IsLockedOut)
        {
            Logger.LogWarning("Le compte de l'utilisateur {UserId} a été verrouillé.", userId);
            await AuditWriter.WriteAsync(AuditAction.DeconnexionOuEchecAuthentification, AuditOutcome.Refuse,
                email, ip, detail: "Compte verrouille apres echecs successifs du second facteur.", correlationId: correlationId);
            RedirectManager.RedirectTo("Account/Lockout");
        }
        else
        {
            Logger.LogWarning("Code d'authentification invalide saisi pour l'utilisateur {UserId}.", userId);
            await AuditWriter.WriteAsync(AuditAction.DeconnexionOuEchecAuthentification, AuditOutcome.Echec,
                email, ip, detail: "Code TOTP incorrect.", correlationId: correlationId);
            message = "Erreur : Code d'authentification incorrect. Vérifiez que l'heure de votre téléphone est à jour.";
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Le code d'authentification est obligatoire.")]
        [StringLength(7, ErrorMessage = "Le code doit comporter entre {2} et {1} caractères.", MinimumLength = 6)]
        [DataType(DataType.Text)]
        [Display(Name = "Code d'authentification")]
        public string? TwoFactorCode { get; set; }

        [Display(Name = "Mémoriser ce navigateur")]
        public bool RememberMachine { get; set; }
    }
}
