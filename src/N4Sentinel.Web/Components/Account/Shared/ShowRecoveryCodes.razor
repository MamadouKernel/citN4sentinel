<StatusMessage Message="@StatusMessage" />

<div class="space-y-4">
    <h3 class="text-lg font-bold text-white tracking-tight">Codes de récupération d'urgence</h3>

    <div class="p-4 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-200 text-xs space-y-1.5">
        <div class="font-bold flex items-center gap-1.5">
            <i class="bi bi-shield-exclamation text-base text-amber-400"></i>
            Conservez ces codes en lieu sûr (gestionnaire d'identifiants ou coffre-fort).
        </div>
        <p class="text-amber-200/80 leading-relaxed">
            Ils vous sont présentés une seule fois. Sans eux et en cas de perte de votre téléphone, l'accès à N4 Sentinel exige une réinitialisation par un administrateur.
        </p>
    </div>

    <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 grid grid-cols-2 gap-2 font-mono text-center text-sm text-sky-400 font-semibold select-all">
        @foreach (var recoveryCode in RecoveryCodes)
        {
            <div class="p-2 rounded-lg bg-slate-950/60 border border-slate-800">
                @recoveryCode
            </div>
        }
    </div>

    <div class="pt-2">
        <a href="Account/Manage/TwoFactorAuthentication" class="w-full inline-flex justify-center items-center gap-2 px-4 py-2.5 rounded-xl bg-sky-600 hover:bg-sky-500 text-white font-bold text-xs transition">
            J'ai bien sauvegardé mes codes &rarr;
        </a>
    </div>
</div>

@code {
    [Parameter]
    public string[] RecoveryCodes { get; set; } = [];

    [Parameter]
    public string? StatusMessage { get; set; }
}
