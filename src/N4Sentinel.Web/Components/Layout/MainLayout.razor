@inherits LayoutComponentBase
@implements IDisposable
@using N4Sentinel.Web.Components.Shared
@using N4Sentinel.Web.State
@inject CurrentEnvironmentState EnvState

<div class="min-h-screen app-bg-main text-slate-100 flex flex-col lg:flex-row w-full">
    <!-- Barre latérale : marque, environnement, menu complet groupé par contexte -->
    <Sidebar />

    <!-- Zone de contenu principale -->
    <div class="flex-1 min-w-0 flex flex-col">
        <main class="flex-1 p-4 sm:p-6 lg:p-8 w-full max-w-[1800px] mx-auto">
            <AuthorizeView>
                <Authorized>
                    <BandeauCompteExploitation />
                </Authorized>
            </AuthorizeView>
            @Body
        </main>
    </div>

    <VoiceCopilot />
</div>

<div id="blazor-error-ui" data-nosnippet>
    Un problème est survenu.
    <a href="." class="reload">Recharger</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override void OnInitialized() => EnvState.Changed += OnEnvironmentChanged;

    private void OnEnvironmentChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => EnvState.Changed -= OnEnvironmentChanged;
}
