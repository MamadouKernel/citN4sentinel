@inherits LayoutComponentBase
@implements IDisposable
@using N4Sentinel.Web.Components.Shared
@using N4Sentinel.Web.State
@inject CurrentEnvironmentState EnvState

<div class="min-h-screen bg-slate-950 text-slate-100 flex flex-col lg:flex-row">
    <!-- Desktop Sidebar -->
    <aside class="hidden lg:flex lg:w-64 lg:flex-col lg:fixed lg:inset-y-0 z-40">
        <NavMenu />
    </aside>

    <!-- Mobile Drawer Overlay Toggle -->
    @if (_mobileMenuOpen)
    {
        <div class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 lg:hidden" @onclick="ToggleMobileMenu">
            <div class="w-72 h-full bg-slate-900 shadow-2xl" @onclick:stopPropagation>
                <NavMenu />
            </div>
        </div>
    }

    <!-- Main Content Area -->
    <div class="lg:pl-64 flex flex-col flex-1 min-h-screen">
        <!-- Top Navigation Header -->
        <header class="h-16 bg-slate-900/80 backdrop-blur-md border-b border-slate-800/80 sticky top-0 z-30 px-4 sm:px-6 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <!-- Mobile Hamburger Button -->
                <button @onclick="ToggleMobileMenu" class="lg:hidden p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition">
                    <i class="bi bi-list text-xl"></i>
                </button>

                @* Environnement courant, visible en permanence (FR-001, SEC-004).
                   Rien n'est affiche tant qu'aucun environnement n'est ouvert :
                   mieux vaut un espace vide qu'un indicateur qui laisserait
                   croire a un contexte alors qu'il n'y en a pas. *@
                @if (EnvState.Current is { } env)
                {
                    @if (env.IsProduction)
                    {
                        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-extrabold bg-rose-500/15 text-rose-300 border border-rose-500/40"
                              title="Vous travaillez sur la Production. Toute action mutative y a un impact immediat sur les operations portuaires.">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <span>PRODUCTION &middot; @env.Code</span>
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-sky-500/10 text-sky-300 border border-sky-500/25"
                              title="@env.Name">
                            <i class="bi bi-hdd-stack"></i>
                            <span>@env.Kind &middot; @env.Code</span>
                        </span>
                    }
                }
                else
                {
                    <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium bg-slate-800 text-slate-400 border border-slate-700">
                        <i class="bi bi-dash-circle"></i>
                        <span>Aucun environnement ouvert</span>
                    </span>
                }

                <span class="hidden md:inline-block text-xs text-slate-400 font-medium">
                    &middot; Écosystème Navis N4 Côte d'Ivoire Terminal
                </span>
            </div>

            <div class="flex items-center gap-3">
                <!-- Color Palette Theme Selector -->
                <ThemeSelector />

                <div class="hidden sm:block text-right border-l border-slate-800 pl-3">
                    <div class="text-xs font-bold text-white">CIT / DSI Solutions</div>
                    <div class="text-[10px] text-slate-400">Environnement d'exploitation</div>
                </div>
            </div>
        </header>

        <!-- Main Body -->
        <main class="flex-1 p-4 sm:p-6 lg:p-8 max-w-7xl w-full mx-auto">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Un problème est survenu.
    <a href="." class="reload">Recharger</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _mobileMenuOpen;

    protected override void OnInitialized() => EnvState.Changed += OnEnvironmentChanged;

    private void OnEnvironmentChanged() => InvokeAsync(StateHasChanged);

    private void ToggleMobileMenu()
    {
        _mobileMenuOpen = !_mobileMenuOpen;
    }

    public void Dispose() => EnvState.Changed -= OnEnvironmentChanged;
}
