@inherits LayoutComponentBase
@implements IDisposable
@using N4Sentinel.Web.Components.Shared
@using N4Sentinel.Web.State
@inject CurrentEnvironmentState EnvState

<div class="min-h-screen app-bg-main text-slate-100 flex flex-col w-full">
    <!-- Top Horizontal Navigation Bar (Fluid Navbar) -->
    <header class="sticky top-0 z-50 w-full app-bg-header backdrop-blur-xl border-b border-slate-800/80 shadow-2xl">
        <NavMenu />
    </header>

    <!-- Main Content Area (Fluid Container Widescreen) -->
    <main class="flex-1 p-4 sm:p-6 lg:p-8 w-full max-w-[1920px] mx-auto">
        @Body
    </main>

    <VoiceCopilot />
</div>

<div id="blazor-error-ui" data-nosnippet>
    Un problème est survenu.
    <a href="." class="reload">Recharger</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override void OnInitialized() => EnvState.Changed += OnEnvironmentChanged;

    private void OnEnvironmentChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => EnvState.Changed -= OnEnvironmentChanged;
}
