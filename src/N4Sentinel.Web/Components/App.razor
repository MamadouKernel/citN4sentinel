<!DOCTYPE html>
<html lang="fr" class="h-full bg-slate-900 antialiased" data-theme="ocean">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />

    <!-- Theme Initialization Script -->
    <script src="theme.js"></script>

    @* Polices systeme plutot que Google Fonts.
       N4 Sentinel est destine a des reseaux d'exploitation isoles : un appel
       vers fonts.googleapis.com y echoue, et la page bascule alors sur une
       police de repli non choisie. Les piles ci-dessous rendent le meme aspect
       sans aucune requete sortante, et sans les 200 Ko de fichiers de polices.
       Segoe UI Variable est present sur Windows Server 2022 et ulterieur. *@
    
    <!-- Vector Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Tailwind CSS v3 via CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        n4navy: {
                            950: '#070e17',
                            900: '#0b192c',
                            800: '#0f172a',
                            700: '#1e293b',
                            600: '#334155',
                        },
                        n4blue: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            400: '#38bdf8',
                            500: '#0ea5e9',
                            600: '#0284c7',
                            700: '#0369a1',
                        },
                        n4emerald: {
                            50: '#ecfdf5',
                            100: '#d1fae5',
                            500: '#10b981',
                            600: '#059669',
                            700: '#047857',
                        },
                        n4amber: {
                            50: '#fffbeb',
                            100: '#fef3c7',
                            500: '#f59e0b',
                            600: '#d97706',
                        },
                        n4rose: {
                            50: '#fff1f2',
                            100: '#ffe4e6',
                            500: '#f43f5e',
                            600: '#e11d48',
                        }
                    },
                    fontFamily: {
                        sans: ['"Segoe UI Variable Text"', '"Segoe UI"', 'ui-sans-serif',
                               'system-ui', '-apple-system', '"Helvetica Neue"', 'Arial', 'sans-serif'],
                        mono: ['ui-monospace', '"Cascadia Mono"', 'Consolas',
                               '"SFMono-Regular"', 'Menlo', 'monospace'],
                    }
                }
            }
        }
    </script>

    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["N4Sentinel.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body class="h-full font-sans text-slate-100 app-bg-main selection:bg-sky-500 selection:text-white">
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["Components/Account/Shared/PasskeySubmit.razor.js"]" type="module"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
