<!DOCTYPE html>
<html lang="fr" class="h-full bg-slate-900 antialiased" data-theme="ocean">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />

    <!-- Theme Initialization Script -->
    <script src="theme.js"></script>

    @* Polices systeme plutot que Google Fonts.
       N4 Sentinel est destine a des reseaux d'exploitation isoles : un appel
       vers fonts.googleapis.com y echoue, et la page bascule alors sur une
       police de repli non choisie. Les piles ci-dessous rendent le meme aspect
       sans aucune requete sortante, et sans les 200 Ko de fichiers de polices.
       Segoe UI Variable est present sur Windows Server 2022 et ulterieur. *@
    
    @* Icônes hébergées localement. Elles venaient d'un CDN public : sur un
       réseau d'exploitation isolé, l'appel échoue et l'interface perd toutes
       ses icônes, sans message et sans trace. *@
    <link rel="stylesheet" href="lib/bootstrap-icons/bootstrap-icons.min.css">

    @* Tailwind compilé localement.

       Le CDN Tailwind compilait le CSS DANS LE NAVIGATEUR à chaque chargement
       de page. C'est un outil de développement, pas un mode de livraison : il
       imposait un accès Internet au moment où l'utilisateur ouvre
       l'application, ce qu'un réseau d'exploitation isolé ne fournit pas.

       La configuration est passée dans tailwind.config.js, et le fichier
       produit est versionné : l'application s'affiche correctement depuis un
       clone neuf, sans Node et sans réseau. Seule sa modification exige la
       chaîne de compilation — voir README, section Styles. *@
    <link rel="stylesheet" href="@Assets["css/tailwind.min.css"]" />

    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["N4Sentinel.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/svg+xml" href="favicon.svg?v=2" />
    <link rel="icon" type="image/png" href="favicon.png?v=2" />
    <link rel="manifest" href="manifest.json" />
    <meta name="theme-color" content="#0284c7" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body class="h-full font-sans text-slate-100 app-bg-main selection:bg-sky-500 selection:text-white">
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script src="telechargement.js"></script>
    <script src="js/n4VoiceCopilot.js"></script>
    <script src="js/idle-timeout.js"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["Components/Account/Shared/PasskeySubmit.razor.js"]" type="module"></script>
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', function() {
                navigator.serviceWorker.register('/sw.js');
            });
        }
    </script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
