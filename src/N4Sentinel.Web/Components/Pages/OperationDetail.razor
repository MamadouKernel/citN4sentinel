@page "/operations/{Id:guid}"
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@using N4Sentinel.Domain
@using N4Sentinel.Infrastructure.Orchestration
@attribute [Authorize(Policy = N4Policies.PeutConsulter)]
@rendermode InteractiveServer
@inject ExecutionService Executions
@inject OrchestrationEngine Moteur
@inject PreflightService Preflight
@inject ExecutionReportService Rapport
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JS

<PageTitle>@(_x?.WorkflowName ?? "Opération") — N4 Sentinel</PageTitle>

@if (_x is null)
{
    <div class="glass-card p-8 rounded-2xl border border-slate-800 text-center text-slate-400 text-xs">
        <div class="inline-block w-6 h-6 border-2 border-sky-500 border-t-transparent rounded-full animate-spin mb-2"></div>
        <div>Chargement…</div>
    </div>
}
else
{
    <div class="space-y-6">

        <!-- En-tête -->
        <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-4">
            <div>
                <a href="/operations" class="text-xs text-theme-primary hover:underline transition flex items-center gap-1 mb-1">
                    <i class="bi bi-arrow-left"></i> Retour aux opérations
                </a>
                <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight flex items-center gap-3 flex-wrap">
                    @_x.WorkflowName
                    <span class="text-base font-mono text-sky-400">v@_x.WorkflowVersion</span>
                    @if (_x.IsSimulation)
                    {
                        <span class="px-2.5 py-1 rounded-lg bg-slate-700/60 text-slate-200 text-[11px] font-bold">SIMULATION</span>
                    }
                    @if (_x.AutomationLevel == AutomationLevel.AutomatiqueBoutEnBout)
                    {
                        <span class="px-2.5 py-1 rounded-lg bg-purple-500/20 text-purple-300 border border-purple-500/30 text-[11px] font-extrabold flex items-center gap-1">
                            <i class="bi bi-robot"></i> PALIER 2 — AUTOMATIQUE
                        </span>
                    }
                </h1>
                <p class="text-xs text-slate-400 mt-1">
                    @_x.EnvironmentCode &middot; demandée par <span class="text-slate-200">@_x.RequestedBy</span>
                    &middot; corrélation <span class="font-mono text-slate-500">@_x.CorrelationId</span>
                </p>
            </div>

            <div class="text-right space-y-2">
                <span class="px-3 py-1.5 rounded-full text-xs font-bold @Operations.PastilleEtat(_x.Status)">
                    @Operations.LibelleEtat(_x.Status)
                </span>

                @if (_x.AutomationLevel == AutomationLevel.AutomatiqueBoutEnBout && _x.Status == ExecutionStatus.EnCours)
                {
                    <div>
                        <button @onclick="ActiverArrêtUrgencePalier1" class="px-3 py-1.5 rounded-xl bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 border border-amber-500/40 text-xs font-bold transition flex items-center gap-1.5 shadow-md">
                            <i class="bi bi-exclamation-triangle-fill text-amber-400"></i>
                            <span>Arrêt d'Urgence / Fallback Palier 1 (1-Click)</span>
                        </button>
                    </div>
                }

                <div class="text-[11px] text-slate-400">
                    @if (_x.StartedAt is { } debut)
                    {
                        <div>Lancée à @debut.ToLocalTime().ToString("dd/MM HH:mm:ss")</div>
                    }
                    @if (_x.Duration is { } duree)
                    {
                        <div class="font-mono">@StepExecutor.Formater(duree)</div>
                    }
                </div>
            </div>
        </div>

        @if (_message is not null)
        {
            <div class="p-3.5 rounded-xl text-xs font-semibold border @_messageClass">@_message</div>
        }

        <!-- Motif et impact -->
        <div class="glass-card rounded-2xl border border-slate-800 p-5 text-xs space-y-2">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    <div class="text-slate-500 font-semibold uppercase text-[10px] tracking-wider mb-1">Motif</div>
                    <div class="text-slate-200 leading-relaxed">@_x.Reason</div>
                </div>
                <div>
                    <div class="text-slate-500 font-semibold uppercase text-[10px] tracking-wider mb-1">Ticket</div>
                    <div class="text-slate-200 font-mono">@(_x.TicketReference ?? "—")</div>
                </div>
                <div>
                    <div class="text-slate-500 font-semibold uppercase text-[10px] tracking-wider mb-1">
                        Approbation@(_x.RequiresDoubleApproval ? " (double requise)" : "")
                    </div>
                    <div class="text-slate-200 space-y-0.5">
                        @if (_x.ApprovedBy is not null)
                        {
                            <div>1<sup>re</sup> : @_x.ApprovedBy, le @_x.ApprovedAt!.Value.ToLocalTime().ToString("dd/MM HH:mm")</div>
                            @if (_x.RequiresDoubleApproval)
                            {
                                @if (_x.SecondApprovedBy is not null)
                                {
                                    <div>2<sup>e</sup> : @_x.SecondApprovedBy, le @_x.SecondApprovedAt!.Value.ToLocalTime().ToString("dd/MM HH:mm")</div>
                                }
                                else
                                {
                                    <div class="text-amber-400">En attente d'un second approbateur, distinct du premier.</div>
                                }
                            }
                        }
                        else
                        {
                            <text>—</text>
                        }
                    </div>
                </div>
            </div>

            @if (_x.ExpectedImpact is { Length: > 0 } impact)
            {
                <div class="pt-2 border-t border-slate-800">
                    <div class="text-slate-500 font-semibold uppercase text-[10px] tracking-wider mb-1">Impact attendu</div>
                    <div class="@(impact.Contains("INTERRUPTION TOTALE") ? "text-rose-300 font-semibold" : "text-slate-300")">@impact</div>
                </div>
            }
        </div>

        <!-- Continuité Center (FR-046/047) -->
        @if (_x.ContinuityChoiceRequired)
        {
            <div class="glass-card rounded-2xl border @(_x.ContinuityChoice is null ? "border-amber-500/40" : "border-slate-800") p-5 text-xs space-y-3">
                <h3 class="text-sm font-bold text-white flex items-center gap-2">
                    <i class="bi bi-arrow-left-right text-amber-400"></i> Continuité Center
                </h3>
                <p class="text-slate-400 leading-relaxed">
                    Cette opération arrête ou redémarre le Center. Un service Windows démarré ne dit pas qui
                    détient le rôle actif du cluster (FR-032/033) : précisez l'intention avant de poursuivre.
                </p>

                @if (_x.ContinuityChoice is { } choix)
                {
                    <div class="text-slate-200">
                        <span class="font-bold">@(choix == CenterContinuityChoice.Basculer ? "Basculer vers le Standby" : "Rester actif")</span>
                        — choisi par @_x.ContinuityChoiceBy le @_x.ContinuityChoiceAt!.Value.ToLocalTime().ToString("dd/MM HH:mm")
                    </div>
                }
                else if (!_x.IsFinished)
                {
                    <AuthorizeView Policy="@N4Policies.PeutExecuter">
                        <div class="flex flex-wrap gap-2">
                            <button class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs transition"
                                    @onclick="() => ChoisirContinuite(CenterContinuityChoice.ResterActif)">
                                <i class="bi bi-shield-check"></i> Le Center reste actif
                            </button>
                            <button class="px-4 py-2 rounded-xl bg-amber-500/15 hover:bg-amber-500/25 text-amber-400 border border-amber-500/30 font-bold text-xs transition"
                                    @onclick="() => ChoisirContinuite(CenterContinuityChoice.Basculer)">
                                <i class="bi bi-arrow-left-right"></i> Basculer vers le Standby
                            </button>
                        </div>
                    </AuthorizeView>
                }
            </div>
        }

        <!-- Issue -->
        @if (_x.Outcome is { Length: > 0 } issue)
        {
            <div class="p-4 rounded-xl text-xs leading-relaxed border @IssueClasse()">
                <strong class="block mb-1">@Operations.LibelleEtat(_x.Status)</strong>
                @issue
            </div>
        }

        <!-- Contrôles préalables (FR-012) -->
        @if (!_x.IsFinished || _controles.Count > 0)
        {
            <div class="glass-card rounded-2xl border @(_x.PreflightBlocked ? "border-rose-500/40" : "border-slate-800") overflow-hidden">
                <div class="p-5 border-b border-slate-800 flex items-center justify-between flex-wrap gap-3">
                    <div>
                        <h3 class="text-sm font-bold text-white flex items-center gap-2">
                            <i class="bi bi-clipboard2-check text-sky-400"></i> Contrôles préalables
                        </h3>
                        <p class="text-[11px] text-slate-500 mt-1 max-w-2xl leading-relaxed">
                            Découvrir un serveur injoignable à la septième étape d'un arrêt complet est le pire
                            moment possible. <strong class="text-slate-400">Un contrôle bloquant en échec interdit
                            le lancement, et ne se contourne pas.</strong>
                        </p>
                    </div>

                    <AuthorizeView Policy="@N4Policies.PeutExecuter" Context="verificateur">
                        @if (!_x.IsFinished)
                        {
                            <button class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs transition disabled:opacity-40 whitespace-nowrap"
                                    disabled="@_preflightEnCours" @onclick="LancerPreCheck">
                                <i class="bi bi-clipboard2-check"></i>
                                @(_preflightEnCours ? "Contrôles en cours…" : _controles.Count == 0 ? "Passer les contrôles" : "Repasser les contrôles")
                            </button>
                        }
                    </AuthorizeView>
                </div>

                @if (_controles.Count == 0)
                {
                    <div class="p-6 text-xs text-slate-400">
                        Les contrôles n'ont pas encore été passés. L'opération ne peut pas être lancée avant.
                    </div>
                }
                else
                {
                    <div class="divide-y divide-slate-800">
                        @foreach (var c in _controles)
                        {
                            <div class="p-4 flex items-start gap-3 text-xs">
                                <span class="px-2 py-0.5 rounded-md text-[10px] font-bold shrink-0 mt-0.5 @PastilleControle(c.Outcome)">
                                    @LibelleControle(c)
                                </span>
                                <div class="space-y-1 min-w-0">
                                    <div class="font-bold text-white">@c.Name</div>
                                    <p class="text-slate-300 leading-relaxed">@c.Detail</p>
                                    @if (c.Remedy is not null)
                                    {
                                        <p class="text-slate-500"><i class="bi bi-arrow-return-right"></i> @c.Remedy</p>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    @if (_x.PreflightAt is { } passeA)
                    {
                        <div class="px-4 py-2.5 border-t border-slate-800 text-[11px] text-slate-500">
                            Passés le @passeA.ToLocalTime().ToString("dd/MM à HH:mm:ss").
                        </div>
                    }
                }
            </div>
        }

        <!-- Commandes -->
        <AuthorizeView Policy="@N4Policies.PeutExecuter">
            <div class="flex flex-wrap items-center gap-2">
                @if (_x.Status == ExecutionStatus.EnAttenteApprobation)
                {
                    <AuthorizeView Policy="@N4Policies.PeutApprouver" Context="approbateur">
                        <button class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs transition"
                                @onclick="Approuver">
                            <i class="bi bi-check2-circle"></i> Approuver
                        </button>
                    </AuthorizeView>
                }

                @if (_x.Status == ExecutionStatus.EnPreparation)
                {
                    <button class="px-4 py-2 rounded-xl btn-theme-primary text-white font-bold text-xs transition disabled:opacity-40"
                            disabled="@(!_x.PreflightCleared)" @onclick="Lancer"
                            title="@(_x.PreflightCleared ? null : "Les contrôles préalables doivent être passés sans échec bloquant.")">
                        <i class="bi bi-play-fill"></i> Lancer maintenant
                    </button>
                }

                @if (_x.IsFinished)
                {
                    <button class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs transition"
                            @onclick="TelechargerRapport">
                        <i class="bi bi-file-earmark-text"></i> Rapport d'exécution
                    </button>
                }

                @if (_x.Status == ExecutionStatus.EnCours)
                {
                    <button class="px-4 py-2 rounded-xl bg-amber-600 hover:bg-amber-500 text-white font-bold text-xs transition"
                            @onclick="MettreEnPause">
                        <i class="bi bi-pause-fill"></i> Mettre en pause
                    </button>
                }

                @if (_x.Status is ExecutionStatus.EnPause or ExecutionStatus.ReconciliationRequise)
                {
                    <button class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs transition"
                            @onclick="Reprendre">
                        <i class="bi bi-play-fill"></i> Reprendre
                    </button>
                }

                @if (!_x.IsFinished)
                {
                    @if (_annulationArmee)
                    {
                        <button class="px-4 py-2 rounded-xl bg-rose-600 hover:bg-rose-500 text-white font-bold text-xs transition animate-pulse"
                                @onclick="Annuler">
                            <i class="bi bi-exclamation-triangle-fill"></i> Confirmer l'annulation ?
                        </button>
                        <button class="px-3 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold text-xs transition"
                                @onclick="() => _annulationArmee = false">
                            Non
                        </button>
                    }
                    else
                    {
                        <button class="px-3 py-1.5 rounded-lg bg-transparent hover:bg-rose-500/10 border border-rose-500/30 text-rose-400 font-bold text-xs transition"
                                @onclick="() => _annulationArmee = true">
                            <i class="bi bi-x-lg"></i> Annuler
                        </button>
                    }
                }
            </div>
        </AuthorizeView>

        @if (_x.Status is ExecutionStatus.AnnulationDemandee)
        {
            <div class="p-3.5 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-200 text-xs">
                Annulation demandée par @_x.CancelRequestedBy. <strong>L'étape en cours va à son terme</strong> :
                l'interrompre au milieu laisserait le composant dans un état que personne ne saurait décrire.
            </div>
        }

        <!-- Progression -->
        <div class="glass-card rounded-2xl border border-slate-800 overflow-hidden">
            <div class="p-5 border-b border-slate-800 flex items-center justify-between flex-wrap gap-2">
                <h3 class="text-sm font-bold text-white flex items-center gap-2">
                    <i class="bi bi-list-check text-sky-400"></i>
                    Étapes — @_termines / @_x.Steps.Count
                </h3>
                <div class="w-full sm:w-64 h-1.5 rounded-full bg-slate-800 overflow-hidden">
                    <div class="h-full rounded-full bg-theme-gradient transition-all duration-500"
                         style="width:@(_x.Steps.Count == 0 ? 0 : _termines * 100 / _x.Steps.Count)%"></div>
                </div>
            </div>

            <div class="divide-y divide-slate-800">
                @foreach (var etape in _x.Steps.OrderBy(s => s.Order))
                {
                    <div class="p-5 @(etape.State == ExecutionStepState.EnCours ? "bg-sky-500/[0.04]" : "")">
                        <div class="flex items-start gap-3">
                            <div class="w-8 h-8 rounded-xl flex items-center justify-center shrink-0 @PastilleEtape(etape.State)">
                                <i class="bi @IconeEtape(etape.State) text-sm"></i>
                            </div>

                            <div class="flex-1 min-w-0 space-y-1.5">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <span class="font-bold text-white text-sm">@etape.Order. @etape.Name</span>
                                    <span class="px-2 py-0.5 rounded-md bg-slate-800 text-slate-400 text-[10px] font-bold">
                                        @LibelleAction(etape.Action)
                                    </span>
                                    @if (etape.ComponentName is not null)
                                    {
                                        <span class="text-[11px] text-slate-400">
                                            @etape.ComponentName
                                            @if (etape.HostName is not null)
                                            {
                                                <span class="font-mono text-slate-500"> @@@etape.HostName</span>
                                            }
                                        </span>
                                    }
                                    @if (etape.Duration is { } d && etape.StartedAt is not null)
                                    {
                                        <span class="text-[11px] font-mono text-slate-500">@StepExecutor.Formater(d)</span>
                                    }
                                </div>

                                @if (etape.State == ExecutionStepState.EnCours && etape.ProgressMessage is { Length: > 0 } avancement)
                                {
                                    <div class="text-xs text-sky-300 flex items-start gap-2">
                                        <span class="inline-block w-3 h-3 border-2 border-sky-500 border-t-transparent rounded-full animate-spin mt-0.5 shrink-0"></span>
                                        <span>@avancement</span>
                                    </div>
                                }

                                @if (etape.Evidence is { Length: > 0 } preuve)
                                {
                                    <div class="text-xs text-emerald-300/90 leading-relaxed flex items-start gap-2">
                                        <i class="bi bi-patch-check-fill mt-0.5 shrink-0"></i>
                                        <span>@preuve</span>
                                    </div>
                                }

                                @if (etape.Error is { Length: > 0 } erreur)
                                {
                                    <div class="text-xs text-rose-300 leading-relaxed flex items-start gap-2">
                                        <i class="bi bi-exclamation-octagon-fill mt-0.5 shrink-0"></i>
                                        <span>@erreur</span>
                                    </div>
                                }

                                @if (etape.SkippedBy is not null)
                                {
                                    <div class="text-xs text-amber-300 leading-relaxed">
                                        <i class="bi bi-skip-forward-fill"></i>
                                        Contournée par <strong>@etape.SkippedBy</strong> — @etape.SkipReason
                                    </div>
                                }

                                @if (etape.State == ExecutionStepState.EnAttente)
                                {
                                    <div class="mt-2 p-3.5 rounded-xl bg-violet-500/10 border border-violet-500/25 space-y-2.5">
                                        <div class="text-xs text-violet-200 leading-relaxed">
                                            @(etape.Instruction ?? etape.ProgressMessage ?? "Le moteur attend une décision.")
                                        </div>

                                        <AuthorizeView Policy="@N4Policies.PeutExecuter" Context="operateur">
                                            @if (etape.Action == StepAction.InterventionManuelle)
                                            {
                                                <input class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-white text-xs"
                                                       placeholder="Note (facultative) : ce qui a été constaté."
                                                       @bind="_note" />
                                                <div class="flex flex-wrap gap-2">
                                                    <button class="px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs transition"
                                                            @onclick="() => Confirmer(etape.Id, true)">
                                                        <i class="bi bi-check2"></i> C'est fait
                                                    </button>
                                                    <button class="px-3 py-1.5 rounded-lg bg-rose-600/80 hover:bg-rose-500 text-white font-bold text-xs transition"
                                                            @onclick="() => Confirmer(etape.Id, false)">
                                                        <i class="bi bi-x-lg"></i> Impossible à réaliser
                                                    </button>
                                                </div>
                                            }
                                            else
                                            {
                                                <button class="px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs transition"
                                                        @onclick="() => Autoriser(etape.Id)">
                                                    <i class="bi bi-check2"></i> Autoriser cette étape
                                                </button>
                                            }
                                        </AuthorizeView>
                                    </div>
                                }

                                @if (etape.State == ExecutionStepState.Bloque)
                                {
                                    <AuthorizeView Policy="@N4Policies.PeutExecuter" Context="decideur">
                                        <div class="mt-2 flex flex-wrap items-center gap-2">
                                            <button class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs transition"
                                                    @onclick="() => Reessayer(etape.Id)">
                                                <i class="bi bi-arrow-clockwise"></i> Réessayer
                                            </button>
                                            @if (etape.IsSkippable)
                                            {
                                                <input class="bg-slate-900 border border-slate-700 rounded-lg px-3 py-1.5 text-white text-xs flex-1 min-w-48"
                                                       placeholder="Justification du contournement" @bind="_justification" @bind:event="oninput" />
                                                <button class="px-3 py-1.5 rounded-lg bg-amber-600/80 hover:bg-amber-500 text-white font-bold text-xs transition disabled:opacity-40 disabled:hover:bg-amber-600/80"
                                                        disabled="@string.IsNullOrWhiteSpace(_justification)"
                                                        title="@(string.IsNullOrWhiteSpace(_justification) ? "La justification est obligatoire avant de contourner une étape." : null)"
                                                        @onclick="() => Contourner(etape.Id)">
                                                    <i class="bi bi-skip-forward"></i> Contourner
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="text-[11px] text-slate-500">
                                                    Étape non contournable : elle ne peut être ignorée par personne.
                                                </span>
                                            }
                                        </div>
                                    </AuthorizeView>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private WorkflowExecution? _x;
    private int _termines;
    private string _note = string.Empty;
    private string _justification = string.Empty;
    private bool _annulationArmee;

    private List<PreflightCheck> _controles = [];
    private bool _preflightEnCours;

    private string? _message;
    private string _messageClass = string.Empty;

    private Timer? _rafraichissement;

    protected override async Task OnParametersSetAsync()
    {
        await Charger();

        // Rafraichissement periodique tant que l'operation vit. Le moteur
        // notifie aussi, mais l'ecran ne doit pas dependre de cette
        // notification : une operation N4 dure trop longtemps pour qu'on
        // accepte un affichage fige sans le savoir.
        _rafraichissement ??= new Timer(async _ => await InvokeAsync(async () =>
        {
            await Charger();
            StateHasChanged();
        }), null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(2));

        Moteur.ExecutionChanged += SurChangement;
    }

    private void SurChangement(Guid executionId)
    {
        if (executionId != Id) return;
        _ = InvokeAsync(async () => { await Charger(); StateHasChanged(); });
    }

    private async Task Charger()
    {
        _x = await Executions.GetAsync(Id);
        _termines = _x?.Steps.Count(s => s.IsTerminal) ?? 0;
        _controles = PreflightService.Relire(_x?.PreflightJson);
    }

    private async Task LancerPreCheck()
    {
        _preflightEnCours = true;
        _message = null;
        StateHasChanged();

        var rapport = await Preflight.RunAsync(Id);
        _preflightEnCours = false;

        await Charger();

        if (rapport.Error is not null)
        {
            _message = rapport.Error;
            _messageClass = "bg-rose-500/10 border-rose-500/20 text-rose-300";
            return;
        }

        if (rapport.HasBlockingFailure)
        {
            _message = $"{rapport.BlockingFailures} contrôle(s) bloquant(s) en échec. "
                     + "L'opération ne peut pas être lancée tant qu'ils ne sont pas corrigés.";
            _messageClass = "bg-rose-500/10 border-rose-500/20 text-rose-300";
            return;
        }

        _message = rapport.Warnings > 0
            ? $"Contrôles passés, avec {rapport.Warnings} réserve(s). L'opération peut être lancée — "
              + "les réserves apparaîtront dans le rapport."
            : "Contrôles passés sans réserve. L'opération peut être lancée.";

        _messageClass = rapport.Warnings > 0
            ? "bg-amber-500/10 border-amber-500/20 text-amber-300"
            : "bg-emerald-500/10 border-emerald-500/20 text-emerald-300";
    }

    private async Task TelechargerRapport()
    {
        var markdown = await Rapport.BuildMarkdownAsync(Id);
        if (markdown is null) return;

        var nom = $"N4Sentinel-{_x!.EnvironmentCode}-{_x.CorrelationId}.md";
        var octets = System.Text.Encoding.UTF8.GetBytes(markdown);

        await JS.InvokeVoidAsync("n4TelechargerTexte", nom, Convert.ToBase64String(octets));
    }

    private async Task<string> ActeurAsync()
    {
        var etat = await AuthProvider.GetAuthenticationStateAsync();
        return etat.User.Identity?.Name ?? "inconnu";
    }

    private async Task Approuver() => await Executer(async a => await Executions.ApproveAsync(Id, a));
    private async Task ChoisirContinuite(CenterContinuityChoice choix) =>
        await Executer(async a => await Executions.SetContinuityChoiceAsync(Id, choix, a));
    private async Task Lancer() => await Executer(async a => await Executions.StartAsync(Id, a));
    private async Task MettreEnPause() => await Executer(async a => await Executions.RequestPauseAsync(Id, a));
    private async Task Reprendre() => await Executer(async a => await Executions.ResumeAsync(Id, a));
    private async Task Annuler() => await Executer(async a => await Executions.RequestCancelAsync(Id, a));

    private async Task Autoriser(Guid stepId) =>
        await Executer(async a => await Executions.AuthorizeStepAsync(stepId, a));

    private async Task Reessayer(Guid stepId) =>
        await Executer(async a => await Executions.RetryStepAsync(stepId, a));

    private async Task Confirmer(Guid stepId, bool reussi) =>
        await Executer(async a => await Executions.ConfirmStepAsync(
            stepId, a, string.IsNullOrWhiteSpace(_note) ? null : _note.Trim(), reussi));

    private async Task Contourner(Guid stepId) =>
        await Executer(async a => await Executions.SkipStepAsync(stepId, a, _justification.Trim()));

    private async Task Executer(Func<string, Task<string?>> action)
    {
        var acteur = await ActeurAsync();
        var erreur = await action(acteur);

        _message = erreur;
        _messageClass = "bg-rose-500/10 border-rose-500/20 text-rose-300";

        _note = string.Empty;
        _justification = string.Empty;
        _annulationArmee = false;

        await Charger();
    }

    private async Task ActiverArrêtUrgencePalier1()
    {
        if (_x is null) return;
        var acteur = await ActeurAsync();
        await Moteur.ToggleFallbackToSemiAutoAsync(_x.Id, acteur);
        _message = "Bascule d'urgence activée : l'exécution repasse sous contrôle semi-automatique strict (Palier 1).";
        _messageClass = "bg-amber-500/10 border-amber-500/30 text-amber-200";
        await Charger();
    }

    private string IssueClasse() => _x!.Status switch
    {
        ExecutionStatus.TermineSucces => "bg-emerald-500/10 border-emerald-500/20 text-emerald-200",
        ExecutionStatus.Echec => "bg-rose-500/10 border-rose-500/20 text-rose-200",
        ExecutionStatus.ReconciliationRequise => "bg-amber-500/10 border-amber-500/30 text-amber-100",
        _ => "bg-amber-500/10 border-amber-500/20 text-amber-200"
    };

    private static string PastilleControle(PreflightOutcome o) => o switch
    {
        PreflightOutcome.Reussi => "bg-emerald-500/15 text-emerald-400",
        PreflightOutcome.Avertissement => "bg-amber-500/15 text-amber-400",
        PreflightOutcome.Echec => "bg-rose-500/15 text-rose-300",
        _ => "bg-slate-800 text-slate-500"
    };

    private static string LibelleControle(PreflightCheck c) => c.Outcome switch
    {
        PreflightOutcome.Reussi => "OK",
        PreflightOutcome.Avertissement => "RÉSERVE",
        PreflightOutcome.Echec => c.IsBlocking ? "BLOQUANT" : "ÉCHEC",
        _ => "SANS OBJET"
    };

    private static string LibelleAction(StepAction a) => a switch
    {
        StepAction.Verifier => "Vérifier",
        StepAction.Demarrer => "Démarrer",
        StepAction.Arreter => "Arrêter",
        StepAction.Redemarrer => "Redémarrer",
        StepAction.InterventionManuelle => "Intervention manuelle",
        StepAction.Attendre => "Attendre",
        _ => a.ToString()
    };

    private static string PastilleEtape(ExecutionStepState s) => s switch
    {
        ExecutionStepState.Reussi => "bg-emerald-500/15 text-emerald-400",
        ExecutionStepState.Avertissement => "bg-amber-500/15 text-amber-400",
        ExecutionStepState.Echec => "bg-rose-500/15 text-rose-400",
        ExecutionStepState.EnCours or ExecutionStepState.Verification => "bg-sky-500/15 text-sky-400",
        ExecutionStepState.EnAttente => "bg-violet-500/15 text-violet-300",
        ExecutionStepState.Bloque => "bg-rose-500/15 text-rose-300",
        ExecutionStepState.Ignore => "bg-slate-700/40 text-slate-300",
        ExecutionStepState.Annule => "bg-slate-800 text-slate-500",
        _ => "bg-slate-800 text-slate-500"
    };

    private static string IconeEtape(ExecutionStepState s) => s switch
    {
        ExecutionStepState.Reussi => "bi-check-lg",
        ExecutionStepState.Avertissement => "bi-exclamation-triangle-fill",
        ExecutionStepState.Echec => "bi-x-lg",
        ExecutionStepState.EnCours or ExecutionStepState.Verification => "bi-arrow-repeat",
        ExecutionStepState.EnAttente => "bi-person-raised-hand",
        ExecutionStepState.Bloque => "bi-pause-fill",
        ExecutionStepState.Ignore => "bi-skip-forward-fill",
        ExecutionStepState.Annule => "bi-slash-circle",
        _ => "bi-circle"
    };

    public void Dispose()
    {
        Moteur.ExecutionChanged -= SurChangement;
        _rafraichissement?.Dispose();
    }
}
