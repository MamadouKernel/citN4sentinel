@page "/diagnostics/{Id:guid}"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using N4Sentinel.Domain
@using N4Sentinel.Infrastructure.Diagnostic
@using N4Sentinel.Infrastructure.Procedures
@using N4Sentinel.Infrastructure.Referential
@using N4Sentinel.Infrastructure.Security
@attribute [Authorize(Policy = N4Policies.PeutDiagnostiquer)]
@rendermode InteractiveServer
@inject DiagnosticSessionService Sessions
@inject LogAnalysisService Analyse
@inject DiagnosticSettingsService DiagSettings
@inject ReferentialService Referential
@inject SopService Sop
@inject N4Sentinel.Infrastructure.Reporting.ReportDocumentService Documents
@inject N4Sentinel.Infrastructure.Reporting.IncidentReportService IncidentReport
@inject N4Sentinel.Infrastructure.Security.DocumentAntivirusScanner Antivirus
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthProvider

<PageTitle>@(_s?.Title ?? "Diagnostic") — N4 Sentinel</PageTitle>

@if (_s is null)
{
    <div class="glass-card p-8 rounded-2xl border border-slate-800 text-center text-slate-400 text-xs">
        <div class="inline-block w-6 h-6 border-2 border-sky-500 border-t-transparent rounded-full animate-spin mb-2"></div>
        <div>Chargement…</div>
    </div>
}
else
{
    <div class="space-y-6">

        <!-- En-tête -->
        <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-4">
            <div>
                <a href="/diagnostics" class="text-xs text-theme-primary hover:underline transition flex items-center gap-1 mb-1">
                    <i class="bi bi-arrow-left"></i> Retour aux diagnostics
                </a>
                <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">@_s.Title</h1>
                <p class="text-xs text-slate-400 mt-1">
                    @_s.EnvironmentCode &middot; ouvert par @_s.RequestedBy
                    le @_s.CreatedAt.ToLocalTime().ToString("dd/MM à HH:mm")
                    @if (_s.TicketReference is { Length: > 0 })
                    {
                        <span class="font-mono"> &middot; @_s.TicketReference</span>
                    }
                </p>
            </div>

            <div class="flex flex-wrap items-center gap-2">
                <button class="px-4 py-2 rounded-xl btn-theme-primary text-white font-bold text-xs transition disabled:opacity-40"
                        disabled="@(_enCours || _s.Sources.Count == 0)" @onclick="Conclure">
                    <i class="bi bi-lightbulb"></i> @(_analyseEnCours ? "Analyse…" : "Conclure")
                </button>

                @if (_s.HasBeenAnalysed)
                {
                    <div class="inline-flex rounded-xl overflow-hidden border border-slate-700">
                        <button class="px-3 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs transition"
                                @onclick="TelechargerRapport" title="Markdown">
                            <i class="bi bi-file-earmark-text"></i> Rapport
                        </button>
                        <button class="px-3 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs transition border-l border-slate-700"
                                @onclick="TelechargerRapportPdf" title="PDF">
                            PDF
                        </button>
                        <button class="px-3 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs transition border-l border-slate-700"
                                @onclick="TelechargerRapportWord" title="Word">
                            Word
                        </button>
                    </div>
                }
            </div>
        </div>

        <!-- Cycle de traitement en 8 phases (§3.10.1) -->
        <div class="glass-card rounded-2xl border border-slate-800 p-5 space-y-3 text-xs">
            <h3 class="text-sm font-bold text-white flex items-center gap-2">
                <i class="bi bi-diagram-3 text-sky-400"></i> Cycle de traitement
            </h3>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var p in _phases)
                {
                    <span class="px-2.5 py-1 rounded-lg text-[10px] font-bold @(p == _s.Phase ? "bg-sky-500/20 text-sky-300 border border-sky-500/40" : "bg-slate-900/60 text-slate-500 border border-slate-800")">
                        @DiagnosticSessionService.LibellePhase(p)
                    </span>
                }
            </div>
            <p class="text-[11px] text-slate-500">
                Le cycle n'est pas linéaire : un retour vers une phase déjà visitée reste possible et s'ajoute
                à l'historique ci-dessous, il ne l'efface jamais.
            </p>

            <div class="flex flex-wrap items-end gap-3 pt-2 border-t border-slate-800">
                <div class="flex-1 min-w-56">
                    <label class="block text-slate-400 font-semibold mb-1">Passer à la phase</label>
                    <select class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-white" @bind="_phaseChoisie">
                        @foreach (var p in _phases)
                        {
                            <option value="@p">@DiagnosticSessionService.LibellePhase(p)</option>
                        }
                    </select>
                </div>
                <div class="flex-[2] min-w-64">
                    <label class="block text-slate-400 font-semibold mb-1">
                        Note
                        @if (_phaseChoisie == DiagnosticPhase.ClotureEtCapitalisation)
                        {
                            <span class="text-rose-400">— obligatoire : qu'est-ce qui a été vérifié ?</span>
                        }
                    </label>
                    <input class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-white"
                           placeholder="Ce qui justifie ce passage (facultatif sauf pour la clôture)." @bind="_phaseNote" />
                </div>
                <button class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold transition disabled:opacity-40"
                        disabled="@_enCoursPhase" @onclick="ChangerPhase">
                    <i class="bi bi-arrow-right-circle"></i> Enregistrer
                </button>
            </div>

            @if (_phaseChoisie == DiagnosticPhase.ClotureEtCapitalisation
                && _s.HasBeenAnalysed && _s.VerdictEstInconcluant && string.IsNullOrWhiteSpace(_s.EscalatedTo))
            {
                <div class="p-3 rounded-xl bg-amber-500/10 border border-amber-500/20 space-y-2">
                    <p class="text-[11px] text-amber-200 leading-relaxed">
                        <i class="bi bi-exclamation-triangle-fill"></i> Ce diagnostic n'aboutit à aucune cause
                        établie (verdict actuel : @DiagnosticSessionService.LibelleVerdict(_s.Verdict)).
                        Précisez à qui il est escaladé avant de pouvoir clôturer.
                    </p>
                    <input class="w-full bg-slate-900 border border-amber-700/60 rounded-xl px-3 py-2 text-white text-xs"
                           placeholder="Escaladé vers (ex. Support Navis, équipe Infrastructure)…" @bind="_escaladeVers" />
                </div>
            }
            @if (_s.EscalatedTo is { Length: > 0 })
            {
                <p class="text-[11px] text-slate-500">
                    <i class="bi bi-arrow-up-right-circle"></i> Escaladé vers <strong class="text-slate-300">@_s.EscalatedTo</strong>
                    par @_s.EscalatedBy le @_s.EscalatedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                </p>
            }

            @if (_s.PhaseTransitions.Count > 0)
            {
                <details class="pt-2">
                    <summary class="cursor-pointer text-theme-primary hover:underline select-none text-[11px]">
                        Historique des passages (@_s.PhaseTransitions.Count)
                    </summary>
                    <ul class="mt-2 space-y-1.5">
                        @foreach (var t in _s.PhaseTransitions.OrderByDescending(t => t.EnteredAt))
                        {
                            <li class="text-[11px] text-slate-400">
                                <span class="font-mono text-slate-500">@t.EnteredAt.ToLocalTime().ToString("dd/MM HH:mm")</span>
                                — <span class="font-semibold text-slate-300">@DiagnosticSessionService.LibellePhase(t.Phase)</span>
                                par @t.EnteredBy
                                @if (t.Note is { Length: > 0 })
                                {
                                    <span> — @t.Note</span>
                                }
                            </li>
                        }
                    </ul>
                </details>
            }
        </div>

        <!-- Rapport d'incident automatique (FR-096) -->
        <div class="glass-card rounded-2xl border border-slate-800 p-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 text-xs">
            <div>
                <h3 class="text-sm font-bold text-white flex items-center gap-2">
                    <i class="bi bi-file-earmark-medical text-sky-400"></i> Rapport d'incident
                </h3>
                <p class="text-[11px] text-slate-500 mt-1 max-w-2xl">
                    Assemble la chronologie (détection, prise en charge, fin), les composants concernés, la cause
                    retenue, les preuves et le SOP éventuellement exécuté. D'autant plus complet que la session a
                    progressé dans le cycle ci-dessus.
                </p>
            </div>
            <div class="inline-flex rounded-xl overflow-hidden border border-slate-700 shrink-0">
                <button class="px-3 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs transition"
                        @onclick="TelechargerRapportIncident" title="Markdown">
                    Markdown
                </button>
                <button class="px-3 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs transition border-l border-slate-700"
                        @onclick="TelechargerRapportIncidentPdf" title="PDF">
                    PDF
                </button>
                <button class="px-3 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs transition border-l border-slate-700"
                        @onclick="TelechargerRapportIncidentWord" title="Word">
                    Word
                </button>
            </div>
        </div>

        @if (_s.Reason is { Length: > 0 })
        {
            <div class="glass-card rounded-2xl border border-slate-800 p-4 text-xs">
                <div class="text-slate-500 font-semibold uppercase text-[10px] tracking-wider mb-1">Ce que l'on cherche</div>
                <p class="text-slate-200 leading-relaxed">@_s.Reason</p>
                <p class="text-slate-500 mt-2">
                    Fenêtre analysée :
                    @if (_s.WindowStart is null && _s.WindowEnd is null)
                    {
                        <text>tout le contenu collecté.</text>
                    }
                    else
                    {
                        <text>
                            de @(_s.WindowStart?.ToLocalTime().ToString("dd/MM HH:mm") ?? "l'origine")
                            à @(_s.WindowEnd?.ToLocalTime().ToString("dd/MM HH:mm") ?? "la fin").
                        </text>
                    }
                </p>
            </div>
        }

        @if (_message is not null)
        {
            <div class="p-3.5 rounded-xl text-xs font-semibold border @_messageClass">@_message</div>
        }

        <!-- Verdict -->
        @if (_s.HasBeenAnalysed)
        {
            <div class="glass-card rounded-2xl border p-5 space-y-3 @BordureVerdict()">
                <div class="flex items-center justify-between gap-2 flex-wrap">
                    <div class="flex items-center gap-2">
                        <i class="bi @IconeVerdict() text-lg"></i>
                        <h3 class="text-sm font-bold text-white">@DiagnosticSessionService.LibelleVerdict(_s.Verdict)</h3>
                    </div>
                    <button class="px-3 py-1.5 rounded-lg bg-slate-900/60 hover:bg-slate-800 border border-slate-700/60 text-slate-300 font-semibold text-[11px] transition"
                            @onclick="BasculerReference">
                        <i class="bi @(_s.IsReferenceBaseline ? "bi-bookmark-check-fill text-emerald-400" : "bi-bookmark")"></i>
                        @(_s.IsReferenceBaseline ? "Référence saine" : "Marquer comme référence saine")
                    </button>
                </div>
                <p class="text-xs text-slate-200 leading-relaxed">@_s.VerdictExplanation</p>
            </div>
        }

        <!-- Comparaison à une référence (FR-066) -->
        @if (_s.HasBeenAnalysed)
        {
            <div class="glass-card rounded-2xl border border-slate-800 p-5 space-y-3 text-xs">
                <h3 class="text-sm font-bold text-white flex items-center gap-2">
                    <i class="bi bi-arrow-left-right text-sky-400"></i> Comparaison à une référence
                </h3>

                <div class="flex-1 min-w-56">
                    <label class="block text-slate-400 font-semibold mb-1">Mode de comparaison</label>
                    <select class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-white" @bind="_referenceKindChoisi" @bind:after="ChangerModeReference">
                        <option value="@ReferenceKind.PeriodeSaine">Une période saine validée</option>
                        <option value="@ReferenceKind.ExecutionReussie">Une exécution précédente réussie</option>
                        <option value="@ReferenceKind.ValeursHabituellesComposant">Les valeurs habituelles du composant</option>
                        <option value="@ReferenceKind.NoeudPair">Un autre nœud comparable</option>
                    </select>
                </div>

                @if (_referenceKindChoisi == ReferenceKind.PeriodeSaine)
                {
                    <div class="flex flex-wrap items-end gap-3">
                        <div class="flex-1 min-w-56">
                            <label class="block text-slate-400 font-semibold mb-1">Session de référence (saine, validée)</label>
                            <select class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-white" @bind="_referenceChoisie" @bind:after="AppliquerReference">
                                <option value="@Guid.Empty">Aucune</option>
                                @foreach (var r in _referencesDisponibles)
                                {
                                    <option value="@r.Id">@r.Title — @r.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</option>
                                }
                            </select>
                        </div>
                    </div>

                    @if (_comparaison is not null)
                    {
                        @if (_comparaison.IsStale)
                        {
                            <div class="p-2.5 rounded-lg bg-amber-500/10 border border-amber-500/25 text-amber-300 text-[11px]">
                                <i class="bi bi-exclamation-triangle-fill"></i>
                                Référence vieille de @_comparaison.ReferenceAgeDays jour(s) — à utiliser avec prudence,
                                l'environnement a pu évoluer depuis.
                            </div>
                        }
                        @if (_comparaison.ReferenceScopeIncomplete)
                        {
                            <div class="p-2.5 rounded-lg bg-amber-500/10 border border-amber-500/25 text-amber-300 text-[11px]">
                                <i class="bi bi-exclamation-triangle-fill"></i>
                                Certaines sources de la référence n'avaient pas pu être collectées : sa couverture est incomplète.
                            </div>
                        }

                        <p class="text-slate-400">
                            Référence du @_comparaison.Reference.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            — @_comparaison.Reference.Sources.Count(s => s.Succeeded) journal(aux) analysé(s).
                        </p>

                        @if (_comparaison.NewFindings.Count == 0)
                        {
                            <div class="text-emerald-400"><i class="bi bi-check-circle-fill"></i> Aucun constat absent de la référence.</div>
                        }
                        else
                        {
                            <div>
                                <div class="font-semibold text-slate-300 mb-1">@_comparaison.NewFindings.Count constat(s) absent(s) de la référence :</div>
                                <ul class="space-y-1">
                                    @foreach (var f in _comparaison.NewFindings.Take(10))
                                    {
                                        <li class="text-slate-300">
                                            <span class="px-1.5 py-0.5 rounded text-[10px] font-bold @PastilleSeverite(f.Severity)">@f.Severity</span>
                                            @f.Title
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    }
                }
                else if (_referenceKindChoisi == ReferenceKind.ExecutionReussie)
                {
                    <div class="flex flex-wrap items-end gap-3">
                        <div class="flex-1 min-w-56">
                            <label class="block text-slate-400 font-semibold mb-1">Exécution de référence (terminée avec succès)</label>
                            <select class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-white" @bind="_executionChoisie" @bind:after="AppliquerReferenceExecution">
                                <option value="@Guid.Empty">Aucune</option>
                                @foreach (var e in _executionsDisponibles)
                                {
                                    <option value="@e.Id">@e.WorkflowName — @(e.EndedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "date inconnue")</option>
                                }
                            </select>
                        </div>
                    </div>

                    @if (_comparaisonExecution is not null)
                    {
                        @if (_comparaisonExecution.IsStale)
                        {
                            <div class="p-2.5 rounded-lg bg-amber-500/10 border border-amber-500/25 text-amber-300 text-[11px]">
                                <i class="bi bi-exclamation-triangle-fill"></i>
                                Référence vieille de @_comparaisonExecution.ReferenceAgeDays jour(s) — à utiliser avec prudence.
                            </div>
                        }
                        <p class="text-slate-400">
                            @_comparaisonExecution.WorkflowName (v@_comparaisonExecution.WorkflowVersion) —
                            @(_comparaisonExecution.StartedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")
                            → @(_comparaisonExecution.EndedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")
                            @if (_comparaisonExecution.Duration is { } d)
                            {
                                <text> (@d.ToString(@"hh\hmm"))</text>
                            }
                        </p>
                        @if (_comparaisonExecution.SharedIncidentComponentNames.Count > 0)
                        {
                            <div class="text-slate-300">
                                <div class="font-semibold text-slate-300 mb-1">Composants de l'incident déjà touchés par cette exécution réussie :</div>
                                <div class="flex flex-wrap gap-1.5">
                                    @foreach (var c in _comparaisonExecution.SharedIncidentComponentNames)
                                    {
                                        <span class="px-2 py-0.5 rounded bg-slate-900/60 border border-slate-700/60 text-[11px]">@c</span>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="text-slate-500">Aucun composant de l'incident en cours ne figure dans cette exécution.</div>
                        }
                    }
                }
                else
                {
                    <div class="flex-1 min-w-56">
                        <label class="block text-slate-400 font-semibold mb-1">Composant à examiner (présent dans cet incident)</label>
                        <select class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-white" @bind="_composantSessionChoisi" @bind:after="ChangerComposantSession">
                            <option value="@Guid.Empty">Choisir…</option>
                            @foreach (var c in _composantsSession)
                            {
                                <option value="@c.ComponentId">@c.ComponentName</option>
                            }
                        </select>
                    </div>

                    @if (_referenceKindChoisi == ReferenceKind.NoeudPair && _composantSessionChoisi != Guid.Empty)
                    {
                        <div class="flex-1 min-w-56">
                            <label class="block text-slate-400 font-semibold mb-1">Nœud pair (même rôle, même environnement)</label>
                            <select class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-white" @bind="_pairChoisi" @bind:after="AppliquerReferencePair">
                                <option value="@Guid.Empty">Aucun</option>
                                @foreach (var p in _pairsDisponibles)
                                {
                                    <option value="@p.Id">@p.LogicalName</option>
                                }
                            </select>
                        </div>
                    }

                    var comparaisonSignaux = _referenceKindChoisi == ReferenceKind.ValeursHabituellesComposant ? _comparaisonHabituelle : _comparaisonPair;
                    @if (comparaisonSignaux is not null)
                    {
                        @if (comparaisonSignaux.IsIncomplete)
                        {
                            <div class="p-2.5 rounded-lg bg-amber-500/10 border border-amber-500/25 text-amber-300 text-[11px]">
                                <i class="bi bi-exclamation-triangle-fill"></i>
                                Historique insuffisant pour établir une référence fiable — ne pas s'y fier seul.
                            </div>
                        }
                        <p class="text-slate-400">@comparaisonSignaux.ReferenceLabel</p>

                        @if (comparaisonSignaux.Signals.Count == 0)
                        {
                            <div class="text-slate-500">Aucun signal comparable trouvé.</div>
                        }
                        else
                        {
                            <div class="table-wrap">
                                <table class="w-full text-[11px]">
                                    <thead>
                                        <tr class="text-slate-500 text-left">
                                            <th class="py-1 pr-3">Signal</th>
                                            <th class="py-1 pr-3">Référence</th>
                                            <th class="py-1 pr-3">Observé (incident)</th>
                                            <th class="py-1">Écart</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var sig in comparaisonSignaux.Signals)
                                        {
                                            <tr class="border-t border-slate-800">
                                                <td class="py-1 pr-3 text-slate-300">@sig.SignalType</td>
                                                <td class="py-1 pr-3 text-slate-400">@sig.ReferenceValue <span class="text-slate-600">(@sig.ReferenceSampleCount éch.)</span></td>
                                                <td class="py-1 pr-3 text-slate-300">@(sig.ObservedValue ?? "—")</td>
                                                <td class="py-1">
                                                    @if (sig.Differs)
                                                    {
                                                        <span class="text-amber-400"><i class="bi bi-exclamation-triangle-fill"></i> Diffère</span>
                                                    }
                                                    else if (sig.ObservedValue is not null)
                                                    {
                                                        <span class="text-emerald-400"><i class="bi bi-check-circle-fill"></i> Conforme</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                }
            </div>
        }

        <!-- Évolution temporelle (FR-073) -->
        @if (_histogramme.Count > 0)
        {
            var maxNombre = _histogramme.Max(h => h.Nombre);
            <div class="glass-card rounded-2xl border border-slate-800 p-5">
                <h3 class="text-sm font-bold text-white flex items-center gap-2 mb-1">
                    <i class="bi bi-bar-chart-fill text-sky-400"></i> Évolution temporelle
                </h3>
                <p class="text-[11px] text-slate-500 mb-3">
                    Première occurrence de chaque constat, par heure — jamais chaque répétition individuelle
                    (voir le regroupement des occurrences identiques).
                </p>
                <div class="flex items-end gap-1 h-24">
                    @foreach (var h in _histogramme)
                    {
                        <div class="flex-1 flex flex-col items-center justify-end gap-1" title="@($"{h.Heure.ToLocalTime():dd/MM HH'h'} — {h.Nombre} constat(s)")">
                            <div class="w-full bg-sky-500/60 rounded-t" style="height:@(Math.Max(4, h.Nombre * 100 / maxNombre))%"></div>
                            <div class="text-[9px] text-slate-600 font-mono">@h.Heure.ToLocalTime().ToString("HH'h'")</div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Chronologie multi-sources (FR-061) -->
        @if (_chronologie.Count > 0)
        {
            <div class="glass-card rounded-2xl border border-slate-800 overflow-hidden">
                <div class="p-5 border-b border-slate-800">
                    <h3 class="text-sm font-bold text-white flex items-center gap-2">
                        <i class="bi bi-clock-history text-sky-400"></i> Chronologie
                    </h3>
                    <p class="text-[11px] text-slate-500 mt-1">
                        Alignée sur l'écart d'horloge mesuré à la collecte de chaque source. Une entrée reste
                        marquée « incertaine » quand cet écart est inconnu ou significatif — l'ordre affiché
                        est alors probable, pas garanti.
                    </p>
                </div>
                <div class="divide-y divide-slate-800/60 text-xs">
                    @foreach (var t in _chronologie)
                    {
                        <div class="p-3 flex items-start gap-3">
                            <div class="font-mono text-slate-400 whitespace-nowrap">@t.AdjustedTime.ToLocalTime().ToString("HH:mm:ss")</div>
                            <div class="flex-1 min-w-0">
                                <div class="text-slate-200">
                                    <span class="font-semibold">@t.ComponentName</span> — @t.Title
                                </div>
                                @if (t.IsUncertain)
                                {
                                    <div class="text-[10px] text-amber-400 mt-0.5">
                                        <i class="bi bi-question-circle"></i>
                                        Ordre incertain
                                        @(t.ClockSkewSeconds is { } e ? $"— écart de {e:0.0} s mesuré à la collecte" : "— écart d'horloge non mesuré")
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Actions manuelles hors N4 Sentinel (§3.19) -->
        <div class="glass-card rounded-2xl border border-slate-800 overflow-hidden">
            <div class="p-5 border-b border-slate-800 flex items-center justify-between flex-wrap gap-2">
                <div>
                    <h3 class="text-sm font-bold text-white flex items-center gap-2">
                        <i class="bi bi-person-exclamation text-amber-400"></i> Actions manuelles hors N4 Sentinel
                    </h3>
                    <p class="text-[11px] text-slate-500 mt-1 max-w-2xl">
                        N4 Sentinel ne peut pas détecter une intervention directe sur un serveur (RDP, console,
                        script manuel). Déclarez-la ici pour qu'elle rejoigne la chronologie et le journal d'audit.
                    </p>
                </div>
                <AuthorizeView Policy="@N4Policies.PeutDiagnostiquer">
                    <button class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs transition"
                            @onclick="() => _declarationOuverte = !_declarationOuverte">
                        <i class="bi bi-plus-lg"></i> Déclarer
                    </button>
                </AuthorizeView>
            </div>

            @if (_declarationOuverte)
            {
                <div class="p-4 border-b border-slate-800 space-y-2 text-xs">
                    <textarea rows="2" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-white"
                              placeholder="Ce qui a été fait, sur quel composant, et pourquoi." @bind="_declarationTexte"></textarea>
                    <div class="flex items-center gap-2">
                        <input type="datetime-local" class="bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-white"
                               @bind="_declarationQuand" />
                        <button class="px-3 py-1.5 rounded-lg btn-theme-primary text-white font-bold text-xs transition" @onclick="DeclarerActionExterne">
                            Confirmer
                        </button>
                    </div>
                </div>
            }

            @if (_s.ExternalActions.Count == 0)
            {
                <div class="p-6 text-center text-slate-500 text-xs">Aucune action externe déclarée.</div>
            }
            else
            {
                <div class="divide-y divide-slate-800/60 text-xs">
                    @foreach (var a in _s.ExternalActions.OrderBy(a => a.OccurredAt))
                    {
                        <div class="p-3.5">
                            <div class="text-slate-200">@a.Description</div>
                            <div class="text-[10px] text-slate-500 mt-0.5">
                                @a.OccurredAt.ToLocalTime().ToString("dd/MM HH:mm") &middot; déclaré par @a.DeclaredBy
                                @if (a.ComponentName is { Length: > 0 })
                                {
                                    <span> &middot; @a.ComponentName</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Collecte -->
        <div class="glass-card rounded-2xl border border-slate-800 overflow-hidden">
            <div class="p-5 border-b border-slate-800">
                <h3 class="text-sm font-bold text-white flex items-center gap-2">
                    <i class="bi bi-journal-arrow-down text-sky-400"></i>
                    Journaux (@_s.Sources.Count)
                </h3>
                <p class="text-[11px] text-slate-500 mt-1 max-w-3xl leading-relaxed">
                    Le contenu des journaux <strong class="text-slate-400">n'est pas conservé</strong> :
                    seuls les constats le sont, avec leur ligne représentative et leur contexte, tous deux
                    masqués. La base de N4 Sentinel ne devient pas un second endroit où traînent les journaux
                    de production.
                </p>
            </div>

            <div class="p-5 space-y-4 text-xs">
                <div class="flex flex-wrap items-end gap-3">
                    <div class="flex-1 min-w-56">
                        <label class="block text-slate-400 font-semibold mb-1">Collecter le journal d'un composant</label>
                        <select class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-white" @bind="_composantId">
                            <option value="@Guid.Empty">Choisir un composant…</option>
                            @foreach (var c in _composants)
                            {
                                <option value="@c.Id">@c.LogicalName — @c.Role</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-slate-400 font-semibold mb-1">De (facultatif)</label>
                        <input type="datetime-local" title="À partir de"
                               class="bg-slate-900 border border-slate-700 text-white rounded-xl px-3 py-2 text-xs font-semibold"
                               @bind="_collecteDe" />
                    </div>
                    <div>
                        <label class="block text-slate-400 font-semibold mb-1">Jusqu'à (facultatif)</label>
                        <input type="datetime-local" title="Jusqu'à"
                               class="bg-slate-900 border border-slate-700 text-white rounded-xl px-3 py-2 text-xs font-semibold"
                               @bind="_collecteA" />
                    </div>
                    <button class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold transition disabled:opacity-40"
                            disabled="@(_composantId == Guid.Empty || _enCours)" @onclick="Collecter">
                        <i class="bi bi-download"></i> Collecter
                    </button>
                </div>

                <div class="pt-3 border-t border-slate-800">
                    <label class="block text-slate-400 font-semibold mb-1">
                        Ou verser un fichier
                    </label>
                    <div class="flex flex-wrap items-center gap-3">
                        <InputFile OnChange="Verser" accept=".log,.txt,.out,.zip" multiple disabled="@_enCours"
                                   class="text-slate-300 text-xs file:mr-3 file:px-3 file:py-1.5 file:rounded-lg file:border-0 file:bg-slate-800 file:text-slate-200 file:font-bold file:cursor-pointer disabled:opacity-40" />
                        <select class="bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-white" @bind="_composantImport">
                            <option value="@Guid.Empty">Composant non précisé</option>
                            @foreach (var c in _composants)
                            {
                                <option value="@c.Id">@c.LogicalName</option>
                            }
                        </select>
                    </div>
                    <p class="text-[10px] text-slate-500 mt-1">
                        Le chemin de repli quand le serveur est inaccessible — c'est-à-dire souvent,
                        en situation d'incident grave. 2 Mo au maximum sont analysés, en partant de la fin.
                    </p>
                </div>

                @if (_s.Sources.Count > 0)
                {
                    <div class="pt-3 border-t border-slate-800 overflow-x-auto">
                        <table class="w-full">
                            <thead class="text-slate-500 uppercase text-[10px] tracking-wider">
                                <tr>
                                    <th class="text-left py-2 font-bold">Fichier</th>
                                    <th class="text-left py-2 font-bold">Composant</th>
                                    <th class="text-left py-2 font-bold">Origine</th>
                                    <th class="text-right py-2 font-bold">Lignes</th>
                                    <th class="text-right py-2 font-bold">Secrets masqués</th>
                                    <th class="text-left py-2 font-bold pl-4">État</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-800">
                                @foreach (var src in _s.Sources)
                                {
                                    <tr>
                                        <td class="py-2 font-mono text-slate-300">@src.FileName</td>
                                        <td class="py-2 text-slate-400">
                                            @(src.ComponentName ?? "—")
                                            @if (src.ComponentAutoDetected)
                                            {
                                                <span class="ml-1 px-1.5 py-0.5 rounded text-[9px] font-bold bg-sky-500/15 text-sky-400" title="Identifié automatiquement depuis le nom du fichier (FR-071)">auto</span>
                                            }
                                            @* FR-071 : le contenu désigne un composant, mais rien n'est
                                               rattaché. C'est une question posée, pas une conclusion. *@
                                            @if (src.SuggestedComponentName is { Length: > 0 } sugg)
                                            {
                                                <span class="ml-1 px-1.5 py-0.5 rounded text-[9px] font-bold bg-violet-500/15 text-violet-300"
                                                      title="Le contenu du journal évoque ce composant. Rien n'est rattaché : à confirmer par un opérateur.">
                                                    ? @sugg
                                                </span>
                                            }
                                            else if (src.OriginAmbiguous)
                                            {
                                                <span class="ml-1 px-1.5 py-0.5 rounded text-[9px] font-bold bg-amber-500/15 text-amber-300"
                                                      title="Le contenu désigne plusieurs composants : aucune suggestion ne serait honnête.">
                                                    origine ambiguë
                                                </span>
                                            }
                                        </td>
                                        <td class="py-2 text-slate-400">
                                            @(src.Origin == LogOriginKind.CollecteCiblee ? "collecte" : "import")
                                        </td>
                                        <td class="py-2 text-right text-slate-300 font-mono">@src.LineCount</td>
                                        <td class="py-2 text-right font-mono @(src.MaskedSecretCount > 0 ? "text-amber-400" : "text-slate-500")">
                                            @src.MaskedSecretCount
                                        </td>
                                        <td class="py-2 pl-4">
                                            @if (!src.Succeeded)
                                            {
                                                <span class="text-rose-300">@src.Error</span>
                                                @if (src.FailureReason is { } motif)
                                                {
                                                    <span class="ml-1 px-1.5 py-0.5 rounded text-[9px] font-bold bg-rose-500/15 text-rose-300">@LibelleMotifEchec(motif)</span>
                                                }
                                            }
                                            else if (src.Truncated)
                                            {
                                                <span class="text-amber-400">fin de fichier seulement</span>
                                            }
                                            else
                                            {
                                                <span class="text-emerald-400">complet</span>
                                            }
                                        </td>
                                    </tr>
                                    @if (src.Succeeded && src.LineCount > 0)
                                    {
                                        <tr>
                                            <td colspan="6" class="pb-2.5 pt-0">
                                                <div class="text-[10px] text-slate-500 flex flex-wrap gap-x-4 gap-y-1">
                                                    @if (src.EarliestEntryAt is not null)
                                                    {
                                                        <span>
                                                            <i class="bi bi-calendar-range"></i>
                                                            @src.EarliestEntryAt.Value.ToLocalTime().ToString("dd/MM HH:mm:ss")
                                                            → @src.LatestEntryAt!.Value.ToLocalTime().ToString("dd/MM HH:mm:ss")
                                                        </span>
                                                    }
                                                    <span>@src.InfoCount info · @src.WarningCount avert. · @src.ErrorCount erreur(s)</span>
                                                    @if (src.DetectedVersion is { Length: > 0 } v)
                                                    {
                                                        <span>version @v (détectée)</span>
                                                    }
                                                    @if (src.DetectedLogType is { Length: > 0 } t)
                                                    {
                                                        <span><i class="bi bi-file-earmark-code"></i> @t</span>
                                                    }
                                                    @if (src.DetectedTimeZone is { Length: > 0 } tz)
                                                    {
                                                        <span><i class="bi bi-clock"></i> fuseau @tz (détecté)</span>
                                                    }
                                                    @if (src.CorrelationId is { Length: > 0 } corr)
                                                    {
                                                        <span title="Identifiant de corrélation"><i class="bi bi-link-45deg"></i> @corr</span>
                                                    }
                                                </div>
                                                @* FR-071 : montrer l'indice, pas seulement la conclusion —
                                                   l'opérateur doit pouvoir juger sur pièce. *@
                                                @if (src.SuggestionEvidence is { Length: > 0 } indice)
                                                {
                                                    <div class="mt-1 text-[10px] text-slate-500 italic">
                                                        <i class="bi bi-search"></i> Origine devinée d'après le contenu : @indice
                                                        <span class="not-italic text-slate-600">— non rattaché tant qu'un opérateur n'a pas confirmé.</span>
                                                    </div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- Hypothèses -->
        @if (_s.HasBeenAnalysed)
        {
            <div class="glass-card rounded-2xl border border-slate-800 overflow-hidden">
                <div class="p-5 border-b border-slate-800">
                    <h3 class="text-sm font-bold text-white flex items-center gap-2">
                        <i class="bi bi-lightbulb text-amber-400"></i> Hypothèses
                    </h3>
                    <p class="text-[11px] text-slate-500 mt-1">
                        Ce sont des hypothèses, présentées avec ce sur quoi elles reposent.
                        <strong class="text-slate-400">Elles peuvent être contestées.</strong>
                    </p>
                </div>

                @if (_s.Hypotheses.Count == 0)
                {
                    <div class="p-8 text-center text-slate-400 text-xs">
                        Aucune hypothèse n'a pu être retenue à partir de ce qui a été analysé.
                    </div>
                }
                else
                {
                <div class="divide-y divide-slate-800">
                    @foreach (var h in _s.Hypotheses.OrderBy(x => x.Rank))
                    {
                        <div class="p-5 space-y-2 text-xs">
                            <div class="flex items-start justify-between gap-3 flex-wrap">
                                <div class="font-bold text-white">
                                    @h.Rank. @LogAnalysisService.Libelle(h.Domain)
                                </div>
                                <div class="flex items-center gap-2 shrink-0">
                                    <div class="w-24 h-1.5 rounded-full bg-slate-800 overflow-hidden">
                                        <div class="h-full rounded-full @(h.EstEtablie(_seuilEtablie) ? "bg-emerald-500" : "bg-amber-500")"
                                             style="width:@h.Confidence%"></div>
                                    </div>
                                    <span class="font-mono text-[11px] @(h.EstEtablie(_seuilEtablie) ? "text-emerald-400" : "text-amber-400")">
                                        @h.Confidence %
                                    </span>
                                </div>
                            </div>

                            <p class="text-slate-200 leading-relaxed">@h.Statement</p>

                            @if (!h.EstEtablie(_seuilEtablie))
                            {
                                <p class="text-[11px] text-amber-300/80">
                                    Confiance insuffisante pour conclure : à traiter comme une piste.
                                </p>
                            }

                            <p class="text-slate-400"><strong>Sur quoi elle repose.</strong> @h.Evidence</p>

                            @if (h.CounterEvidence is { Length: > 0 })
                            {
                                <p class="text-slate-400"><strong>Ce qui la contredirait.</strong> @h.CounterEvidence</p>
                            }

                            <div class="flex flex-wrap gap-x-4 text-[10px] text-slate-600 font-mono">
                                @if (h.EvidenceObservedAt is not null)
                                {
                                    <span>dernière observation : @h.EvidenceObservedAt.Value.ToLocalTime().ToString("dd/MM HH:mm:ss")</span>
                                }
                                @if (h.RuleVersion is { Length: > 0 })
                                {
                                    <span>règle : @h.RuleVersion</span>
                                }
                            </div>

                            @if (h.Recommendation is { Length: > 0 })
                            {
                                <p class="text-slate-400"><strong>À vérifier.</strong> @h.Recommendation</p>
                            }
                        </div>
                    }
                </div>
                }
            </div>
        }

        <!-- SOP validés suggérés (FR-089D, AC-23) -->
        @if (_sopSuggeres.Count > 0)
        {
            <div class="glass-card rounded-2xl border border-slate-800 overflow-hidden">
                <div class="p-5 border-b border-slate-800">
                    <h3 class="text-sm font-bold text-white flex items-center gap-2">
                        <i class="bi bi-journal-check text-emerald-400"></i> Procédures déjà validées pour ce contexte
                    </h3>
                    <p class="text-[11px] text-slate-500 mt-1">
                        Rattachées à un composant ou une signature observés dans cette session (AC-23).
                    </p>
                </div>
                <div class="divide-y divide-slate-800">
                    @foreach (var (sop, stats) in _sopSuggeres.OrderByDescending(s => s.Stats.Total))
                    {
                        <a href="/sop/@sop.Id" class="block p-4 hover:bg-slate-800/40 transition text-xs">
                            <div class="flex items-center justify-between gap-3 flex-wrap">
                                <div class="font-bold text-white">@sop.Title <span class="text-slate-500 font-normal">v@sop.Version</span></div>
                                <div class="text-[11px] text-slate-400">
                                    @if (stats.Total == 0)
                                    {
                                        <span>Jamais encore exécuté</span>
                                    }
                                    else
                                    {
                                        <span class="text-emerald-400">@stats.Termine terminée(s)</span>
                                        @if (stats.Abandonne > 0)
                                        {
                                            <span class="text-rose-400 ml-2">@stats.Abandonne abandonnée(s)</span>
                                        }
                                        <span class="ml-2 text-slate-500">sur @stats.Total au total</span>
                                        @if (stats.SuccessRatePercent is { } taux)
                                        {
                                            <span class="ml-2 px-1.5 py-0.5 rounded bg-sky-500/10 text-sky-300 font-bold"
                                                  title="@($"{stats.OutcomesAttestes} résultat(s) attesté(s) par un opérateur — jamais déduit du seul fait que la procédure ait été suivie jusqu'au bout.")">
                                                @taux % de réussite attestée
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="ml-2 text-slate-600" title="Aucun opérateur n'a encore attesté du résultat réel d'une exécution de ce SOP.">
                                                taux de réussite non attesté
                                            </span>
                                        }
                                    }
                                </div>
                            </div>
                            <div class="text-slate-400 mt-1">@sop.Code — dernière modification le @((sop.ModifiedAt ?? sop.CreatedAt).ToLocalTime().ToString("dd/MM/yyyy"))</div>
                        </a>
                    }
                </div>
            </div>
        }

        <!-- Constats -->
        <div class="glass-card rounded-2xl border border-slate-800 overflow-hidden">
            <div class="p-5 border-b border-slate-800 flex items-center justify-between flex-wrap gap-2">
                <h3 class="text-sm font-bold text-white flex items-center gap-2">
                    <i class="bi bi-exclamation-diamond text-rose-400"></i> Constats (@_s.Findings.Count)
                </h3>

                @if (_s.Findings.Count > 0)
                {
                    <div class="flex flex-wrap items-center gap-2">
                        <select class="bg-slate-900 border border-slate-700 text-white rounded-lg px-2.5 py-1.5 text-xs font-semibold"
                                @bind="_filtreGravite">
                            <option value="-1">Toutes gravités</option>
                            <option value="3">Critique seulement</option>
                            <option value="2">Erreur et au-dessus</option>
                            <option value="1">Avertissement et au-dessus</option>
                        </select>
                        <select class="bg-slate-900 border border-slate-700 text-white rounded-lg px-2.5 py-1.5 text-xs font-semibold"
                                @bind="_filtreDomaineConstat">
                            <option value="-1">Tous domaines</option>
                            @foreach (var d in Enum.GetValues<DiagnosticDomain>())
                            {
                                <option value="@((int)d)">@LogAnalysisService.Libelle(d)</option>
                            }
                        </select>
                        <select class="bg-slate-900 border border-slate-700 text-white rounded-lg px-2.5 py-1.5 text-xs font-semibold"
                                @bind="_filtreComposantConstat">
                            <option value="">Tous composants</option>
                            @foreach (var nom in NomsComposantsVus())
                            {
                                <option value="@nom">@nom</option>
                            }
                        </select>
                        <input type="datetime-local" title="À partir de"
                               class="bg-slate-900 border border-slate-700 text-white rounded-lg px-2.5 py-1.5 text-xs font-semibold"
                               @bind="_filtreDe" />
                        <span class="text-slate-500">—</span>
                        <input type="datetime-local" title="Jusqu'à"
                               class="bg-slate-900 border border-slate-700 text-white rounded-lg px-2.5 py-1.5 text-xs font-semibold"
                               @bind="_filtreA" />
                        <select class="bg-slate-900 border border-slate-700 text-white rounded-lg px-2.5 py-1.5 text-xs font-semibold"
                                @bind="_filtreServeur">
                            <option value="">Tous serveurs</option>
                            @foreach (var srv in ServeursVus())
                            {
                                <option value="@srv">@srv</option>
                            }
                        </select>
                        <input type="text" placeholder="Code (ex. AMQ-CORRUPT)"
                               class="bg-slate-900 border border-slate-700 text-white rounded-lg px-2.5 py-1.5 text-xs font-semibold w-32"
                               @bind="_filtreCode" @bind:event="oninput" />
                        <input type="text" placeholder="Niveau (ex. ERROR)"
                               class="bg-slate-900 border border-slate-700 text-white rounded-lg px-2.5 py-1.5 text-xs font-semibold w-24"
                               @bind="_filtreNiveau" @bind:event="oninput" />
                        <input type="text" placeholder="Id. de corrélation"
                               class="bg-slate-900 border border-slate-700 text-white rounded-lg px-2.5 py-1.5 text-xs font-semibold w-40"
                               @bind="_filtreCorrelation" @bind:event="oninput" />
                        <input type="text" placeholder="Rechercher un texte..."
                               class="bg-slate-900 border border-slate-700 text-white rounded-lg px-2.5 py-1.5 text-xs font-semibold w-48"
                               @bind="_filtreTexte" @bind:event="oninput" />
                    </div>
                }
            </div>

            @if (_s.Findings.Count == 0)
            {
                <div class="p-8 text-center text-slate-400 text-xs">
                    Aucune anomalie relevée dans ce qui a été analysé.
                    @if (_s.Sources.Count == 0)
                    {
                        <text>Commencez par collecter ou verser un journal.</text>
                    }
                </div>
            }
            else
            {
                <div class="divide-y divide-slate-800">
                    @foreach (var f in _s.Findings
                        .Where(x => _filtreGravite < 0 || (int)x.Severity >= _filtreGravite)
                        .Where(x => _filtreDomaineConstat < 0 || (int)x.Domain == _filtreDomaineConstat)
                        .Where(x => string.IsNullOrEmpty(_filtreComposantConstat) || NomComposant(x) == _filtreComposantConstat)
                        .Where(x => _filtreDe is null || x.FirstSeenAt is null || x.FirstSeenAt >= new DateTimeOffset(_filtreDe.Value))
                        .Where(x => _filtreA is null || x.LastSeenAt is null || x.LastSeenAt <= new DateTimeOffset(_filtreA.Value))
                        .Where(x => string.IsNullOrEmpty(_filtreServeur) || ServeurConstat(x) == _filtreServeur)
                        .Where(x => string.IsNullOrEmpty(_filtreCode) || (x.SignatureCode ?? "").Contains(_filtreCode, StringComparison.OrdinalIgnoreCase) || (x.ErrorCode ?? "").Contains(_filtreCode, StringComparison.OrdinalIgnoreCase))
                        .Where(x => string.IsNullOrEmpty(_filtreNiveau) || (x.Level ?? "").Contains(_filtreNiveau, StringComparison.OrdinalIgnoreCase))
                        .Where(x => string.IsNullOrEmpty(_filtreCorrelation) || (CorrelationConstat(x) ?? "").Contains(_filtreCorrelation, StringComparison.OrdinalIgnoreCase))
                        .Where(x => string.IsNullOrEmpty(_filtreTexte)
                                 || x.Title.Contains(_filtreTexte, StringComparison.OrdinalIgnoreCase)
                                 || x.SampleLine.Contains(_filtreTexte, StringComparison.OrdinalIgnoreCase))
                        .OrderByDescending(x => x.Severity).ThenByDescending(x => x.OccurrenceCount))
                    {
                        <div class="p-5 space-y-2 text-xs">
                            <div class="flex items-start gap-3 flex-wrap">
                                <span class="px-2 py-0.5 rounded-md text-[10px] font-bold shrink-0 @PastilleGravite(f.Severity)">
                                    @f.Severity.ToString().ToUpperInvariant()
                                </span>
                                <span class="font-bold text-white flex-1 min-w-0">@f.Title</span>
                                <span class="text-slate-400 shrink-0">
                                    @f.OccurrenceCount occurrence@(f.OccurrenceCount > 1 ? "s" : "")
                                    &middot; ligne @f.FirstLineNumber
                                </span>
                            </div>

                            <div class="text-slate-500">
                                @LogAnalysisService.Libelle(f.Domain)
                                <span class="font-mono"> &middot; @NomComposant(f)</span>
                                @if (f.SignatureCode is { Length: > 0 })
                                {
                                    <span class="font-mono"> &middot; @f.SignatureCode</span>
                                }
                                else
                                {
                                    <span> &middot; non répertorié au catalogue</span>
                                }
                                @if (f.FirstSeenAt is not null)
                                {
                                    <span> &middot; de @f.FirstSeenAt.Value.ToString("HH:mm:ss") à @f.LastSeenAt?.ToString("HH:mm:ss")</span>
                                }
                            </div>

                            @if (f.ThreadName is not null || f.LoggerClass is not null || f.TransactionId is not null)
                            {
                                <div class="text-[10px] text-slate-600 font-mono flex flex-wrap gap-x-3">
                                    @if (f.ThreadName is not null)
                                    {
                                        <span>thread: @f.ThreadName</span>
                                    }
                                    @if (f.LoggerClass is not null)
                                    {
                                        <span>classe: @f.LoggerClass</span>
                                    }
                                    @if (f.TransactionId is not null)
                                    {
                                        <span>transaction: @f.TransactionId</span>
                                    }
                                </div>
                            }

                            @if (f.Meaning is { Length: > 0 })
                            {
                                <p class="text-slate-200 leading-relaxed">
                                    <strong class="text-white">Ce que cela signifie.</strong> @f.Meaning
                                </p>
                            }

                            @if (f.Remediation is { Length: > 0 })
                            {
                                <p class="text-slate-300 leading-relaxed">
                                    <strong class="text-white">Conduite à tenir.</strong> @f.Remediation
                                </p>
                            }

                            <details class="mt-2">
                                <summary class="cursor-pointer text-theme-primary hover:underline select-none">
                                    Voir le passage du journal
                                </summary>
                                <pre class="mt-2 p-3 rounded-xl bg-slate-950 border border-slate-800 text-[11px] text-slate-300 overflow-x-auto whitespace-pre">@(f.Context ?? f.SampleLine)</pre>
                            </details>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

