    /// <summary>FR-070 : un ou plusieurs fichiers, ou une archive — chacun scanné avant tout traitement.</summary>
    private const int NombreMaxFichiers = 20;

    private async Task Verser(InputFileChangeEventArgs e)
    {
        _enCours = true;
        _message = null;
        var composantChoisi = _composantImport == Guid.Empty ? (Guid?)null : _composantImport;
        var resultats = new List<(string Fichier, SourceResult Resultat)>();

        try
        {
            foreach (var fichier in e.GetMultipleFiles(NombreMaxFichiers))
            {
                using var tampon = new MemoryStream();
                await using (var flux = fichier.OpenReadStream(TailleMaximale))
                    await flux.CopyToAsync(tampon);

                var octets = tampon.ToArray();

                var scan = await Antivirus.ScanAsync(octets);
                if (scan.Verdict == ScanVerdict.Infecte)
                {
                    resultats.Add((fichier.Name, SourceResult.Failed(
                        $"Versement refusé : menace détectée par l'antivirus"
                        + (scan.ThreatName is { Length: > 0 } m ? $" ({m})" : ".") + ".")));
                    continue;
                }

                if (fichier.Name.EndsWith(".zip", StringComparison.OrdinalIgnoreCase))
                {
                    using var archive = new System.IO.Compression.ZipArchive(
                        new MemoryStream(octets), System.IO.Compression.ZipArchiveMode.Read);

                    foreach (var entree in archive.Entries.Where(en => en.Length > 0))
                    {
                        using var lecteurEntree = new StreamReader(entree.Open());
                        var contenuEntree = await lecteurEntree.ReadToEndAsync();
                        var rEntree = await Analyse.ImportAsync(Id, entree.Name, contenuEntree, composantChoisi,
                            _collecteDe is null ? null : new DateTimeOffset(_collecteDe.Value),
                            _collecteA is null ? null : new DateTimeOffset(_collecteA.Value));
                        resultats.Add((entree.Name, rEntree));
                    }
                    continue;
                }

                using var lecteur = new StreamReader(new MemoryStream(octets));
                var contenu = await lecteur.ReadToEndAsync();
                var r = await Analyse.ImportAsync(Id, fichier.Name, contenu, composantChoisi,
                    _collecteDe is null ? null : new DateTimeOffset(_collecteDe.Value),
                    _collecteA is null ? null : new DateTimeOffset(_collecteA.Value));
                resultats.Add((fichier.Name, r));
            }

            await Charger();
            SignalerLot(resultats);
        }
        catch (IOException)
        {
            Signaler(SourceResult.Failed(
                $"Fichier trop volumineux : {TailleMaximale / 1024 / 1024} Mo au maximum. "
                + "Extrayez la portion utile avant de la verser."));
        }
        finally
        {
            _enCours = false;
        }
    }

    private void SignalerLot(List<(string Fichier, SourceResult Resultat)> resultats)
    {
        if (resultats.Count == 0) { _message = "Aucun fichier exploitable dans l'archive."; _messageClass = "bg-rose-500/10 border-rose-500/20 text-rose-300"; return; }
        if (resultats.Count == 1) { Signaler(resultats[0].Resultat); return; }

        var reussis = resultats.Count(x => x.Resultat.Succeeded);
        var echecs = resultats.Where(x => !x.Resultat.Succeeded).ToList();

        _message = $"{reussis}/{resultats.Count} fichier(s) versé(s) avec succès."
                 + (echecs.Count > 0
                     ? $" En échec : {string.Join(", ", echecs.Select(x => $"{x.Fichier} ({x.Resultat.Error})"))}"
                     : string.Empty);
        _messageClass = echecs.Count == 0
            ? "bg-emerald-500/10 border-emerald-500/20 text-emerald-300"
            : "bg-amber-500/10 border-amber-500/20 text-amber-300";
    }

    private async Task Conclure()
    {
        _enCours = true;
        _analyseEnCours = true;
        _message = null;

        await Analyse.ConcludeAsync(Id);
        _enCours = false;
        _analyseEnCours = false;

        await Charger();
    }

