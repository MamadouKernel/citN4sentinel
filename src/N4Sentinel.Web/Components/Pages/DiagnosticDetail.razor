    // --- §3.10.1 : cycle en 8 phases ---------------------------------------
    private static readonly DiagnosticPhase[] _phases = Enum.GetValues<DiagnosticPhase>();
    private DiagnosticPhase _phaseChoisie;
    private string _phaseNote = string.Empty;
    private string _escaladeVers = string.Empty;
    private bool _enCoursPhase;

    protected override async Task OnParametersSetAsync()
    {
        await Charger();
        _seuilEtablie = (await DiagSettings.GetAsync()).HypothesisEstablishedThreshold;
        if (_s is not null)
        {
            _phaseChoisie = _s.Phase;
            _composants = await Referential.GetComponentsAsync(_s.EnvironmentId);
            _referencesDisponibles = (await Sessions.GetBaselineCandidatesAsync(_s.EnvironmentId))
                .Where(r => r.Id != _s.Id)
                .ToList();
            _referenceChoisie = _s.ReferenceSessionId ?? Guid.Empty;
            _chronologie = DiagnosticSessionService.BuildTimeline(_s);
            _histogramme = DiagnosticSessionService.BuildHourlyHistogram(_s);
            _comparaison = _s.ReferenceSessionId is not null
                ? await Sessions.CompareToReferenceAsync(_s.Id)
                : null;

            // --- FR-066 : 3 modes de comparaison supplémentaires -------------
            _referenceKindChoisi = _s.ReferenceKind;

            _composantsSession = await Sessions.GetSessionComponentsAsync(_s.Id);
            if (_composantSessionChoisi == Guid.Empty && _composantsSession.Count == 1)
                _composantSessionChoisi = _composantsSession[0].ComponentId;

            _executionsDisponibles = await Sessions.GetSuccessfulExecutionCandidatesAsync(_s.EnvironmentId);
            _executionChoisie = _s.ReferenceExecutionId ?? Guid.Empty;
            _comparaisonExecution = _s.ReferenceKind == ReferenceKind.ExecutionReussie && _s.ReferenceExecutionId is not null
                ? await Sessions.CompareToSuccessfulExecutionAsync(_s.Id)
                : null;

            _comparaisonHabituelle = _s.ReferenceKind == ReferenceKind.ValeursHabituellesComposant && _s.ReferenceComponentId is { } composantHabituelId
                ? await Sessions.CompareToUsualValuesAsync(_s.Id, composantHabituelId)
                : null;

            _pairChoisi = _s.ReferenceKind == ReferenceKind.NoeudPair ? (_s.ReferenceComponentId ?? Guid.Empty) : Guid.Empty;
            _pairsDisponibles = _composantSessionChoisi != Guid.Empty
                ? await Sessions.GetPeerCandidatesAsync(_composantSessionChoisi)
                : [];
            _comparaisonPair = _s.ReferenceKind == ReferenceKind.NoeudPair && _composantSessionChoisi != Guid.Empty && _s.ReferenceComponentId is { } pairId
                ? await Sessions.CompareToPeerNodeAsync(_s.Id, _composantSessionChoisi, pairId)
                : null;

            await ChargerSuggestionsSopAsync();
        }
    }

    /// <summary>
    /// Un incident en cours de diagnostic ressemble souvent à un incident déjà
    /// résolu — c'est exactement le scénario AC-23. On propose les SOP validés
    /// rattachés aux composants observés dans cette session, ou aux signatures
    /// déjà reconnues dans ses constats, avec leur historique d'utilisation
    /// réel (jamais un taux de réussite inventé).
    /// </summary>
    private async Task ChargerSuggestionsSopAsync()
    {
        var composantsVus = _s!.Sources.Select(s => s.ComponentId).Where(c => c is not null).Select(c => c!.Value).Distinct();
        var signaturesVues = _s.Findings.Select(f => f.SignatureId).Where(s => s is not null).Select(s => s!.Value).Distinct();

        var trouves = new Dictionary<Guid, Domain.Sop>();

        foreach (var composantId in composantsVus)
            foreach (var sop in await Sop.SuggestForReuseAsync(_s.EnvironmentId, componentId: composantId))
                trouves.TryAdd(sop.Id, sop);

        foreach (var signatureId in signaturesVues)
            foreach (var sop in await Sop.SuggestForReuseAsync(_s.EnvironmentId, signatureId: signatureId))
                trouves.TryAdd(sop.Id, sop);

        var resultats = new List<(Domain.Sop, SopUsageStats)>();
        foreach (var sop in trouves.Values)
            resultats.Add((sop, await Sop.GetUsageStatsAsync(sop.Id)));

        _sopSuggeres = resultats;
    }

