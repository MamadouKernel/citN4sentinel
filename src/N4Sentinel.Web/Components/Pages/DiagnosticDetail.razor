    /// <summary>
    /// Un constat n'a pas de composant en propre : il l'hérite de la source
    /// où il a été relevé (FR-077). Sans source retrouvée ou sans composant
    /// identifié sur celle-ci, on le dit tel quel plutôt que de l'omettre.
    /// </summary>
    private string NomComposant(LogFinding f) =>
        _s?.Sources.FirstOrDefault(src => src.Id == f.SourceId)?.ComponentName ?? "(composant non identifié)";

    private IEnumerable<string> NomsComposantsVus() =>
        _s is null
            ? []
            : _s.Sources.Select(s => s.ComponentName).Where(n => n is { Length: > 0 }).Distinct().OrderBy(n => n)!;

    /// <summary>FR-077 : serveur source d'un constat, hérité de la source où il a été relevé.</summary>
    private string? ServeurConstat(LogFinding f) =>
        _s?.Sources.FirstOrDefault(src => src.Id == f.SourceId)?.HostName;

    /// <summary>FR-077 : identifiant de corrélation hérité de la source où le constat a été relevé.</summary>
    private string? CorrelationConstat(LogFinding f) =>
        _s?.Sources.FirstOrDefault(src => src.Id == f.SourceId)?.CorrelationId;

    private IEnumerable<string> ServeursVus() =>
        _s is null
            ? []
            : _s.Sources.Select(s => s.HostName).Where(n => n is { Length: > 0 }).Distinct().OrderBy(n => n)!;
}
