@page "/alertes"
@using Microsoft.AspNetCore.Authorization
@using N4Sentinel.Domain
@using N4Sentinel.Infrastructure.Diagnostic
@using N4Sentinel.Infrastructure.Referential
@using N4Sentinel.Infrastructure.Supervision
@attribute [Authorize(Policy = N4Policies.PeutConsulter)]
@rendermode InteractiveServer
@inject AlertService Alerts
@inject DiagnosticSessionService Sessions
@inject ReferentialService Referential
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav

<PageTitle>Alertes — N4 Sentinel</PageTitle>

<div class="space-y-6">

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Alertes</h1>
            <p class="text-xs sm:text-sm text-slate-400 mt-1">
                Une condition, une alerte. Elle se referme d'elle-même dès que la condition cesse.
            </p>
        </div>

        <div class="flex items-center gap-3">
            <select class="bg-slate-900 border border-slate-700 text-white rounded-xl px-3 py-2 text-xs font-semibold focus:ring-2 focus:ring-sky-500 focus:outline-none"
                    @bind="_envId" @bind:after="Recharger">
                <option value="@Guid.Empty">Tous les environnements</option>
                @foreach (var e in _environnements)
                {
                    <option value="@e.Id">@e.Code — @e.Name</option>
                }
            </select>
            <button class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-sky-600 hover:bg-sky-500 text-white font-bold text-xs transition"
                    @onclick="Recharger">
                <i class="bi bi-arrow-clockwise"></i> Actualiser
            </button>
        </div>
    </div>

    <!-- Synthèse -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <div class="glass-card p-4 rounded-xl border border-rose-500/30 bg-rose-500/5">
            <div class="text-[10px] font-bold text-rose-400 uppercase tracking-wider mb-1">Critiques</div>
            <div class="text-xl font-extrabold text-rose-400">@_ouvertes.Count(a => a.Severity == AlertSeverity.Critique && a.Status == AlertStatus.Ouverte)</div>
        </div>
        <div class="glass-card p-4 rounded-xl border border-amber-500/30 bg-amber-500/5">
            <div class="text-[10px] font-bold text-amber-400 uppercase tracking-wider mb-1">Avertissements</div>
            <div class="text-xl font-extrabold text-amber-400">@_ouvertes.Count(a => a.Severity == AlertSeverity.Avertissement && a.Status == AlertStatus.Ouverte)</div>
        </div>
        <div class="glass-card p-4 rounded-xl border border-slate-700">
            <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">Acquittées</div>
            <div class="text-xl font-extrabold text-slate-300">@_ouvertes.Count(a => a.Status == AlertStatus.Acquittee)</div>
        </div>
        <div class="glass-card p-4 rounded-xl border border-emerald-500/30 bg-emerald-500/5">
            <div class="text-[10px] font-bold text-emerald-400 uppercase tracking-wider mb-1">Résolues récemment</div>
            <div class="text-xl font-extrabold text-emerald-400">@_resolues.Count</div>
        </div>
    </div>

    @if (_message is not null)
    {
        <div class="p-3.5 rounded-xl text-xs font-semibold border bg-emerald-500/10 text-emerald-300 border-emerald-500/20">@_message</div>
    }

    <!-- Alertes ouvertes -->
    @if (_ouvertes.Count == 0)
    {
        <div class="glass-card p-10 rounded-2xl border border-slate-800 text-center space-y-2">
            <i class="bi bi-shield-check text-4xl text-emerald-500/60 block"></i>
            <div class="text-sm font-bold text-white">Aucune alerte ouverte</div>
            <div class="text-xs text-slate-400 max-w-md mx-auto leading-relaxed">
                Aucune condition d'alerte n'est vraie en ce moment sur le périmètre supervisé.
                Cela ne signifie pas qu'aucun problème n'existe : seuls les composants déclarés,
                dans un environnement validé ou actif, sont observés.
            </div>
        </div>
    }
    else
    {
        <div class="space-y-2">
            @foreach (var a in _ouvertes)
            {
                <div class="glass-card rounded-2xl border p-5 @BordureGravite(a.Severity)">
                    <div class="flex items-start gap-4">
                        <div class="w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0 @PastilleGravite(a.Severity)">
                            <i class="bi @IconeKind(a.Kind)"></i>
                        </div>

                        <div class="flex-1 min-w-0 space-y-2">
                            <div class="flex items-start justify-between gap-3 flex-wrap">
                                <h3 class="text-sm font-bold text-white">@a.Title</h3>
                                <div class="flex items-center gap-2 flex-shrink-0">
                                    @if (a.Status == AlertStatus.Acquittee)
                                    {
                                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-700/50 text-slate-300 border border-slate-600">
                                            Acquittée
                                        </span>
                                    }
                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold @PastilleGravite(a.Severity)">@a.Severity</span>
                                </div>
                            </div>

                            <p class="text-xs text-slate-300">@a.Detail</p>

                            @if (a.Recommendation is not null)
                            {
                                <div class="p-2.5 rounded-lg bg-slate-900/60 border border-slate-800 text-[11px] text-slate-400 leading-relaxed">
                                    <span class="font-semibold text-slate-300">À vérifier — </span>@a.Recommendation
                                </div>
                            }

                            <div class="flex items-center gap-3 text-[10px] text-slate-500 font-mono flex-wrap">
                                <span>@a.ComponentName</span>
                                <span>&middot; depuis @Duree(a.Duration)</span>
                                <span>&middot; @a.OccurrenceCount observation(s)</span>
                                <span>&middot; vue @a.LastOccurredAt.ToLocalTime().ToString("HH:mm:ss")</span>
                            </div>

                            @if (a.Status == AlertStatus.Acquittee)
                            {
                                <div class="text-[11px] text-slate-500 italic">
                                    Acquittée par @a.AcknowledgedBy
                                    @if (!string.IsNullOrWhiteSpace(a.AcknowledgementNote))
                                    {
                                        <text> — « @a.AcknowledgementNote »</text>
                                    }
                                </div>
                            }
                        </div>

                        <div class="flex flex-col gap-1.5 flex-shrink-0">
                            @if (a.Status == AlertStatus.Ouverte)
                            {
                                <AuthorizeView Policy="@N4Policies.PeutDiagnostiquer" Context="acquittement">
                                    <button class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs transition whitespace-nowrap"
                                            @onclick="() => Ouvrir(a)">
                                        Acquitter
                                    </button>
                                </AuthorizeView>
                            }
                            <AuthorizeView Policy="@N4Policies.PeutDiagnostiquer" Context="diagnostic">
                                <button class="px-3 py-1.5 rounded-lg bg-sky-500/15 hover:bg-sky-500/25 text-sky-400 border border-sky-500/25 font-semibold text-xs transition whitespace-nowrap disabled:opacity-50"
                                        disabled="@(_idEnCoursDeDiagnostic == a.Id)"
                                        @onclick="() => DiagnostiquerAsync(a)">
                                    <i class="bi bi-search"></i>
                                    @(_idEnCoursDeDiagnostic == a.Id ? "Ouverture…" : "Diagnostiquer")
                                </button>
                            </AuthorizeView>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Acquittement -->
    @if (_aAcquitter is not null)
    {
        <div class="glass-card rounded-2xl border border-sky-500/30 p-6 space-y-4">
            <h3 class="text-sm font-bold text-white">Acquitter — @_aAcquitter.Title</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
                Acquitter n'est pas résoudre. L'alerte reste ouverte tant que sa condition dure ;
                elle sort simplement du décompte de ce qui réclame une attention. Elle se fermera
                d'elle-même quand la condition cessera.
            </p>
            <div>
                <label class="block text-xs font-semibold text-slate-300 mb-1.5">Motif</label>
                <input class="w-full bg-slate-950 border border-slate-700 rounded-xl px-4 py-2.5 text-xs text-white placeholder-slate-600 focus:ring-2 focus:ring-sky-500/50 focus:outline-none"
                       @bind="_motif" placeholder="Maintenance planifiée, coupure attendue jusqu'à 18 h" />
                <p class="text-[11px] text-slate-500 mt-1">
                    Ce motif est conservé et affiché aux autres opérateurs. Sans lui, personne ne saura
                    pourquoi cette alerte a été mise de côté.
                </p>
            </div>
            <div class="flex gap-2">
                <button class="px-4 py-2 rounded-xl bg-sky-600 hover:bg-sky-500 text-white font-bold text-xs transition"
                        @onclick="Acquitter">Confirmer l'acquittement</button>
                <button class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs transition"
                        @onclick="() => _aAcquitter = null">Annuler</button>
            </div>
        </div>
    }

    <!-- Résolues -->
    @if (_resolues.Count > 0)
    {
        <div class="glass-card rounded-2xl border border-slate-800 overflow-hidden">
            <div class="p-4 border-b border-slate-800">
                <h3 class="text-sm font-bold text-white flex items-center gap-2">
                    <i class="bi bi-check2-circle text-emerald-400"></i>
                    Résolues automatiquement (@_resolues.Count)
                </h3>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs text-slate-300">
                    <thead class="bg-slate-900/80 text-slate-400 text-[10px] uppercase tracking-wider border-b border-slate-800">
                        <tr>
                            <th class="py-2.5 px-4 font-bold">Composant</th>
                            <th class="py-2.5 px-4 font-bold">Alerte</th>
                            <th class="py-2.5 px-4 font-bold">Durée</th>
                            <th class="py-2.5 px-4 font-bold">Observations</th>
                            <th class="py-2.5 px-4 font-bold">Résolue</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-800/60">
                        @foreach (var a in _resolues)
                        {
                            <tr class="hover:bg-slate-800/40">
                                <td class="py-2.5 px-4 text-white">@a.ComponentName</td>
                                <td class="py-2.5 px-4 text-slate-400">@a.Title</td>
                                <td class="py-2.5 px-4 font-mono">@Duree(a.Duration)</td>
                                <td class="py-2.5 px-4 font-mono">@a.OccurrenceCount</td>
                                <td class="py-2.5 px-4 font-mono text-slate-400">@a.ResolvedAt?.ToLocalTime().ToString("dd/MM HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private List<N4Environment> _environnements = [];
    private List<Alert> _ouvertes = [];
    private List<Alert> _resolues = [];
    private Guid _envId = Guid.Empty;

    private Alert? _aAcquitter;
    private string _motif = "";
    private string? _message;
    private Guid? _idEnCoursDeDiagnostic;

    protected override async Task OnInitializedAsync()
    {
        _environnements = await Referential.GetEnvironmentsAsync();
        await Recharger();
    }

    private async Task Recharger()
    {
        Guid? filtre = _envId == Guid.Empty ? null : _envId;
        _ouvertes = await Alerts.GetOpenAsync(filtre);
        _resolues = await Alerts.GetRecentlyResolvedAsync(20);
    }

    private void Ouvrir(Alert a)
    {
        _aAcquitter = a;
        _motif = "";
        _message = null;
    }

    private async Task Acquitter()
    {
        if (_aAcquitter is null) return;

        var etat = await AuthProvider.GetAuthenticationStateAsync();
        var acteur = etat.User.Identity?.Name ?? "inconnu";

        await Alerts.AcknowledgeAsync(_aAcquitter.Id, acteur,
            string.IsNullOrWhiteSpace(_motif) ? null : _motif);

        _message = $"Alerte acquittée : {_aAcquitter.Title}";
        _aAcquitter = null;
        await Recharger();
    }

    /// <summary>FR-068 : ouvre un diagnostic pré-rempli et déjà collecté depuis cette alerte.</summary>
    private async Task DiagnostiquerAsync(Alert a)
    {
        _idEnCoursDeDiagnostic = a.Id;
        try
        {
            var etat = await AuthProvider.GetAuthenticationStateAsync();
            var acteur = etat.User.Identity?.Name ?? "inconnu";

            var resultat = await Sessions.CreateFromAlertAsync(a.Id, acteur);
            if (!resultat.Succeeded)
            {
                _message = resultat.Error;
                return;
            }

            Nav.NavigateTo($"/diagnostics/{resultat.SessionId}");
        }
        finally
        {
            _idEnCoursDeDiagnostic = null;
        }
    }

    private static string Duree(TimeSpan d) => d.TotalHours >= 1
        ? $"{(int)d.TotalHours} h {d.Minutes:00}"
        : d.TotalMinutes >= 1 ? $"{(int)d.TotalMinutes} min" : $"{d.Seconds} s";

    private static string BordureGravite(AlertSeverity s) => s switch
    {
        AlertSeverity.Critique => "border-rose-500/30",
        AlertSeverity.Avertissement => "border-amber-500/25",
        _ => "border-slate-800"
    };

    private static string PastilleGravite(AlertSeverity s) => s switch
    {
        AlertSeverity.Critique => "bg-rose-500/15 text-rose-400 border border-rose-500/25",
        AlertSeverity.Avertissement => "bg-amber-500/15 text-amber-400 border border-amber-500/25",
        _ => "bg-sky-500/15 text-sky-400 border border-sky-500/25"
    };

    private static string IconeKind(AlertKind k) => k switch
    {
        AlertKind.IncoherenceEtat => "bi-exclamation-diamond-fill",
        AlertKind.Indisponibilite => "bi-x-octagon-fill",
        AlertKind.CollecteImpossible => "bi-question-octagon-fill",
        AlertKind.PreuveIndisponible => "bi-file-earmark-x-fill",
        AlertKind.EcartHorloge => "bi-clock-history",
        AlertKind.RessourceCritique => "bi-hdd-fill",
        AlertKind.ConflitRoleActifCenter => "bi-front",
        AlertKind.NoeudLent => "bi-speedometer2",
        AlertKind.SynchronisationXpsRetardee => "bi-arrow-repeat",
        AlertKind.FichierEdiNonConsomme => "bi-file-earmark-arrow-up-fill",
        AlertKind.AucuneIntegrationEdiRecente => "bi-arrow-left-right",
        _ => "bi-hourglass-split"
    };
}
