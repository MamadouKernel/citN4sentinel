@page "/supervision"
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@using N4Sentinel.Domain
@using N4Sentinel.Infrastructure.Referential
@using N4Sentinel.Infrastructure.Supervision
@attribute [Authorize(Policy = N4Policies.PeutConsulter)]
@rendermode InteractiveServer

@inject SupervisionStateCache SupervisionCache
@* Nom volontairement distinct du composant : en C#, un membre ne peut pas
   porter le nom de son type englobant, et ce fichier genere la classe
   Supervision. *@
@inject SupervisionService SupervisionMoteur
@inject UndeclaredComponentScanner Scanner
@inject DatabaseHealthService DatabaseHealth
@inject SharedFolderHealthService SharedFolders
@inject ReferentialService Referential
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Supervision Temps Réel — N4 Sentinel</PageTitle>

<div class="space-y-6">
    <!-- Header Banner -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <div class="flex items-center gap-2">
                <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Supervision Temps Réel</h1>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold @BadgeClasses border flex items-center gap-1"
                      title="@(DerniereEvaluation is { } derniereMaj ? $"Dernière évaluation à {derniereMaj.ToLocalTime():HH:mm:ss}" : "Aucun composant évalué pour l'instant.")">
                    <span class="w-1.5 h-1.5 rounded-full @BadgeDotClasses"></span> @BadgeTexte
                </span>
            </div>
            <p class="text-xs sm:text-sm text-slate-400 mt-1">État réel des serveurs, services Windows et preuves d'initialisation dans les journaux applicatifs</p>
        </div>

        <!-- Filter & Refresh & View Switcher -->
        <div class="flex flex-wrap items-center gap-3">
            <!-- View Mode Switcher -->
            <div class="flex items-center p-1 rounded-xl bg-slate-900 border border-slate-800 text-xs">
                <button type="button" @onclick='() => _viewMode = "tableau"'
                        class="px-3 py-1.5 rounded-lg font-semibold transition @(_viewMode == "tableau" ? "bg-theme-gradient text-white shadow-sm" : "text-slate-400 hover:text-white")">
                    <i class="bi bi-table" aria-hidden="true"></i> Tableau
                </button>
                <button type="button" @onclick='() => _viewMode = "topologie"'
                        class="px-3 py-1.5 rounded-lg font-semibold transition @(_viewMode == "topologie" ? "bg-theme-gradient text-white shadow-sm" : "text-slate-400 hover:text-white")">
                    <i class="bi bi-diagram-3-fill" aria-hidden="true"></i> Schéma Topologique N4
                </button>
            </div>

            <select class="bg-slate-900 border border-slate-700 text-white rounded-xl px-3 py-2 text-xs font-semibold focus:ring-2 focus:ring-sky-500 focus:outline-none"
                    @bind="_selectedEnvCode" @bind:after="OnFilterChanged">
                <option value="">Tous les environnements</option>

                @if (_environnements is not null)
                {
                    @foreach (var env in _environnements)
                    {
                        <option value="@env.Code">@env.Code — @env.Name</option>
                    }
                }
            </select>

            <button @onclick="RefreshAllAsync" disabled="@_isRefreshing"
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-xl btn-theme-primary text-white font-bold text-xs transition disabled:opacity-50">
                <i class="bi bi-arrow-clockwise text-sm @(_isRefreshing ? "animate-spin" : "")" aria-hidden="true"></i>
                <span>Rafraîchir</span>
            </button>

            <button @onclick="OpenScanPanelAsync" disabled="@_isScanning"
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-700/80 text-slate-300 hover:text-white font-bold text-xs transition disabled:opacity-50">
                <i class="bi bi-search text-sm @(_isScanning ? "animate-spin" : "")" aria-hidden="true"></i>
                <span>Composants non déclarés</span>
            </button>

            <button @onclick="OpenReseauBasePanelAsync" disabled="@_dbEnCours"
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-700/80 text-slate-300 hover:text-white font-bold text-xs transition disabled:opacity-50">
                <i class="bi bi-hdd-network text-sm @(_dbEnCours ? "animate-spin" : "")" aria-hidden="true"></i>
                <span>Réseau &amp; Base</span>
            </button>

            <button @onclick="OpenDossiersPanelAsync" disabled="@_dossiersEnCours"
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-700/80 text-slate-300 hover:text-white font-bold text-xs transition disabled:opacity-50">
                <i class="bi bi-folder2-open text-sm @(_dossiersEnCours ? "animate-spin" : "")" aria-hidden="true"></i>
                <span>Dossiers partagés</span>
            </button>
        </div>
    </div>

    @if (_scanPanelOpen)
    {
        <!-- Découverte de composants non déclarés (SUP-06, AC-15) -->
        <div class="glass-card rounded-2xl border border-amber-500/30 overflow-hidden">
            <div class="p-4 border-b border-slate-800 flex items-center justify-between">
                <h3 class="text-sm font-bold text-white flex items-center gap-2">
                    <i class="bi bi-search text-amber-400" aria-hidden="true"></i>
                    Composants non déclarés
                </h3>
                <button @onclick="() => _scanPanelOpen = false" aria-label="Fermer" class="text-slate-400 hover:text-white text-xs">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </div>

            <div class="p-4 space-y-4">
                @if (string.IsNullOrWhiteSpace(_selectedEnvCode))
                {
                    <div class="text-xs text-slate-400">
                        Sélectionnez un environnement précis dans le filtre ci-dessus pour lancer une recherche —
                        cette action interroge chaque serveur de l'environnement.
                    </div>
                }
                else if (_isScanning)
                {
                    <div class="text-xs text-slate-400 flex items-center gap-2">
                        <i class="bi bi-arrow-clockwise animate-spin" aria-hidden="true"></i> Recherche en cours sur les serveurs de @_selectedEnvCode…
                    </div>
                }
                else if (_scanResult is not null)
                {
                    <div class="text-xs text-slate-400">
                        @_scanResult.ServersScanned serveur(s) interrogé(s)
                        @if (!_scanResult.IsComplete)
                        {
                            <span class="text-amber-400">— @_scanResult.Unreachable.Count injoignable(s)</span>
                        }
                    </div>

                    @if (_scanResult.Unreachable.Count > 0)
                    {
                        <div class="text-[11px] text-rose-400 space-y-1">
                            @foreach (var u in _scanResult.Unreachable)
                            {
                                <div><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> @u.HostName : @u.Reason</div>
                            }
                        </div>
                    }

                    @if (_scanResult.Undeclared.Count == 0)
                    {
                        @if (_scanResult.IsComplete)
                        {
                            <div class="text-xs text-emerald-400 flex items-center gap-2">
                                <i class="bi bi-check-circle-fill" aria-hidden="true"></i> Aucun composant non déclaré détecté.
                            </div>
                        }
                        else
                        {
                            <div class="text-xs text-amber-400 flex items-center gap-2">
                                <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                                Aucun composant non déclaré détecté sur les serveurs joignables — mais
                                @_scanResult.Unreachable.Count serveur(s) n'ont pas pu être interrogés
                                (ci-dessus) : le résultat est incomplet, pas une confirmation de propreté.
                            </div>
                        }
                    }
                    else
                    {
                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-xs text-slate-300">
                                <thead class="text-slate-400 text-[10px] uppercase tracking-wider border-b border-slate-800">
                                    <tr>
                                        <th class="py-2 pr-3 font-bold">Service</th>
                                        <th class="py-2 pr-3 font-bold">Serveur</th>
                                        <th class="py-2 pr-3 font-bold">Statut</th>
                                        <th class="py-2 pr-3 font-bold">Rôle à déclarer</th>
                                        <th class="py-2 pr-3 font-bold text-right">Action</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-800/60">
                                    @foreach (var u in _scanResult.Undeclared)
                                    {
                                        var cle = $"{u.HostName}::{u.ServiceName}";
                                        <tr>
                                            <td class="py-2.5 pr-3">
                                                <div class="font-bold text-white">@(u.DisplayName ?? u.ServiceName)</div>
                                                <div class="text-[10px] text-slate-500 font-mono">@u.ServiceName</div>
                                            </td>
                                            <td class="py-2.5 pr-3 font-mono">@u.HostName</td>
                                            <td class="py-2.5 pr-3">
                                                @if (u.IsRunning)
                                                {
                                                    <span class="text-emerald-400 font-semibold">@u.Status</span>
                                                }
                                                else
                                                {
                                                    <span class="text-slate-400">@u.Status</span>
                                                }
                                            </td>
                                            <td class="py-2.5 pr-3">
                                                <select class="bg-slate-900 border border-slate-700 text-white rounded-lg px-2 py-1 text-[11px] focus:ring-2 focus:ring-sky-500 focus:outline-none"
                                                        @bind:get="RoleChoisi(cle, u.SuggestedRole)" @bind:set="v => _rolesChoisis[cle] = v">
                                                    @foreach (var role in Enum.GetValues<ComponentRole>())
                                                    {
                                                        <option value="@role">@role</option>
                                                    }
                                                </select>
                                            </td>
                                            <td class="py-2.5 pr-3 text-right">
                                                <button @onclick="() => DeclareAsync(u, cle)"
                                                        class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-amber-500/20 hover:bg-amber-500/30 text-amber-400 font-semibold text-[11px] transition">
                                                    <i class="bi bi-plus-circle" aria-hidden="true"></i>
                                                    <span>Déclarer</span>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </div>
        </div>
    }

    @if (_dbPanelOpen)
    {
        <!-- Réseau et base (FR-057) -->
        <div class="glass-card rounded-2xl border border-slate-800 overflow-hidden">
            <div class="p-4 border-b border-slate-800 flex items-center justify-between">
                <h3 class="text-sm font-bold text-white flex items-center gap-2">
                    <i class="bi bi-hdd-network text-sky-400" aria-hidden="true"></i>
                    Réseau et base
                </h3>
                <button @onclick="() => _dbPanelOpen = false" aria-label="Fermer" class="text-slate-400 hover:text-white text-xs">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </div>

            <div class="p-4 space-y-4">
                @if (string.IsNullOrWhiteSpace(_selectedEnvCode))
                {
                    <div class="text-xs text-slate-400">
                        Sélectionnez un environnement précis dans le filtre ci-dessus.
                    </div>
                }
                else if (_dbEnCours)
                {
                    <div class="text-xs text-slate-400 flex items-center gap-2">
                        <i class="bi bi-arrow-clockwise animate-spin" aria-hidden="true"></i> Contrôle en cours…
                    </div>
                }
                else if (_dbResultats.Count == 0)
                {
                    <div class="text-xs text-slate-400">
                        Aucun composant de rôle Base de données déclaré dans cet environnement.
                    </div>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-xs text-slate-300">
                            <thead class="text-slate-400 text-[10px] uppercase tracking-wider border-b border-slate-800">
                                <tr>
                                    <th class="py-2 pr-3 font-bold">Base</th>
                                    <th class="py-2 pr-3 font-bold">Disponibilité</th>
                                    <th class="py-2 pr-3 font-bold">Latence</th>
                                    <th class="py-2 pr-3 font-bold">Requêtes lentes / bloquées</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-800/60">
                                @foreach (var r in _dbResultats)
                                {
                                    <tr>
                                        <td class="py-2.5 pr-3 font-bold text-white">@r.ComponentName</td>
                                        <td class="py-2.5 pr-3">
                                            @if (r.Reachable)
                                            {
                                                <span class="text-emerald-400 font-semibold"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> Disponible</span>
                                            }
                                            else
                                            {
                                                <span class="text-rose-400 font-semibold" title="@r.Error"><i class="bi bi-x-circle-fill" aria-hidden="true"></i> Indisponible</span>
                                            }
                                        </td>
                                        <td class="py-2.5 pr-3 font-mono">
                                            @(r.LatencyMs is { } ms ? $"{ms:0} ms" : "—")
                                        </td>
                                        <td class="py-2.5 pr-3">
                                            @if (!r.Reachable)
                                            {
                                                <span class="text-slate-500">—</span>
                                            }
                                            else if (r.QueryVisibilityDenied)
                                            {
                                                <span class="text-amber-400">Non visible (droit VIEW SERVER STATE absent)</span>
                                            }
                                            else if (r.SlowOrBlockedQueries.Count == 0)
                                            {
                                                <span class="text-emerald-400">Aucune</span>
                                            }
                                            else
                                            {
                                                <div class="space-y-1">
                                                    @foreach (var q in r.SlowOrBlockedQueries.Take(5))
                                                    {
                                                        <div class="@(q.IsBlocked ? "text-rose-400" : "text-amber-400")">
                                                            SPID @q.SessionId
                                                            @(q.IsBlocked ? $"bloqué par {q.BlockingSessionId}" : $"{q.ElapsedMs} ms")
                                                            @(q.WaitType is { Length: > 0 } w ? $" ({w})" : "")
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }

    @if (_dossiersPanelOpen)
    {
        <!-- Dossiers partagés (FR-059A à FR-059D) -->
        <div class="glass-card rounded-2xl border border-slate-800 overflow-hidden">
            <div class="p-4 border-b border-slate-800 flex items-center justify-between">
                <h3 class="text-sm font-bold text-white flex items-center gap-2">
                    <i class="bi bi-folder2-open text-teal-400" aria-hidden="true"></i>
                    Dossiers partagés
                </h3>
                <button @onclick="() => _dossiersPanelOpen = false" aria-label="Fermer" class="text-slate-400 hover:text-white text-xs">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </div>

            <div class="p-4 space-y-4">
                <p class="text-[11px] text-slate-500 leading-relaxed">
                    Un indice de corruption reste une SUSPICION, jamais une conclusion — voir le détail avant
                    d'agir. La classification en attente/consommé/bloqué/erreur n'apparaît que pour les dossiers
                    dont les sous-dossiers ont été déclarés sur la fiche du composant.
                </p>

                @if (_message is not null)
                {
                    <div class="p-2.5 rounded-lg text-[11px] font-semibold bg-rose-500/10 border border-rose-500/20 text-rose-300">
                        @_message
                    </div>
                }

                @if (string.IsNullOrWhiteSpace(_selectedEnvCode))
                {
                    <div class="text-xs text-slate-400">
                        Sélectionnez un environnement précis dans le filtre ci-dessus.
                    </div>
                }
                else if (_dossiersEnCours)
                {
                    <div class="text-xs text-slate-400 flex items-center gap-2">
                        <i class="bi bi-arrow-clockwise animate-spin" aria-hidden="true"></i> Contrôle en cours…
                    </div>
                }
                else if (_dossiersResultats.Count == 0)
                {
                    <div class="text-xs text-slate-400">
                        Aucun dossier partagé configuré dans cet environnement (chemin déclaré sur la fiche du composant).
                    </div>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-xs text-slate-300">
                            <thead class="text-slate-400 text-[10px] uppercase tracking-wider border-b border-slate-800">
                                <tr>
                                    <th class="py-2 pr-3 font-bold">Dossier</th>
                                    <th class="py-2 pr-3 font-bold">Catégorie</th>
                                    <th class="py-2 pr-3 font-bold">Accessibilité</th>
                                    <th class="py-2 pr-3 font-bold">Fichiers</th>
                                    <th class="py-2 pr-3 font-bold">Écriture</th>
                                    <th class="py-2 pr-3 font-bold">Indices</th>
                                    <th class="py-2 pr-3 font-bold">Sauvegarde</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-800/60">
                                @foreach (var (composant, dossierReleve) in _dossiersResultats)
                                {
                                    <tr>
                                        <td class="py-2.5 pr-3 font-bold text-white">@composant.LogicalName</td>
                                        <td class="py-2.5 pr-3">@LibelleCategorieDossier(composant.SharedFolder.Category)</td>
                                        <td class="py-2.5 pr-3">
                                            @if (dossierReleve.Reachable == true)
                                            {
                                                <span class="text-emerald-400 font-semibold"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> Accessible</span>
                                            }
                                            else if (dossierReleve.Reachable == false)
                                            {
                                                <span class="text-rose-400 font-semibold" title="@dossierReleve.UnreachableReason"><i class="bi bi-x-circle-fill" aria-hidden="true"></i> Inaccessible</span>
                                            }
                                            else
                                            {
                                                <span class="text-slate-500">Non mesuré</span>
                                            }
                                        </td>
                                        <td class="py-2.5 pr-3 font-mono">
                                            @(dossierReleve.Reachable == true ? $"{dossierReleve.TotalFileCount} ({FormaterTaille(dossierReleve.TotalSizeBytes)})" : "—")
                                            @if (dossierReleve.PendingCount is { } p)
                                            {
                                                <div class="text-[10px] text-slate-500">@p en attente</div>
                                            }
                                            @if (dossierReleve.GrowthBytesPerHour is { } croissance)
                                            {
                                                <div class="text-[10px] text-slate-500">@FormaterCroissance(croissance)</div>
                                            }
                                        </td>
                                        <td class="py-2.5 pr-3">
                                            @if (dossierReleve.CanWrite == true)
                                            {
                                                <span class="text-emerald-400">OK</span>
                                                @if (dossierReleve.WriteLatencyMs is { } latence)
                                                {
                                                    <div class="text-[10px] text-slate-500 font-mono">@latence.ToString("0") ms</div>
                                                }
                                            }
                                            else if (dossierReleve.CanWrite == false)
                                            {
                                                <span class="text-rose-400">Refusée</span>
                                            }
                                            else
                                            {
                                                <span class="text-slate-500">—</span>
                                            }
                                        </td>
                                        <td class="py-2.5 pr-3">
                                            @if (dossierReleve.SuspectedCorruption)
                                            {
                                                <div class="space-y-1">
                                                    <span class="px-2 py-0.5 rounded-md bg-amber-500/15 text-amber-300 text-[10px] font-bold">
                                                        SUSPICION — @dossierReleve.CorruptionIndicators.Count indice(s)
                                                    </span>
                                                    @foreach (var indice in dossierReleve.CorruptionIndicators)
                                                    {
                                                        <div class="text-[10px] text-slate-400">@indice</div>
                                                    }
                                                    <a href="/sop" class="text-[10px] text-sky-400 hover:underline">
                                                        Procédure de reconstitution guidée →
                                                    </a>
                                                </div>
                                            }
                                            else if (dossierReleve.HealthWarnings.Count == 0)
                                            {
                                                <span class="text-emerald-400">Aucun</span>
                                            }
                                            @if (dossierReleve.HealthWarnings.Count > 0)
                                            {
                                                <div class="space-y-1 mt-1">
                                                    @foreach (var avertissement in dossierReleve.HealthWarnings)
                                                    {
                                                        <div class="text-[10px] text-amber-300">@avertissement</div>
                                                    }
                                                </div>
                                            }
                                        </td>
                                        <td class="py-2.5 pr-3">
                                            @if (composant.SharedFolder.LastBackupAt is { } derniere)
                                            {
                                                <div class="text-[11px] text-slate-300">@derniere.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                                <div class="text-[10px] text-slate-500">par @composant.SharedFolder.LastBackupBy</div>
                                            }
                                            else
                                            {
                                                <span class="text-slate-500 text-[11px]">Jamais déclarée</span>
                                            }
                                            <button class="mt-1 text-[10px] text-sky-400 hover:underline"
                                                    @onclick="() => DeclarerSauvegarde(composant.Id)">
                                                <i class="bi bi-shield-check" aria-hidden="true"></i> Déclarer une sauvegarde
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Summary KPI Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
        <div class="glass-card p-4 rounded-xl border border-slate-800">
            <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">Total</div>
            <div class="text-xl font-extrabold text-white">@_summary.Total</div>
        </div>

        <div class="glass-card p-4 rounded-xl border border-emerald-500/30 bg-emerald-500/5">
            <div class="text-[10px] font-bold text-emerald-400 uppercase tracking-wider mb-1">Disponible</div>
            <div class="text-xl font-extrabold text-emerald-400">@_summary.Disponible</div>
        </div>

        <div class="glass-card p-4 rounded-xl border border-sky-500/30 bg-sky-500/5">
            <div class="text-[10px] font-bold text-sky-400 uppercase tracking-wider mb-1">Démarrage</div>
            <div class="text-xl font-extrabold text-sky-400">@_summary.Demarrage</div>
        </div>

        <div class="glass-card p-4 rounded-xl border border-amber-500/30 bg-amber-500/5">
            <div class="text-[10px] font-bold text-amber-400 uppercase tracking-wider mb-1">Dégradé</div>
            <div class="text-xl font-extrabold text-amber-400">@_summary.Degrade</div>
        </div>

        <div class="glass-card p-4 rounded-xl border border-rose-500/30 bg-rose-500/5">
            <div class="text-[10px] font-bold text-rose-400 uppercase tracking-wider mb-1">Indisponible</div>
            <div class="text-xl font-extrabold text-rose-400">@_summary.Indisponible</div>
        </div>

        <div class="glass-card p-4 rounded-xl border border-slate-700 bg-slate-800/20">
            <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">À l'arrêt</div>
            <div class="text-xl font-extrabold text-slate-300">@_summary.Arret</div>
        </div>
    </div>

    @if (_viewMode == "topologie")
    {
        <N4TopologyDiagram EnvironmentId="@_selectedEnvId" />
    }
    else
    {
        <!-- Main Components State Table -->
        <div class="glass-card rounded-2xl border border-slate-800 overflow-hidden">
            <div class="p-4 border-b border-slate-800 flex items-center justify-between">
                <h3 class="text-sm font-bold text-white flex items-center gap-2">
                    <i class="bi bi-activity text-sky-400" aria-hidden="true"></i>
                    Matrice des Composants
                </h3>
                <span class="text-xs text-slate-400">
                    Dernière évaluation : @(DerniereEvaluation is { } t ? t.ToLocalTime().ToString("HH:mm:ss") : "—")
                </span>
            </div>

        <div class="overflow-x-auto">
            @if (_snapshots.Count == 0)
            {
                <div class="p-12 text-center text-slate-400 text-xs space-y-3">
                    <i class="bi bi-hdd-network text-4xl text-slate-600 block" aria-hidden="true"></i>
                    <div>Aucune donnée de supervision disponible pour ce filtre.</div>
                    <div class="text-slate-500">Assurez-vous que l'environnement contient des composants et qu'il est activé.</div>
                </div>
            }
            else
            {
                <table class="w-full text-left text-xs text-slate-300">
                    <thead class="bg-slate-900/80 text-slate-400 text-[10px] uppercase tracking-wider border-b border-slate-800">
                        <tr>
                            <th class="py-3 px-4 font-bold">Composant & Rôle</th>
                            <th class="py-3 px-4 font-bold">Env</th>
                            <th class="py-3 px-4 font-bold">Serveur Hôte</th>
                            <th class="py-3 px-4 font-bold">État Consolidé</th>
                            <th class="py-3 px-4 font-bold">Service Windows</th>
                            <th class="py-3 px-4 font-bold">Preuve de Journal</th>
                            <th class="py-3 px-4 font-bold">Verdict</th>
                            <th class="py-3 px-4 font-bold text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-800/60">
                        @foreach (var snap in _snapshots)
                        {
                            <tr class="hover:bg-slate-800/40 transition">
                                <td class="py-3.5 px-4">
                                    <div class="font-bold text-white flex items-center gap-2">
                                        <span>@snap.LogicalName</span>
                                    </div>
                                    <div class="text-[10px] text-slate-400 font-mono mt-0.5">@snap.Role</div>
                                    @if (snap.Role is ComponentRole.CenterNode or ComponentRole.StandbyCenterNode)
                                    {
                                        <div class="text-[10px] mt-0.5">
                                            @switch (snap.HoldsActiveRole)
                                            {
                                                case true:
                                                    <span class="text-emerald-400 font-semibold"><i class="bi bi-star-fill" aria-hidden="true"></i> Rôle actif détenu</span>
                                                    break;
                                                case false:
                                                    <span class="text-slate-500">Rôle non détenu</span>
                                                    break;
                                                default:
                                                    <span class="text-slate-500">Rôle actif : à confirmer</span>
                                                    break;
                                            }
                                        </div>
                                    }
                                    @if (snap.Role is ComponentRole.BridgeDaemon or ComponentRole.Xps)
                                    {
                                        <div class="text-[10px] mt-0.5">
                                            @switch (snap.SyncDelayed)
                                            {
                                                case true:
                                                    <span class="text-rose-400 font-semibold" title="@(snap.LastSyncConfirmedAt is { } confirme ? $"Dernier échange confirmé le {confirme.ToLocalTime():dd/MM HH:mm}" : "Aucun échange confirmé")">
                                                        <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> Synchro N4-XPS en retard
                                                    </span>
                                                    break;
                                                case false:
                                                    <span class="text-emerald-400" title="@($"Dernier échange confirmé le {snap.LastSyncConfirmedAt!.Value.ToLocalTime():dd/MM HH:mm}")">
                                                        <i class="bi bi-arrow-repeat" aria-hidden="true"></i> Synchro N4-XPS à jour
                                                    </span>
                                                    break;
                                                default:
                                                    <span class="text-slate-500">Synchro N4-XPS : à confirmer</span>
                                                    break;
                                            }
                                        </div>
                                    }
                                </td>

                                <td class="py-3.5 px-4 font-mono font-bold text-slate-300">
                                    <span class="px-2 py-0.5 rounded text-[10px] bg-slate-800 border border-slate-700">@snap.EnvironmentCode</span>
                                </td>

                                <td class="py-3.5 px-4 font-mono text-slate-300">
                                    @snap.HostName
                                </td>

                                <td class="py-3.5 px-4 whitespace-nowrap">
                                    @switch (snap.State)
                                    {
                                        case ComponentState.Disponible:
                                            <span class="px-2.5 py-1 rounded-lg text-[11px] font-extrabold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 flex items-center gap-1.5 w-max">
                                                <i class="bi bi-check-circle-fill" aria-hidden="true"></i> Disponible
                                            </span>
                                            break;
                                        case ComponentState.Demarrage:
                                            <span class="px-2.5 py-1 rounded-lg text-[11px] font-extrabold bg-sky-500/20 text-sky-400 border border-sky-500/30 flex items-center gap-1.5 w-max animate-pulse">
                                                <i class="bi bi-hourglass-split" aria-hidden="true"></i> En Démarrage
                                            </span>
                                            break;
                                        case ComponentState.Degrade:
                                            <span class="px-2.5 py-1 rounded-lg text-[11px] font-extrabold bg-amber-500/20 text-amber-400 border border-amber-500/30 flex items-center gap-1.5 w-max">
                                                <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> Dégradé
                                            </span>
                                            break;
                                        case ComponentState.Indisponible:
                                            <span class="px-2.5 py-1 rounded-lg text-[11px] font-extrabold bg-rose-500/20 text-rose-400 border border-rose-500/30 flex items-center gap-1.5 w-max">
                                                <i class="bi bi-x-circle-fill" aria-hidden="true"></i> Indisponible
                                            </span>
                                            break;
                                        case ComponentState.Arret:
                                            <span class="px-2.5 py-1 rounded-lg text-[11px] font-extrabold bg-slate-800 text-slate-400 border border-slate-700 flex items-center gap-1.5 w-max">
                                                <i class="bi bi-stop-circle" aria-hidden="true"></i> À l'arrêt
                                            </span>
                                            break;
                                        case ComponentState.Maintenance:
                                            <span class="px-2.5 py-1 rounded-lg text-[11px] font-extrabold bg-violet-500/20 text-violet-400 border border-violet-500/30 flex items-center gap-1.5 w-max">
                                                <i class="bi bi-tools" aria-hidden="true"></i> Maintenance
                                            </span>
                                            break;
                                        default:
                                            <span class="px-2.5 py-1 rounded-lg text-[11px] font-bold bg-slate-800/80 text-slate-400 border border-slate-700/80">
                                                @snap.State
                                            </span>
                                            break;
                                    }
                                </td>

                                <td class="py-3.5 px-4">
                                    <div class="font-mono text-xs">@snap.ServiceStatus</div>
                                    @if (snap.ProcessId.HasValue)
                                    {
                                        <div class="text-[10px] text-slate-400 font-mono">PID: @snap.ProcessId</div>
                                    }
                                    @if (snap.ResponseTimeMs is { } ms)
                                    {
                                        <div class="text-[10px] font-mono @(ms > 5000 ? "text-amber-400 font-bold" : "text-slate-500")">
                                            <i class="bi bi-speedometer2" aria-hidden="true"></i> @ms.ToString("0") ms
                                        </div>
                                    }
                                </td>

                                <td class="py-3.5 px-4">
                                    @switch (snap.LogProofStatus)
                                    {
                                        case LogProofState.Proved:
                                            <span class="text-emerald-400 font-semibold text-[11px] flex items-center gap-1">
                                                <i class="bi bi-file-earmark-check-fill" aria-hidden="true"></i> Confirmé
                                            </span>
                                            break;
                                        case LogProofState.WaitingForProof:
                                            <span class="text-sky-400 font-semibold text-[11px] flex items-center gap-1">
                                                <i class="bi bi-clock-history" aria-hidden="true"></i> En attente du marqueur
                                            </span>
                                            break;
                                        case LogProofState.ErrorDetected:
                                            <span class="text-rose-400 font-semibold text-[11px] flex items-center gap-1">
                                                <i class="bi bi-file-earmark-x-fill" aria-hidden="true"></i> Erreur log détectée
                                            </span>
                                            break;
                                        default:
                                            <span class="text-slate-500 text-[11px]">À confirmer / N/A</span>
                                            break;
                                    }
                                </td>

                                <td class="py-3.5 px-4 max-w-xs truncate text-[11px] text-slate-300">
                                    @snap.Verdict
                                </td>

                                <td class="py-3.5 px-4 text-right whitespace-nowrap">
                                    <button @onclick="() => EvaluateSingleAsync(snap.ComponentId)"
                                            class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-sky-400 font-semibold text-[11px] transition">
                                        <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
                                        <span>Tester</span>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
    }
</div>

@code {
    private List<N4Environment>? _environnements;
    private string _selectedEnvCode = string.Empty;
    private Guid? _selectedEnvId = null;
    private string _viewMode = "topologie";
    private List<ComponentHealthSnapshot> _snapshots = [];
    private StateSummary _summary = new();
    private bool _isRefreshing = false;

    protected override async Task OnInitializedAsync()
    {
        _environnements = await Referential.GetEnvironmentsAsync();
        SupervisionCache.OnStateChanged += HandleStateChanged;
        LoadSnapshots();
    }

    private void HandleStateChanged()
    {
        InvokeAsync(() =>
        {
            LoadSnapshots();
            StateHasChanged();
        });
    }

    private async Task OnFilterChanged()
    {
        // _selectedEnvId alimente la vue Schéma Topologique : sans cette
        // ligne, le filtre de la vue Tableau et celui de la cartographie
        // divergent silencieusement (la cartographie retombe sur son propre
        // sélecteur interne).
        _selectedEnvId = string.IsNullOrWhiteSpace(_selectedEnvCode)
            ? null
            : _environnements?.FirstOrDefault(e => e.Code == _selectedEnvCode)?.Id;

        LoadSnapshots();

        // Le panneau de recherche affiche le resultat pour UN environnement :
        // en changer sans relancer laisserait voir le resultat de l'ancien
        // filtre sous le nouveau, silencieusement faux.
        if (_scanPanelOpen)
        {
            _scanResult = null;
            if (_selectedEnvId is { } envId)
                await LancerScanAsync(envId);
        }

        if (_dbPanelOpen)
        {
            _dbResultats = [];
            if (_selectedEnvId is { } envId)
                await LancerControleReseauBaseAsync(envId);
        }

        if (_dossiersPanelOpen)
        {
            _dossiersResultats = [];
            if (_selectedEnvId is { } envId)
                await LancerControleDossiersAsync(envId);
        }
    }

    private void LoadSnapshots()
    {
        _snapshots = string.IsNullOrWhiteSpace(_selectedEnvCode)
            ? SupervisionCache.GetAllSnapshots().ToList()
            : SupervisionCache.GetSnapshotsForEnvironment(_selectedEnvCode).ToList();

        _summary = SupervisionCache.GetSummary(_selectedEnvCode);
    }

    /// <summary>Horodatage réel du dernier relevé — jamais l'heure de rendu de la page.</summary>
    private DateTimeOffset? DerniereEvaluation =>
        _snapshots.Count == 0 ? null : _snapshots.Max(s => s.EvaluatedAt);

    /// <summary>
    /// « LIVE » n'est vrai que si un relevé a eu lieu récemment (le balayage
    /// de fond tourne toutes les 30 s) — jamais une affirmation statique.
    /// </summary>
    private bool EstEnDirect =>
        DerniereEvaluation is { } t && DateTimeOffset.UtcNow - t < TimeSpan.FromSeconds(90);

    private string BadgeTexte => _snapshots.Count == 0 ? "Aucune donnée" : EstEnDirect ? "LIVE" : "Figé";

    private string BadgeClasses => _snapshots.Count == 0
        ? "bg-slate-500/20 text-slate-400 border-slate-500/30"
        : EstEnDirect
            ? "bg-emerald-500/20 text-emerald-400 border-emerald-500/30"
            : "bg-amber-500/20 text-amber-400 border-amber-500/30";

    private string BadgeDotClasses => _snapshots.Count == 0
        ? "bg-slate-500"
        : EstEnDirect ? "bg-emerald-400 animate-pulse" : "bg-amber-400";

    private async Task RefreshAllAsync()
    {
        _isRefreshing = true;
        try
        {
            if (_environnements is not null)
            {
                foreach (var env in _environnements)
                {
                    var components = await Referential.GetComponentsAsync(env.Id);
                    foreach (var comp in components)
                    {
                        var precedent = SupervisionCache.GetSnapshot(comp.Id);
                        var snap = await SupervisionMoteur.EvaluateComponentAsync(comp.Id, previous: precedent);
                        SupervisionCache.UpdateSnapshot(snap);
                    }
                }
            }
        }
        finally
        {
            _isRefreshing = false;
            LoadSnapshots();
        }
    }

    private async Task EvaluateSingleAsync(Guid componentId)
    {
        var precedent = SupervisionCache.GetSnapshot(componentId);
        var snap = await SupervisionMoteur.EvaluateComponentAsync(componentId, previous: precedent);
        SupervisionCache.UpdateSnapshot(snap);
    }

    // -----------------------------------------------------------------------
    // Composants non déclarés (SUP-06, recette AC-15)
    // -----------------------------------------------------------------------
    private bool _scanPanelOpen;
    private bool _isScanning;
    private ScanResult? _scanResult;
    private readonly Dictionary<string, ComponentRole> _rolesChoisis = [];

    private ComponentRole RoleChoisi(string cle, ComponentRole suggestion) =>
        _rolesChoisis.TryGetValue(cle, out var role) ? role : suggestion;

    private async Task OpenScanPanelAsync()
    {
        _scanPanelOpen = true;
        if (_selectedEnvId is { } envId)
        {
            await LancerScanAsync(envId);
        }
    }

    private async Task LancerScanAsync(Guid envId)
    {
        _isScanning = true;
        _scanResult = null;
        _rolesChoisis.Clear();
        StateHasChanged();
        try
        {
            _scanResult = await Scanner.ScanAsync(envId);
        }
        finally
        {
            _isScanning = false;
        }
    }

    private async Task DeclareAsync(UndeclaredComponent decouvert, string cle)
    {
        if (_selectedEnvId is not { } envId) return;

        var role = RoleChoisi(cle, decouvert.SuggestedRole);
        await Scanner.DeclareAsync(envId, decouvert, role);

        // La fiche nait en Brouillon : on la retire de la liste des non
        // declares (elle est desormais connue du referentiel), sans relancer
        // tout le scan pour un seul element.
        _scanResult?.Undeclared.Remove(decouvert);
        _rolesChoisis.Remove(cle);
    }

    // -----------------------------------------------------------------------
    // Réseau et base (FR-057)
    // -----------------------------------------------------------------------
    private bool _dbPanelOpen;
    private bool _dbEnCours;
    private List<DatabaseHealthSnapshot> _dbResultats = [];

    private async Task OpenReseauBasePanelAsync()
    {
        _dbPanelOpen = true;
        if (_selectedEnvId is { } envId)
        {
            await LancerControleReseauBaseAsync(envId);
        }
    }

    private async Task LancerControleReseauBaseAsync(Guid envId)
    {
        _dbEnCours = true;
        _dbResultats = [];
        StateHasChanged();
        try
        {
            var composants = await Referential.GetComponentsAsync(envId);
            var resultats = new List<DatabaseHealthSnapshot>();
            foreach (var c in composants.Where(c => c.Role == ComponentRole.BaseDeDonnees))
            {
                resultats.Add(await DatabaseHealth.EvaluateAsync(c));
            }
            _dbResultats = resultats;
        }
        finally
        {
            _dbEnCours = false;
        }
    }

    // -----------------------------------------------------------------------
    // Dossiers partagés (FR-059A à FR-059D)
    // -----------------------------------------------------------------------
    private bool _dossiersPanelOpen;
    private bool _dossiersEnCours;
    private List<(N4Component Composant, SharedFolderSnapshot Releve)> _dossiersResultats = [];
    private string? _message;

    private async Task OpenDossiersPanelAsync()
    {
        _dossiersPanelOpen = true;
        if (_selectedEnvId is { } envId)
        {
            await LancerControleDossiersAsync(envId);
        }
    }

    private async Task LancerControleDossiersAsync(Guid envId)
    {
        _dossiersEnCours = true;
        _dossiersResultats = [];
        StateHasChanged();
        try
        {
            var composants = await Referential.GetComponentsAsync(envId);
            var resultats = new List<(N4Component, SharedFolderSnapshot)>();
            foreach (var c in composants.Where(c => c.SharedFolder.IsConfigured))
            {
                resultats.Add((c, await SharedFolders.EvaluateAsync(c)));
            }
            _dossiersResultats = resultats;
        }
        finally
        {
            _dossiersEnCours = false;
        }
    }

    private async Task DeclarerSauvegarde(Guid composantId)
    {
        var etat = await AuthProvider.GetAuthenticationStateAsync();
        var acteur = etat.User.Identity?.Name ?? "inconnu";

        var erreur = await SharedFolders.DeclareBackupAsync(composantId, acteur, null);
        if (erreur is not null)
        {
            _message = erreur;
            return;
        }

        if (_selectedEnvId is { } envId)
            await LancerControleDossiersAsync(envId);
    }

    private static string LibelleCategorieDossier(SharedFolderCategory c) => c switch
    {
        SharedFolderCategory.ConfigurationN4 => "Configuration N4",
        SharedFolderCategory.ActiveMqKahaDb => "ActiveMQ / KahaDB",
        SharedFolderCategory.EchangeEdi => "Échange EDI",
        SharedFolderCategory.Archives => "Archives",
        SharedFolderCategory.DossiersErreur => "Dossier d'erreur",
        _ => "Autre"
    };

    private static string FormaterTaille(long octets)
    {
        double v = octets;
        string[] unites = ["o", "Ko", "Mo", "Go", "To"];
        var i = 0;
        while (v >= 1024 && i < unites.Length - 1) { v /= 1024; i++; }
        return $"{v:0.#} {unites[i]}";
    }

    private static string FormaterCroissance(double octetsParHeure)
    {
        var signe = octetsParHeure >= 0 ? "+" : "-";
        return $"{signe}{FormaterTaille((long)Math.Abs(octetsParHeure))}/h";
    }

    public void Dispose()
    {
        SupervisionCache.OnStateChanged -= HandleStateChanged;
    }
}
