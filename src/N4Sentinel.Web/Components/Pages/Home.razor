@page "/"
@using Microsoft.AspNetCore.Authorization
@using N4Sentinel.Domain
@using N4Sentinel.Infrastructure.Referential
@attribute [Authorize(Policy = N4Policies.PeutConsulter)]
@rendermode InteractiveServer
@inject ReferentialService Referential
@inject NavigationManager Nav

<PageTitle>Tableau de bord — N4 Sentinel</PageTitle>

<div class="space-y-8">
    <!-- Header Banner -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Tableau de bord N4</h1>
            <p class="text-xs sm:text-sm text-slate-400 mt-1">Supervision globale et état du référentiel Navis N4 &middot; Côte d'Ivoire Terminal</p>
        </div>
        <div>
            <a href="/admin/environnements" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-sky-600 hover:bg-sky-500 text-white font-bold text-xs shadow-lg shadow-sky-600/25 transition">
                <i class="bi bi-hdd-stack-fill text-sm"></i>
                <span>Gérer les environnements</span>
            </a>
        </div>
    </div>

    <!-- KPI Summary Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="glass-card p-5 rounded-2xl border border-slate-800 flex items-center gap-4 hover:border-slate-700 transition">
            <div class="w-12 h-12 rounded-xl bg-sky-500/10 text-sky-400 flex items-center justify-center text-xl font-bold border border-sky-500/20 flex-shrink-0">
                <i class="bi bi-hdd-network-fill"></i>
            </div>
            <div>
                <div class="text-2xl font-extrabold text-white tracking-tight">@(_environnements?.Count ?? 0)</div>
                <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Environnements</div>
            </div>
        </div>

        <div class="glass-card p-5 rounded-2xl border border-slate-800 flex items-center gap-4 hover:border-slate-700 transition">
            <div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center text-xl font-bold border border-emerald-500/20 flex-shrink-0">
                <i class="bi bi-server"></i>
            </div>
            <div>
                <div class="text-2xl font-extrabold text-white tracking-tight">@_totalServeurs</div>
                <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Serveurs Nœuds</div>
            </div>
        </div>

        <div class="glass-card p-5 rounded-2xl border border-slate-800 flex items-center gap-4 hover:border-slate-700 transition">
            <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center text-xl font-bold border border-amber-500/20 flex-shrink-0">
                <i class="bi bi-cpu-fill"></i>
            </div>
            <div>
                <div class="text-2xl font-extrabold text-white tracking-tight">@_totalComposants</div>
                <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Composants N4</div>
            </div>
        </div>

        <div class="glass-card p-5 rounded-2xl border border-slate-800 flex items-center gap-4 hover:border-slate-700 transition">
            <div class="w-12 h-12 rounded-xl bg-purple-500/10 text-purple-400 flex items-center justify-center text-xl font-bold border border-purple-500/20 flex-shrink-0">
                <i class="bi bi-shield-check"></i>
            </div>
            <div>
                <div class="text-2xl font-extrabold text-white tracking-tight">100%</div>
                <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Audit & Traçabilité</div>
            </div>
        </div>
    </div>

    <!-- Main Grid Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Environments Table Card -->
        <div class="lg:col-span-2 glass-card rounded-2xl border border-slate-800 overflow-hidden flex flex-col">
            <div class="p-5 border-b border-slate-800 flex items-center justify-between">
                <h3 class="text-sm font-bold text-white flex items-center gap-2">
                    <i class="bi bi-diagram-3-fill text-sky-400"></i>
                    Cartographie des Environnements
                </h3>
                <a href="/admin/environnements" class="text-xs text-sky-400 hover:text-sky-300 font-semibold transition">Explorer tout &rarr;</a>
            </div>

            <div class="p-0 flex-1 overflow-x-auto">
                @if (_environnements is null)
                {
                    <div class="p-8 text-center text-slate-400 text-xs">
                        <div class="inline-block w-5 h-5 border-2 border-sky-500 border-t-transparent rounded-full animate-spin mb-2"></div>
                        <div>Chargement du référentiel...</div>
                    </div>
                }
                else if (_environnements.Count == 0)
                {
                    <div class="p-8 text-center text-slate-400 text-xs space-y-3">
                        <i class="bi bi-inbox text-3xl text-slate-600 block"></i>
                        <div>Aucun environnement déclaré dans le référentiel.</div>
                        <a href="/admin/environnements" class="inline-block px-3 py-1.5 rounded-lg bg-sky-600 text-white font-semibold text-xs">Créer un environnement</a>
                    </div>
                }
                else
                {
                    <table class="w-full text-left text-xs text-slate-300">
                        <thead class="bg-slate-900/60 text-slate-400 text-[10px] uppercase tracking-wider border-b border-slate-800">
                            <tr>
                                <th class="py-3 px-4 font-bold">Code</th>
                                <th class="py-3 px-4 font-bold">Nom</th>
                                <th class="py-3 px-4 font-bold">Statut</th>
                                <th class="py-3 px-4 font-bold">Éléments</th>
                                <th class="py-3 px-4 font-bold text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-800/60">
                            @foreach (var env in _environnements)
                            {
                                <tr class="hover:bg-slate-800/40 transition">
                                    <td class="py-3.5 px-4 font-mono font-bold text-white whitespace-nowrap">
                                        <div class="flex items-center gap-2">
                                            <span>@env.Code</span>
                                            @if (env.IsProduction)
                                            {
                                                <span class="px-1.5 py-0.5 rounded text-[9px] font-extrabold bg-rose-500/20 text-rose-400 border border-rose-500/30">PROD</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="py-3.5 px-4">
                                        <div class="font-semibold text-slate-200">@env.Name</div>
                                    </td>
                                    <td class="py-3.5 px-4 whitespace-nowrap">
                                        <StatutBadge Statut="env.Status" />
                                    </td>
                                    <td class="py-3.5 px-4 whitespace-nowrap">
                                        <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-slate-800 text-slate-300 border border-slate-700">
                                            @(_compteursComposants.TryGetValue(env.Id, out var n) ? n : 0) composants
                                        </span>
                                    </td>
                                    <td class="py-3.5 px-4 text-right whitespace-nowrap">
                                        <a href="@($"/admin/environnements/{env.Id}")" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-sky-400 font-semibold text-[11px] transition">
                                            <span>Ouvrir</span>
                                            <i class="bi bi-chevron-right text-[9px]"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

        <!-- Recent Audit Feed Card -->
        <div class="glass-card rounded-2xl border border-slate-800 overflow-hidden flex flex-col">
            <div class="p-5 border-b border-slate-800 flex items-center justify-between">
                <h3 class="text-sm font-bold text-white flex items-center gap-2">
                    <i class="bi bi-clock-history text-amber-400"></i>
                    Activité d'Audit Récente
                </h3>
                <a href="/admin/audit" class="text-xs text-sky-400 hover:text-sky-300 font-semibold transition">Journal &rarr;</a>
            </div>

            <div class="p-4 flex-1 overflow-y-auto space-y-3">
                @if (_auditRecent is null)
                {
                    <div class="text-center text-slate-400 text-xs py-4">Chargement...</div>
                }
                else if (_auditRecent.Count == 0)
                {
                    <div class="text-center text-slate-500 text-xs py-8 space-y-2">
                        <i class="bi bi-shield-check text-2xl"></i>
                        <div>Aucune entrée récente.</div>
                    </div>
                }
                else
                {
                    @foreach (var entry in _auditRecent.Take(5))
                    {
                        <div class="p-3 rounded-xl bg-slate-900/60 border border-slate-800/80 flex items-start gap-3">
                            <div class="w-7 h-7 rounded-lg bg-sky-500/10 text-sky-400 flex items-center justify-center text-xs flex-shrink-0 mt-0.5 border border-sky-500/20">
                                <i class="bi bi-activity"></i>
                            </div>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center justify-between gap-2">
                                    <span class="text-xs font-bold text-white truncate">@entry.EntityLabel</span>
                                    <span class="text-[10px] font-mono text-slate-500">@entry.OccurredAt.ToLocalTime().ToString("HH:mm")</span>
                                </div>
                                <div class="text-[11px] text-slate-400 truncate mt-0.5">
                                    @entry.Actor &middot; <span class="text-slate-300 font-semibold">@entry.Action</span>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@code {
    private List<N4Environment>? _environnements;
    private Dictionary<Guid, int> _compteursComposants = [];
    private List<AuditEntry>? _auditRecent;
    private int _totalServeurs = 0;
    private int _totalComposants = 0;

    protected override async Task OnInitializedAsync()
    {
        _environnements = await Referential.GetEnvironmentsAsync();
        _compteursComposants = [];
        _totalServeurs = 0;
        _totalComposants = 0;

        if (_environnements is not null)
        {
            foreach (var env in _environnements)
            {
                var count = await Referential.CountComponentsAsync(env.Id);
                _compteursComposants[env.Id] = count;
                _totalComposants += count;

                var servers = await Referential.GetServersAsync(env.Id);
                _totalServeurs += servers.Count;
            }
        }

        _auditRecent = await Referential.GetAuditEntriesAsync(null, 5);
    }
}
