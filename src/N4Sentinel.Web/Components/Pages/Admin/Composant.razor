@page "/admin/composants/{Id:guid}"
@using Microsoft.AspNetCore.Authorization
@using N4Sentinel.Domain
@using N4Sentinel.Infrastructure.Orchestration
@using N4Sentinel.Infrastructure.Referential
@attribute [Authorize(Policy = N4Policies.PeutAdministrerReferentiel)]
@rendermode InteractiveServer
@inject ReferentialService Referential
@inject SequenceValidator Validator
@inject NavigationManager Nav

<PageTitle>@(_c?.LogicalName ?? "Composant") — N4 Sentinel</PageTitle>

@if (_c is null)
{
    <div class="glass-card p-8 rounded-2xl border border-slate-800 text-center text-slate-400 text-xs">
        <div class="inline-block w-6 h-6 border-2 border-sky-500 border-t-transparent rounded-full animate-spin mb-2"></div>
        <div>Chargement du composant...</div>
    </div>
}
else
{
    <div class="space-y-6">
        <div>
            <a href="@($"/admin/environnements/{_c.EnvironmentId}")" class="text-xs text-theme-primary hover:underline transition flex items-center gap-1 mb-1">
                <i class="bi bi-arrow-left"></i> Retour à @_c.Environment?.Code
            </a>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">@_c.LogicalName</h1>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Left Column: Component Identification -->
            <div class="glass-card rounded-2xl border border-slate-800 p-6 space-y-4">
                <h3 class="text-sm font-bold text-white flex items-center gap-2 border-b border-slate-800 pb-3">
                    <i class="bi bi-card-heading text-theme-primary"></i>
                    Identification & Paramètres
                </h3>

                <div class="space-y-4 text-xs">
                    <div>
                        <label class="block font-semibold text-slate-300 mb-1">Nom logique</label>
                        <input class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-xs text-white focus:ring-2 focus:ring-sky-500/50 focus:outline-none" @bind="_c.LogicalName" />
                    </div>

                    <div>
                        <label class="block font-semibold text-slate-300 mb-1">Rôle N4</label>
                        <select class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-xs text-white focus:ring-2 focus:ring-sky-500/50 focus:outline-none" @bind="_c.Role">
                            @foreach (var r in Enum.GetValues<ComponentRole>())
                            {
                                <option value="@r">@r</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="block font-semibold text-slate-300 mb-1">Nom du service Windows</label>
                        <input class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-xs font-mono text-white placeholder-slate-500 focus:ring-2 focus:ring-sky-500/50 focus:outline-none" @bind="_c.WindowsServiceName" placeholder="Navis N4 Cluster Node" />
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block font-semibold text-slate-300 mb-1">Port applicatif</label>
                            <input type="number" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2 text-xs font-mono text-white focus:ring-2 focus:ring-sky-500/50 focus:outline-none" @bind="_c.Port" />
                        </div>
                        <div>
                            <label class="block font-semibold text-slate-300 mb-1">Ordre de démarrage</label>
                            <input type="number" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2 text-xs font-mono text-white focus:ring-2 focus:ring-sky-500/50 focus:outline-none" @bind="_c.StartOrder" />
                        </div>
                        <div>
                            <label class="block font-semibold text-slate-300 mb-1">Criticité</label>
                            <select class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2 text-xs text-white focus:ring-2 focus:ring-sky-500/50 focus:outline-none" @bind="_c.Criticality">
                                @foreach (var v in Enum.GetValues<CriticalityLevel>())
                                {
                                    <option value="@v">@v</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="block font-semibold text-slate-300 mb-1">Mode de pilotage</label>
                            <select class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2 text-xs text-white focus:ring-2 focus:ring-sky-500/50 focus:outline-none" @bind="_c.ControlMode">
                                @foreach (var v in Enum.GetValues<ControlMode>())
                                {
                                    <option value="@v">@v</option>
                                }
                            </select>
                        </div>
                        <div class="col-span-2">
                            <label class="block font-semibold text-slate-300 mb-1">Statut du composant</label>
                            <select class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2 text-xs text-white focus:ring-2 focus:ring-sky-500/50 focus:outline-none" @bind="_c.Status">
                                @foreach (var v in Enum.GetValues<LifecycleStatus>())
                                {
                                    <option value="@v">@v</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Readiness Probe Proofs -->
            <div class="glass-card rounded-2xl border border-slate-800 p-6 space-y-4">
                <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                    <h3 class="text-sm font-bold text-white flex items-center gap-2">
                        <i class="bi bi-file-earmark-text-fill text-amber-400"></i>
                        Preuve de Démarrage (Readiness Probe)
                    </h3>
                    @if (_c.Readiness.IsProvable)
                    {
                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">Exploitable</span>
                    }
                    else
                    {
                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-500/10 text-amber-400 border border-amber-500/20">Incomplète</span>
                    }
                </div>

                <div class="space-y-4 text-xs">
                    <div>
                        <label class="block font-semibold text-slate-300 mb-1">Chemin du journal applicatif</label>
                        <input class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2 text-xs font-mono text-white placeholder-slate-500 focus:ring-2 focus:ring-sky-500/50 focus:outline-none" @bind="_c.Readiness.LogPath" placeholder="C:\ProgramData\Navis\*\logs\navis-apex.log" />
                    </div>

                    <div>
                        <div class="flex items-center justify-between mb-1 gap-2 flex-wrap">
                            <label class="block font-semibold text-slate-300">Marqueurs Regex de démarrage réussi</label>
                            <a href="@($"/admin/composants/{Id}/marqueurs")"
                               class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 border border-amber-500/25 font-semibold text-[11px] transition whitespace-nowrap">
                                <i class="bi bi-search"></i> Relever depuis le journal réel
                            </a>
                        </div>
                        <textarea rows="3" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2 text-xs font-mono text-sky-400 focus:ring-2 focus:ring-sky-500/50 focus:outline-none" @bind="_marqueurs" placeholder="Web tier servlet .*initialized"></textarea>
                        <p class="text-[11px] text-slate-500 mt-1">
                            Un marqueur par ligne. Le premier qui apparaît après le lancement vaut preuve.
                            Ne les devinez pas : relevez-les sur un démarrage réussi.
                        </p>
                    </div>

                    <div>
                        <label class="block font-semibold text-slate-300 mb-1">Signatures d'échec précoce</label>
                        <textarea rows="2" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2 text-xs font-mono text-rose-400 focus:ring-2 focus:ring-sky-500/50 focus:outline-none" @bind="_erreurs"></textarea>
                    </div>

                    @if (_c.Role is ComponentRole.CenterNode or ComponentRole.StandbyCenterNode)
                    {
                        <div>
                            <label class="block font-semibold text-slate-300 mb-1">Marqueurs de rôle actif détenu (FR-032/033)</label>
                            <textarea rows="2" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2 text-xs font-mono text-amber-400 focus:ring-2 focus:ring-sky-500/50 focus:outline-none" @bind="_roleActif"></textarea>
                            <p class="text-[11px] text-slate-500 mt-1">
                                Un service Center/Standby démarré ne dit pas qui détient le rôle actif sur le
                                cluster. Sans marqueur relevé sur site, l'état du rôle reste « à confirmer » —
                                jamais supposé à partir du seul état du service.
                            </p>
                        </div>
                    }

                    @if (_c.Role is ComponentRole.BridgeDaemon or ComponentRole.Xps)
                    {
                        <div>
                            <label class="block font-semibold text-slate-300 mb-1">Marqueurs d'échange N4-XPS normal (FR-056)</label>
                            <textarea rows="2" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2 text-xs font-mono text-amber-400 focus:ring-2 focus:ring-sky-500/50 focus:outline-none" @bind="_syncNormal"></textarea>
                            <p class="text-[11px] text-slate-500 mt-1">
                                Sans marqueur relevé sur site, la synchronisation reste « à confirmer », jamais
                                supposée à jour.
                            </p>
                        </div>
                        <div>
                            <label class="block font-semibold text-slate-300 mb-1">Retard toléré avant alerte (minutes)</label>
                            <input type="number" min="1" class="w-32 bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2 text-xs font-mono text-white focus:ring-2 focus:ring-sky-500/50 focus:outline-none" @bind="_c.Readiness.SyncDelayThresholdMinutes" />
                        </div>
                    }

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block font-semibold text-slate-300 mb-1">Délai Service (s)</label>
                            <input type="number" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2 text-xs font-mono text-white focus:ring-2 focus:ring-sky-500/50 focus:outline-none" @bind="_c.Readiness.ServiceRunningTimeoutSeconds" />
                        </div>
                        <div>
                            <label class="block font-semibold text-slate-300 mb-1">Délai Preuve (s)</label>
                            <input type="number" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2 text-xs font-mono text-white focus:ring-2 focus:ring-sky-500/50 focus:outline-none" @bind="_c.Readiness.LogReadyTimeoutSeconds" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Dossier partagé (FR-059A/B/C) -->
        @if (_c.Role is ComponentRole.DossierPartage or ComponentRole.ActiveMq or ComponentRole.InterfaceEdi)
        {
            <div class="glass-card rounded-2xl border border-slate-800 p-6 space-y-4">
                <div class="border-b border-slate-800 pb-3">
                    <h3 class="text-sm font-bold text-white flex items-center gap-2">
                        <i class="bi bi-folder2-open text-teal-400"></i>
                        Dossier partagé supervisé
                    </h3>
                    <p class="text-[11px] text-slate-500 mt-1 leading-relaxed">
                        Chemin vide = ce composant n'est pas traité comme un dossier partagé par la supervision.
                        Les sous-dossiers de classification ne sont jamais devinés : rien ne le documente au-delà
                        du fichier <code class="text-teal-300">db.data</code> pour la catégorie ActiveMQ/KahaDB.
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
                    <div>
                        <label class="block font-semibold text-slate-300 mb-1">Chemin racine (UNC ou local)</label>
                        <input class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2 text-xs font-mono text-white placeholder-slate-500 focus:ring-2 focus:ring-sky-500/50 focus:outline-none"
                               @bind="_c.SharedFolder.RootPath" placeholder="\\N4CLUSTER01\NavisShared\amq" />
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-300 mb-1">Catégorie</label>
                        <select class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2 text-xs text-white focus:ring-2 focus:ring-sky-500/50 focus:outline-none"
                                @bind="_c.SharedFolder.Category">
                            @foreach (var cat in Enum.GetValues<SharedFolderCategory>())
                            {
                                <option value="@cat">@LibelleCategorie(cat)</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="block font-semibold text-slate-300 mb-1">Sous-dossier « en attente »</label>
                        <input class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2 text-xs font-mono text-white focus:ring-2 focus:ring-sky-500/50 focus:outline-none"
                               @bind="_c.SharedFolder.PendingSubfolder" placeholder="(facultatif)" />
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-300 mb-1">Sous-dossier « consommé »</label>
                        <input class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2 text-xs font-mono text-white focus:ring-2 focus:ring-sky-500/50 focus:outline-none"
                               @bind="_c.SharedFolder.ConsumedSubfolder" placeholder="(facultatif)" />
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-300 mb-1">Sous-dossier « bloqué »</label>
                        <input class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2 text-xs font-mono text-white focus:ring-2 focus:ring-sky-500/50 focus:outline-none"
                               @bind="_c.SharedFolder.BlockedSubfolder" placeholder="(facultatif)" />
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-300 mb-1">Sous-dossier « erreur »</label>
                        <input class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2 text-xs font-mono text-white focus:ring-2 focus:ring-sky-500/50 focus:outline-none"
                               @bind="_c.SharedFolder.ErrorSubfolder" placeholder="(facultatif)" />
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-300 mb-1">Ancienneté maximale « en attente » (heures)</label>
                        <input type="number" min="1" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2 text-xs font-mono text-white focus:ring-2 focus:ring-sky-500/50 focus:outline-none"
                               @bind="_c.SharedFolder.MaxPendingAgeHours" placeholder="(facultatif)" />
                    </div>

                    @if (_c.SharedFolder.Category == SharedFolderCategory.EchangeEdi)
                    {
                        <div class="md:col-span-2">
                            <label class="block font-semibold text-slate-300 mb-1">
                                Motif d'extraction partenaire/type (FR-059H)
                            </label>
                            <input class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2 text-xs font-mono text-white focus:ring-2 focus:ring-sky-500/50 focus:outline-none"
                                   @bind="_c.SharedFolder.EdiFileNamingPattern"
                                   placeholder="^(?&lt;partner&gt;[A-Z]+)_(?&lt;type&gt;[A-Z]+)_\d+\.edi$" />
                            <p class="text-[10px] text-slate-500 mt-1">
                                Expression régulière avec groupes nommés <code class="text-teal-300">partner</code> et
                                <code class="text-teal-300">type</code>. Aucune convention de nommage des partenaires
                                CIT n'étant documentée, sans motif déclaré ces deux informations restent non classifiées.
                            </p>
                        </div>
                        <div>
                            <label class="block font-semibold text-slate-300 mb-1">
                                Alerte si aucune intégration depuis (heures)
                            </label>
                            <input type="number" min="1" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2 text-xs font-mono text-white focus:ring-2 focus:ring-sky-500/50 focus:outline-none"
                                   @bind="_c.SharedFolder.MaxHoursSinceLastIntegration" placeholder="(facultatif)" />
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Dépendances (FR-002, FR-044) -->
        <div class="glass-card rounded-2xl border border-slate-800 p-6 space-y-4">
            <div class="border-b border-slate-800 pb-3">
                <h3 class="text-sm font-bold text-white flex items-center gap-2">
                    <i class="bi bi-diagram-3-fill text-theme-primary"></i>
                    Dépendances
                </h3>
                <p class="text-[11px] text-slate-500 mt-1 leading-relaxed">
                    Le graphe sert à déterminer l'ordre des séquences et à <strong class="text-slate-400">refuser
                    celles qui ne peuvent pas aboutir</strong> — démarrer XPS avant que le Bridge soit confirmé
                    opérationnel, par exemple. Il sert aussi à savoir qui tombe avec ce composant si on l'arrête.
                </p>
            </div>

            @if (_erreurDependance is not null)
            {
                <div class="p-3 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-300 text-xs">@_erreurDependance</div>
            }

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 text-xs">
                <!-- Ce composant dépend de -->
                <div class="space-y-2">
                    <div class="font-semibold text-slate-300">Ce composant a besoin de</div>

                    @if (_dependances.Count == 0)
                    {
                        <p class="text-slate-500">Aucune dépendance déclarée.</p>
                    }
                    else
                    {
                        @foreach (var d in _dependances)
                        {
                            <div class="flex items-center justify-between gap-2 p-2.5 rounded-xl bg-slate-900/60 border border-slate-800">
                                <div>
                                    <div class="text-white font-semibold">@d.DependsOnComponent?.LogicalName</div>
                                    <div class="text-[10px] text-slate-500">@LibelleDependance(d.Kind)</div>
                                </div>
                                <button class="p-1.5 rounded-lg bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 transition"
                                        @onclick="() => SupprimerDependance(d.Id)" title="Supprimer">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        }
                    }

                    <div class="flex flex-wrap items-center gap-2 pt-2">
                        <select class="flex-1 min-w-40 bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-white" @bind="_nouvelleDependance">
                            <option value="@Guid.Empty">Ajouter un prérequis…</option>
                            @foreach (var c in _voisins.Where(c => c.Id != Id && _dependances.All(d => d.DependsOnComponentId != c.Id)))
                            {
                                <option value="@c.Id">@c.LogicalName</option>
                            }
                        </select>
                        <select class="bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-white" @bind="_natureDependance">
                            @foreach (var k in Enum.GetValues<DependencyKind>())
                            {
                                <option value="@k">@LibelleDependance(k)</option>
                            }
                        </select>
                        <button class="px-3 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold transition disabled:opacity-40"
                                disabled="@(_nouvelleDependance == Guid.Empty)" @onclick="AjouterDependance">
                            <i class="bi bi-plus-lg"></i>
                        </button>
                    </div>
                </div>

                <!-- Ce qui dépend de lui -->
                <div class="space-y-2">
                    <div class="font-semibold text-slate-300">Tomberait avec lui</div>

                    @if (_dependants.Count == 0)
                    {
                        <p class="text-slate-500">Aucun composant déclaré dépendant de celui-ci.</p>
                    }
                    else
                    {
                        <div class="p-3 rounded-xl bg-amber-500/5 border border-amber-500/20 space-y-1.5">
                            @foreach (var d in _dependants)
                            {
                                <div class="flex items-center gap-2">
                                    <i class="bi bi-arrow-return-right text-amber-400"></i>
                                    <span class="text-white font-semibold">@d.Component?.LogicalName</span>
                                    <span class="text-[10px] text-slate-500">@LibelleDependance(d.Kind)</span>
                                </div>
                            }
                            <p class="text-[11px] text-amber-300/80 pt-1">
                                Arrêter ce composant rendra ces composants inopérants. Une séquence d'arrêt doit
                                les traiter en premier.
                            </p>
                        </div>
                    }
                </div>
            </div>
        </div>

        @if (_message is not null)
        {
            <div class="p-3.5 rounded-xl text-xs font-semibold border @_messageClass">@_message</div>
        }

        <div class="flex items-center gap-3">
            <button class="px-5 py-2.5 rounded-xl bg-sky-600 hover:bg-sky-500 text-white font-bold text-xs shadow-lg shadow-sky-600/20 transition" @onclick="Enregistrer">
                Enregistrer les modifications
            </button>
            <a class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs transition" href="@($"/admin/environnements/{_c.EnvironmentId}")">
                Retour
            </a>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private N4Component? _c;
    private string _marqueurs = "";
    private string _erreurs = "";
    private string _ignores = "";
    private string _roleActif = "";
    private string _syncNormal = "";
    private string? _message;
    private bool _enErreur;

    private string _messageClass => _enErreur
        ? "bg-rose-500/10 text-rose-300 border-rose-500/20"
        : "bg-emerald-500/10 text-emerald-300 border-emerald-500/20";

    private List<ComponentDependency> _dependances = [];
    private List<ComponentDependency> _dependants = [];
    private List<N4Component> _voisins = [];
    private Guid _nouvelleDependance;
    private DependencyKind _natureDependance = DependencyKind.RequisAuDemarrage;
    private string? _erreurDependance;

    protected override async Task OnParametersSetAsync()
    {
        _c = await Referential.GetComponentAsync(Id);
        if (_c is null) return;
        _marqueurs = string.Join(Environment.NewLine, _c.Readiness.ReadyPatterns);
        _erreurs = string.Join(Environment.NewLine, _c.Readiness.ErrorPatterns);
        _ignores = string.Join(Environment.NewLine, _c.Readiness.IgnorePatterns);
        _roleActif = string.Join(Environment.NewLine, _c.Readiness.ActiveRolePatterns);
        _syncNormal = string.Join(Environment.NewLine, _c.Readiness.SyncPatterns);

        await ChargerDependances();
    }

    private async Task ChargerDependances()
    {
        if (_c is null) return;
        _dependances = await Referential.GetDependenciesAsync(Id);
        _dependants = await Referential.GetDependentsAsync(Id);
        _voisins = await Referential.GetComponentsAsync(_c.EnvironmentId);
    }

    private async Task AjouterDependance()
    {
        if (_c is null || _nouvelleDependance == Guid.Empty) return;
        _erreurDependance = null;

        // Le cycle est detecte AVANT enregistrement : mieux vaut le dire au
        // moment de la saisie qu'un dimanche matin de reprise apres incident,
        // ou aucun des composants concernes ne pourrait demarrer en premier.
        var cycle = await Validator.DetectCycleAsync(_c.EnvironmentId, Id, _nouvelleDependance);
        if (cycle is not null) { _erreurDependance = cycle; return; }

        _erreurDependance = await Referential.AddDependencyAsync(
            Id, _nouvelleDependance, _natureDependance, null);

        _nouvelleDependance = Guid.Empty;
        await ChargerDependances();
    }

    private async Task SupprimerDependance(Guid dependencyId)
    {
        await Referential.RemoveDependencyAsync(dependencyId);
        await ChargerDependances();
    }

    private static string LibelleCategorie(SharedFolderCategory c) => c switch
    {
        SharedFolderCategory.ConfigurationN4 => "Configuration N4",
        SharedFolderCategory.ActiveMqKahaDb => "ActiveMQ / KahaDB",
        SharedFolderCategory.EchangeEdi => "Échange EDI",
        SharedFolderCategory.Archives => "Archives",
        SharedFolderCategory.DossiersErreur => "Dossier d'erreur",
        _ => "Autre"
    };

    private static string LibelleDependance(DependencyKind k) => k switch
    {
        DependencyKind.RequisAuDemarrage => "Requis au démarrage",
        DependencyKind.RequisEnFonctionnement => "Requis en fonctionnement",
        DependencyKind.Informative => "Informative (non bloquante)",
        _ => k.ToString()
    };

    private async Task Enregistrer()
    {
        if (_c is null) return;
        _message = null;

        _c.Readiness.ReadyPatterns = Decouper(_marqueurs);
        _c.Readiness.ErrorPatterns = Decouper(_erreurs);
        _c.Readiness.IgnorePatterns = Decouper(_ignores);
        _c.Readiness.ActiveRolePatterns = _c.Role is ComponentRole.CenterNode or ComponentRole.StandbyCenterNode
            ? Decouper(_roleActif)
            : [];
        _c.Readiness.SyncPatterns = _c.Role is ComponentRole.BridgeDaemon or ComponentRole.Xps
            ? Decouper(_syncNormal)
            : [];

        foreach (var motif in _c.Readiness.ReadyPatterns
                     .Concat(_c.Readiness.ErrorPatterns)
                     .Concat(_c.Readiness.IgnorePatterns)
                     .Concat(_c.Readiness.ActiveRolePatterns)
                     .Concat(_c.Readiness.SyncPatterns))
        {
            try { _ = System.Text.RegularExpressions.Regex.Match("", motif); }
            catch (ArgumentException ex)
            {
                _enErreur = true;
                _message = $"Expression régulière invalide : « {motif} » - {ex.Message}";
                return;
            }
        }

        try
        {
            _c.Server = null;
            _c.Environment = null;
            await Referential.SaveComponentAsync(_c);
            _enErreur = false;
            _message = "Composant enregistré avec succès.";
            _c = await Referential.GetComponentAsync(Id);
        }
        catch (Exception ex)
        {
            _enErreur = true;
            _message = $"Enregistrement impossible : {ex.InnerException?.Message ?? ex.Message}";
        }
    }

    private static List<string> Decouper(string texte) =>
        texte.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
             .ToList();
}
