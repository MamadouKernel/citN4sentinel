@page "/admin/environnements"
@using Microsoft.AspNetCore.Authorization
@using N4Sentinel.Domain
@using N4Sentinel.Infrastructure.Referential
@attribute [Authorize(Policy = N4Policies.PeutConsulter)]
@rendermode InteractiveServer
@inject ReferentialService Referential
@inject NavigationManager Nav

<PageTitle>Environnements — N4 Sentinel</PageTitle>

<div class="space-y-6">
    <!-- Header Banner -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Environnements N4</h1>
            <p class="text-xs sm:text-sm text-slate-400 mt-1">
                Chaque environnement possède sa propre cartographie, ses composants et ses règles d'isolation.
            </p>
        </div>
        <AuthorizeView Policy="@N4Policies.PeutAdministrerReferentiel">
            <button class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl btn-theme-primary text-white font-bold text-xs transition" @onclick="NouvelEnvironnement">
                <i class="bi bi-plus-circle-fill text-sm"></i>
                <span>Nouvel environnement</span>
            </button>
        </AuthorizeView>
    </div>

    @if (_environnements is null)
    {
        <div class="glass-card p-8 rounded-2xl border border-slate-800 text-center text-slate-400 text-xs">
            <div class="inline-block w-6 h-6 border-2 border-sky-500 border-t-transparent rounded-full animate-spin mb-2"></div>
            <div>Chargement des environnements...</div>
        </div>
    }
    else if (_environnements.Count == 0)
    {
        <div class="glass-card p-6 sm:p-8 rounded-2xl border border-slate-800 text-center space-y-3">
            <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-sky-500/10 text-sky-400 text-xl border border-sky-500/20">
                <i class="bi bi-hdd-stack-fill"></i>
            </div>
            <h3 class="text-base font-bold text-white">Aucun environnement déclaré</h3>
            <p class="text-xs text-slate-400 max-w-md mx-auto leading-relaxed">
                Commencez par créer l'environnement UAT ou PROD, puis importez l'inventaire depuis le fichier <code class="text-sky-400">Navis-Config.json</code>.
            </p>
        </div>
    }
    else
    {
        <div class="glass-card rounded-2xl border border-slate-800 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs text-slate-300">
                    <thead class="bg-slate-900/80 text-slate-400 text-[10px] uppercase tracking-wider border-b border-slate-800">
                        <tr>
                            <th class="py-3.5 px-4 font-bold">Code</th>
                            <th class="py-3.5 px-4 font-bold">Nom complet</th>
                            <th class="py-3.5 px-4 font-bold">Type</th>
                            <th class="py-3.5 px-4 font-bold">Criticité</th>
                            <th class="py-3.5 px-4 font-bold">Statut Cycle</th>
                            <th class="py-3.5 px-4 font-bold">Composants</th>
                            <th class="py-3.5 px-4 font-bold text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-800/60">
                        @foreach (var env in _environnements)
                        {
                            <tr class="hover:bg-slate-800/40 transition">
                                <td class="py-4 px-4 font-mono font-bold text-white whitespace-nowrap">
                                    <div class="flex items-center gap-2">
                                        <span>@env.Code</span>
                                        @if (env.IsProduction)
                                        {
                                            <span class="px-1.5 py-0.5 rounded text-[9px] font-extrabold bg-rose-500/20 text-rose-400 border border-rose-500/30">PROD</span>
                                        }
                                    </div>
                                </td>
                                <td class="py-4 px-4">
                                    <div class="font-semibold text-white">@env.Name</div>
                                    @if (!string.IsNullOrEmpty(env.TechnicalOwner))
                                    {
                                        <div class="text-[10px] text-slate-400">Resp: @env.TechnicalOwner</div>
                                    }
                                </td>
                                <td class="py-4 px-4 whitespace-nowrap">
                                    <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-slate-800 text-slate-300 border border-slate-700">@env.Kind</span>
                                </td>
                                <td class="py-4 px-4 whitespace-nowrap">
                                    <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-slate-800 text-slate-400 border border-slate-700">@env.Criticality</span>
                                </td>
                                <td class="py-4 px-4 whitespace-nowrap">
                                    <StatutBadge Statut="env.Status" />
                                </td>
                                <td class="py-4 px-4 whitespace-nowrap">
                                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-sky-500/10 text-sky-400 border border-sky-500/20">
                                        @(_compteurs.TryGetValue(env.Id, out var n) ? n : 0) éléments
                                    </span>
                                </td>
                                <td class="py-4 px-4 text-right whitespace-nowrap">
                                    <a href="@($"/admin/environnements/{env.Id}")" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-sky-400 hover:text-sky-300 font-semibold text-xs transition">
                                        <i class="bi bi-folder2-open"></i> Ouvrir
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- Inline Creation / Editing Card -->
    @if (_edition is not null)
    {
        <div class="glass-card rounded-2xl border border-slate-700 p-6 space-y-6 mt-6">
            <div class="flex items-center justify-between border-b border-slate-800 pb-4">
                <h3 class="text-sm font-bold text-white flex items-center gap-2">
                    <i class="bi bi-pencil-square text-sky-400"></i>
                    @(_estNouveau ? "Nouvel environnement" : $"Modifier {_edition.Code}")
                </h3>
                <button type="button" class="text-slate-400 hover:text-white transition" @onclick="Annuler">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <EditForm Model="_edition" OnValidSubmit="Enregistrer" FormName="environnement" class="space-y-4">
                <DataAnnotationsValidator />
                
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 mb-1">Code Identifiant</label>
                        <input class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2 text-xs text-white placeholder-slate-500 focus:ring-2 focus:ring-sky-500/50 focus:outline-none" @bind="_edition.Code" placeholder="UAT" />
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-300 mb-1">Nom complet</label>
                        <input class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2 text-xs text-white placeholder-slate-500 focus:ring-2 focus:ring-sky-500/50 focus:outline-none" @bind="_edition.Name" placeholder="Environnement de recette" />
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-300 mb-1">Type d'environnement</label>
                        <select class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2 text-xs text-white focus:ring-2 focus:ring-sky-500/50 focus:outline-none" @bind="_edition.Kind">
                            @foreach (var k in Enum.GetValues<EnvironmentKind>())
                            {
                                <option value="@k">@k</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-300 mb-1">Niveau de criticité</label>
                        <select class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2 text-xs text-white focus:ring-2 focus:ring-sky-500/50 focus:outline-none" @bind="_edition.Criticality">
                            @foreach (var c in Enum.GetValues<CriticalityLevel>())
                            {
                                <option value="@c">@c</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-300 mb-1">Fuseau horaire</label>
                        <input class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2 text-xs text-white focus:ring-2 focus:ring-sky-500/50 focus:outline-none" @bind="_edition.TimeZoneId" placeholder="Africa/Abidjan" />
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-300 mb-1">Responsable technique</label>
                        <input class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2 text-xs text-white focus:ring-2 focus:ring-sky-500/50 focus:outline-none" @bind="_edition.TechnicalOwner" placeholder="Équipe DSI" />
                    </div>

                    <div class="sm:col-span-2 lg:col-span-3">
                        <label class="block text-xs font-semibold text-slate-300 mb-1">Description & Remarques</label>
                        <textarea rows="2" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2 text-xs text-white focus:ring-2 focus:ring-sky-500/50 focus:outline-none" @bind="_edition.Description"></textarea>
                    </div>
                </div>

                @if (_erreur is not null)
                {
                    <div class="p-3 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-300 text-xs font-semibold">@_erreur</div>
                }

                <div class="flex items-center gap-3 pt-2">
                    <button type="submit" class="px-4 py-2 rounded-xl bg-sky-600 hover:bg-sky-500 text-white font-bold text-xs shadow-lg shadow-sky-600/20 transition">Enregistrer</button>
                    <button type="button" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs transition" @onclick="Annuler">Annuler</button>
                </div>
            </EditForm>
        </div>
    }
</div>

@code {
    private List<N4Environment>? _environnements;
    private Dictionary<Guid, int> _compteurs = [];
    private N4Environment? _edition;
    private bool _estNouveau;
    private string? _erreur;

    protected override async Task OnInitializedAsync() => await Recharger();

    private async Task Recharger()
    {
        _environnements = await Referential.GetEnvironmentsAsync();
        _compteurs = [];
        foreach (var env in _environnements)
            _compteurs[env.Id] = await Referential.CountComponentsAsync(env.Id);
    }

    private void NouvelEnvironnement()
    {
        _edition = new N4Environment { Code = "", Name = "" };
        _estNouveau = true;
        _erreur = null;
    }

    private void Annuler()
    {
        _edition = null;
        _erreur = null;
    }

    private async Task Enregistrer()
    {
        _erreur = null;
        if (_edition is null) return;

        if (string.IsNullOrWhiteSpace(_edition.Code) || string.IsNullOrWhiteSpace(_edition.Name))
        {
            _erreur = "Le code et le nom sont obligatoires.";
            return;
        }

        try
        {
            await Referential.SaveEnvironmentAsync(_edition);
            _edition = null;
            await Recharger();
        }
        catch (Exception ex)
        {
            _erreur = ex.InnerException?.Message.Contains("IX_Environments_Code") == true
                ? "Ce code est déjà utilisé par un autre environnement."
                : $"Enregistrement impossible : {ex.InnerException?.Message ?? ex.Message}";
        }
    }
}
