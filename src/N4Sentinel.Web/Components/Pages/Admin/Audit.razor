@page "/admin/audit"
@using Microsoft.AspNetCore.Authorization
@using N4Sentinel.Domain
@using N4Sentinel.Infrastructure.Referential
@using N4Sentinel.Infrastructure.Retention
@attribute [Authorize(Policy = N4Policies.PeutAuditer)]
@rendermode InteractiveServer
@inject ReferentialService Referential
@inject RetentionPolicyService Retention
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Journal d'audit — N4 Sentinel</PageTitle>

<div class="space-y-6">
    <!-- Header Banner -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Journal d'Audit Immuable</h1>
            <p class="text-xs sm:text-sm text-slate-400 mt-1">
                Traçabilité complète des opérations sur le référentiel. Chaque modification est scellée avec horodatage UTC et IP.
            </p>
        </div>
    </div>

    <!-- Politique de rétention (FR-079, SEC-009) -->
    <AuthorizeView Policy="@N4Policies.PeutAdministrerReferentiel" Context="admin">
        <div class="glass-card p-5 rounded-2xl border border-slate-800 space-y-4">
            <div>
                <h3 class="text-sm font-bold text-white flex items-center gap-2">
                    <i class="bi bi-hourglass-split text-amber-400"></i> Politique de rétention
                </h3>
                <p class="text-[11px] text-slate-500 mt-1 leading-relaxed max-w-3xl">
                    Délai distinct par catégorie. <strong class="text-slate-400">Le journal d'audit n'est jamais
                    purgé</strong> — il est immuable par construction (SEC-008) ; le délai ci-dessous n'est qu'une
                    référence de conformité affichée, pas un déclencheur de suppression.
                </p>
            </div>

            @if (_politique is null)
            {
                <div class="text-xs text-slate-400">Chargement…</div>
            }
            else
            {
                <div class="grid grid-cols-1 md:grid-cols-4 gap-4 text-xs">
                    <div>
                        <label class="block text-slate-400 font-semibold mb-1">Journaux de diagnostic (jours)</label>
                        <input type="number" min="1" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-white font-mono"
                               @bind="_politique.LogsRetentionDays" />
                        <p class="text-[10px] text-slate-500 mt-1">Sessions closes uniquement. Le titre, le verdict et les phases restent conservés.</p>
                    </div>
                    <div>
                        <label class="block text-slate-400 font-semibold mb-1">Rapports d'exécution (jours)</label>
                        <input type="number" min="1" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-white font-mono"
                               @bind="_politique.ReportsRetentionDays" />
                        <p class="text-[10px] text-slate-500 mt-1">Exécutions terminées uniquement, jamais une opération en cours.</p>
                    </div>
                    <div>
                        <label class="block text-slate-400 font-semibold mb-1">Relevés de supervision (jours)</label>
                        <input type="number" min="1" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-white font-mono"
                               @bind="_politique.SignalsRetentionDays" />
                        <p class="text-[10px] text-slate-500 mt-1">Un relevé par composant toutes les ~30s (§3.18) : volume élevé, délai plus court.</p>
                    </div>
                    <div>
                        <label class="block text-slate-400 font-semibold mb-1">Audit — référence (jours)</label>
                        <input type="number" min="1" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-white font-mono"
                               @bind="_politique.AuditRetentionDays" />
                        <p class="text-[10px] text-slate-500 mt-1">Informatif : aucune suppression n'est déclenchée par cette valeur.</p>
                    </div>
                </div>

                <div class="flex flex-wrap items-center gap-3">
                    <button class="px-4 py-2 rounded-xl btn-theme-primary text-white font-bold text-xs transition" @onclick="EnregistrerPolitique">
                        Enregistrer
                    </button>
                    <button class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs transition" @onclick="PrevisualiserPurge">
                        <i class="bi bi-eye"></i> Prévisualiser la purge
                    </button>
                    @if (_apercu is not null)
                    {
                        <button class="px-4 py-2 rounded-xl bg-rose-600 hover:bg-rose-500 text-white font-bold text-xs transition"
                                @onclick="ConfirmerPurge" disabled="@(_apercu.LogSourcesToDelete == 0 && _apercu.LogFindingsToDelete == 0 && _apercu.ExecutionsToDelete == 0 && _apercu.SignalsToDelete == 0)">
                            <i class="bi bi-trash"></i> Appliquer la purge
                        </button>
                    }
                </div>

                @if (_retentionMessage is not null)
                {
                    <div class="p-3.5 rounded-xl text-xs font-semibold border @_retentionMessageClass">@_retentionMessage</div>
                }

                @if (_apercu is not null)
                {
                    <div class="p-3.5 rounded-xl bg-slate-900/60 border border-slate-700 text-xs text-slate-300 space-y-1">
                        <div><strong class="text-white">@_apercu.LogSourcesToDelete</strong> source(s) de journal et <strong class="text-white">@_apercu.LogFindingsToDelete</strong> constat(s) — sessions closes avant @_seuilLogsAffiche.</div>
                        <div><strong class="text-white">@_apercu.ExecutionsToDelete</strong> exécution(s) terminée(s) avant @_seuilRapportsAffiche.</div>
                        <div><strong class="text-white">@_apercu.SignalsToDelete</strong> relevé(s) de supervision avant @_seuilSignauxAffiche.</div>
                    </div>
                }
            }
        </div>
    </AuthorizeView>

    <!-- Filters Bar -->
    <div class="glass-card p-4 rounded-2xl border border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex flex-wrap items-center gap-3">
            <div class="flex items-center gap-2">
                <label class="text-xs font-bold text-slate-400 uppercase tracking-wider">Environnement :</label>
                <select class="bg-slate-900 border border-slate-700 rounded-xl px-3 py-1.5 text-xs text-white focus:ring-2 focus:ring-sky-500/50 focus:outline-none" @bind="_filtreEnv" @bind:after="Recharger">
                    <option value="">Tous les environnements</option>
                    @foreach (var e in _environnements)
                    {
                        <option value="@e.Id">@e.Code &middot; @e.Name</option>
                    }
                </select>
            </div>
        </div>

        <div class="flex items-center gap-3">
            <div class="flex items-center gap-2">
                <label class="text-xs font-bold text-slate-400 uppercase tracking-wider">Lignes :</label>
                <select class="bg-slate-900 border border-slate-700 rounded-xl px-3 py-1.5 text-xs text-white focus:ring-2 focus:ring-sky-500/50 focus:outline-none" @bind="_limite" @bind:after="Recharger">
                    <option value="50">50</option>
                    <option value="200">200</option>
                    <option value="1000">1000</option>
                </select>
            </div>

            <button class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-sky-400 font-semibold text-xs transition" @onclick="Recharger">
                <i class="bi bi-arrow-clockwise"></i> Rafraîchir
            </button>
        </div>
    </div>

    @if (_entrees is null)
    {
        <div class="glass-card p-8 rounded-2xl border border-slate-800 text-center text-slate-400 text-xs">
            <div class="inline-block w-6 h-6 border-2 border-sky-500 border-t-transparent rounded-full animate-spin mb-2"></div>
            <div>Chargement du journal d'audit...</div>
        </div>
    }
    else if (_entrees.Count == 0)
    {
        <div class="glass-card p-8 rounded-2xl border border-slate-800 text-center space-y-2">
            <i class="bi bi-shield-check text-3xl text-slate-500 block"></i>
            <h3 class="text-sm font-bold text-white">Aucune entrée dans le journal</h3>
            <p class="text-xs text-slate-400">Le journal se remplira automatiquement dès la première modification du référentiel.</p>
        </div>
    }
    else
    {
        <div class="glass-card rounded-2xl border border-slate-800 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs text-slate-300">
                    <thead class="bg-slate-900/80 text-slate-400 text-[10px] uppercase tracking-wider border-b border-slate-800">
                        <tr>
                            <th class="py-3.5 px-4 font-bold">Horodatage</th>
                            <th class="py-3.5 px-4 font-bold">Opérateur / Acteur</th>
                            <th class="py-3.5 px-4 font-bold">Adresse IP</th>
                            <th class="py-3.5 px-4 font-bold">Action</th>
                            <th class="py-3.5 px-4 font-bold">Objet Concerné</th>
                            <th class="py-3.5 px-4 font-bold">Issue</th>
                            <th class="py-3.5 px-4 font-bold text-right">Détails JSON</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-800/60">
                        @foreach (var a in _entrees)
                        {
                            <tr class="hover:bg-slate-800/40 transition">
                                <td class="py-3.5 px-4 font-mono text-slate-200 whitespace-nowrap">
                                    <i class="bi bi-clock me-1 text-slate-500"></i>
                                    @a.OccurredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")
                                </td>
                                <td class="py-3.5 px-4 font-semibold text-white">
                                    @a.Actor
                                </td>
                                <td class="py-3.5 px-4 font-mono text-slate-400">
                                    @(a.ActorIpAddress ?? "-")
                                </td>
                                <td class="py-3.5 px-4 whitespace-nowrap">
                                    <span class="px-2.5 py-1 rounded-full text-[10px] font-bold border @ClasseAction(a.Action)">
                                        @LibelleAction(a.Action)
                                    </span>
                                </td>
                                <td class="py-3.5 px-4">
                                    <div class="font-bold text-white">@a.EntityLabel</div>
                                    <div class="text-[10px] font-mono text-slate-500">@a.EntityType</div>
                                </td>
                                <td class="py-3.5 px-4 whitespace-nowrap">
                                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold border @(a.Outcome == AuditOutcome.Succes ? "bg-emerald-500/10 text-emerald-400 border-emerald-500/20" : a.Outcome == AuditOutcome.Refuse ? "bg-amber-500/10 text-amber-400 border-amber-500/20" : "bg-rose-500/10 text-rose-400 border-rose-500/20")">
                                        @a.Outcome
                                    </span>
                                </td>
                                <td class="py-3.5 px-4 text-right whitespace-nowrap">
                                    @if (a.AfterJson is not null || a.BeforeJson is not null)
                                    {
                                        <button class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-sky-400 font-semibold text-[11px] transition inline-flex items-center gap-1"
                                                @onclick="() => _entreeDetail = _entreeDetail == a ? null : a">
                                            <i class="bi bi-code-slash"></i> Inspecter
                                        </button>
                                    }
                                </td>
                            </tr>

                            @if (_entreeDetail == a)
                            {
                                <tr class="bg-slate-950/80">
                                    <td colspan="7" class="p-4">
                                        <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 space-y-3 font-mono text-xs">
                                            <div class="flex items-center justify-between pb-2 border-b border-slate-800">
                                                <span class="text-sky-400 font-bold">Modifications d'attributs (Diff JSON)</span>
                                                <button class="text-slate-400 hover:text-white transition text-xs" @onclick="() => _entreeDetail = null">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            </div>

                                            @if (a.BeforeJson is not null)
                                            {
                                                <div>
                                                    <span class="text-amber-400 font-bold block mb-1">Avant :</span>
                                                    <pre class="p-3 rounded-lg bg-slate-950 text-amber-200/90 overflow-x-auto text-[11px]">@a.BeforeJson</pre>
                                                </div>
                                            }

                                            @if (a.AfterJson is not null)
                                            {
                                                <div>
                                                    <span class="text-emerald-400 font-bold block mb-1">Après :</span>
                                                    <pre class="p-3 rounded-lg bg-slate-950 text-emerald-200/90 overflow-x-auto text-[11px]">@a.AfterJson</pre>
                                                </div>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private List<AuditEntry>? _entrees;
    private List<N4Environment> _environnements = [];
    private string _filtreEnv = "";
    private int _limite = 200;
    private AuditEntry? _entreeDetail;

    private RetentionPolicy? _politique;
    private RetentionPreview? _apercu;
    private string? _retentionMessage;
    private string _retentionMessageClass = string.Empty;
    private string _seuilLogsAffiche = string.Empty;
    private string _seuilRapportsAffiche = string.Empty;
    private string _seuilSignauxAffiche = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _environnements = await Referential.GetEnvironmentsAsync();
        _politique = await Retention.GetAsync();
        await Recharger();
    }

    private async Task EnregistrerPolitique()
    {
        if (_politique is null) return;

        var etat = await AuthProvider.GetAuthenticationStateAsync();
        var acteur = etat.User.Identity?.Name ?? "inconnu";

        var erreur = await Retention.SaveAsync(_politique, acteur);
        _apercu = null;

        _retentionMessage = erreur ?? "Politique de rétention enregistrée.";
        _retentionMessageClass = erreur is null
            ? "bg-emerald-500/10 border-emerald-500/20 text-emerald-300"
            : "bg-rose-500/10 border-rose-500/20 text-rose-300";
    }

    private async Task PrevisualiserPurge()
    {
        _apercu = await Retention.PreviewAsync();
        _seuilLogsAffiche = DateTimeOffset.UtcNow.AddDays(-_apercu.LogsRetentionDays).ToLocalTime().ToString("dd/MM/yyyy");
        _seuilRapportsAffiche = DateTimeOffset.UtcNow.AddDays(-_apercu.ReportsRetentionDays).ToLocalTime().ToString("dd/MM/yyyy");
        _seuilSignauxAffiche = DateTimeOffset.UtcNow.AddDays(-_apercu.SignalsRetentionDays).ToLocalTime().ToString("dd/MM/yyyy");
        _retentionMessage = null;
    }

    private async Task ConfirmerPurge()
    {
        var etat = await AuthProvider.GetAuthenticationStateAsync();
        var acteur = etat.User.Identity?.Name ?? "inconnu";

        _apercu = await Retention.ApplyAsync(acteur);
        _retentionMessage = $"Purge appliquée : {_apercu.LogSourcesToDelete} source(s), "
                           + $"{_apercu.LogFindingsToDelete} constat(s), {_apercu.ExecutionsToDelete} exécution(s), "
                           + $"{_apercu.SignalsToDelete} relevé(s) de supervision supprimé(s).";
        _retentionMessageClass = "bg-emerald-500/10 border-emerald-500/20 text-emerald-300";
        _apercu = null;
    }

    private async Task Recharger()
    {
        Guid? env = Guid.TryParse(_filtreEnv, out var g) ? g : null;
        _entrees = await Referential.GetAuditEntriesAsync(env, _limite);
        _entreeDetail = null;
    }

    private static string ClasseAction(AuditAction a) => a switch
    {
        AuditAction.Creation => "bg-emerald-500/10 text-emerald-400 border-emerald-500/20",
        AuditAction.Modification => "bg-sky-500/10 text-sky-400 border-sky-500/20",
        AuditAction.Suppression => "bg-rose-500/10 text-rose-400 border-rose-500/20",
        AuditAction.ChangementDeStatut => "bg-amber-500/10 text-amber-400 border-amber-500/20",
        _ => "bg-slate-500/10 text-slate-400 border-slate-500/20"
    };

    private static string LibelleAction(AuditAction a) => a switch
    {
        AuditAction.Creation => "Création",
        AuditAction.Modification => "Modification",
        AuditAction.Suppression => "Suppression",
        AuditAction.ChangementDeStatut => "Changement de statut",
        AuditAction.Connexion => "Connexion",
        AuditAction.TestDeConfiguration => "Test de configuration",
        AuditAction.TentativeNonAutorisee => "Tentative non autorisée",
        AuditAction.ExecutionOperation => "Exécution",
        AuditAction.Contournement => "Contournement",
        AuditAction.ArretForce => "Arrêt forcé",
        _ => a.ToString()
    };
}
