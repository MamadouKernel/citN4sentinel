@page "/admin/environnements/{Id:guid}"
@using Microsoft.AspNetCore.Authorization
@using N4Sentinel.Domain
@using N4Sentinel.Infrastructure.Connectivity
@using N4Sentinel.Infrastructure.Referential
@using N4Sentinel.Infrastructure.Supervision
@using N4Sentinel.Web.State
@attribute [Authorize(Policy = N4Policies.PeutConsulter)]
@rendermode InteractiveServer
@inject ReferentialService Referential
@inject NavisConfigImporter Importer
@inject ConnectivityTester Tester
@inject CurrentEnvironmentState EnvState
@inject NavigationManager Nav

<PageTitle>@(_env?.Code ?? "Environnement") — N4 Sentinel</PageTitle>

@if (_env is null)
{
    <div class="glass-card p-8 rounded-2xl border border-slate-800 text-center text-slate-400 text-xs">
        <div class="inline-block w-6 h-6 border-2 border-sky-500 border-t-transparent rounded-full animate-spin mb-2"></div>
        <div>Chargement de l'environnement...</div>
    </div>
}
else
{
    <div class="space-y-6">
        <!-- Header Banner -->
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 p-6 rounded-3xl bg-slate-900/60 border border-slate-800">
            <div class="space-y-1">
                <a href="/admin/environnements" class="text-xs text-theme-primary hover:underline transition flex items-center gap-1 mb-1">
                    <i class="bi bi-arrow-left"></i> Retour aux environnements
                </a>
                <div class="flex items-center gap-3">
                    <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">@_env.Code</h1>
                    <StatutBadge Statut="_env.Status" />
                </div>
                <p class="text-xs text-slate-400">@_env.Name</p>
            </div>

            <div class="flex flex-wrap items-center gap-2">
                <button class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-xs transition"
                        @onclick="TesterConfiguration" disabled="@_testEnCours">
                    @if (_testEnCours)
                    {
                        <span class="w-3.5 h-3.5 border-2 border-sky-400 border-t-transparent rounded-full animate-spin"></span>
                        <span>Test en cours...</span>
                    }
                    else
                    {
                        <i class="bi bi-shield-check text-emerald-400"></i>
                        <span>Tester la configuration</span>
                    }
                </button>

                <AuthorizeView Policy="@N4Policies.PeutAdministrerReferentiel">
                    <button class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-sky-400 font-semibold text-xs transition"
                            @onclick="() => _importOuvert = !_importOuvert">
                        <i class="bi bi-file-earmark-arrow-up"></i>
                        <span>Import Navis-Config.json</span>
                    </button>
                </AuthorizeView>
            </div>
        </div>

        <!-- Status Change Toolbar -->
        <AuthorizeView Policy="@N4Policies.PeutAdministrerReferentiel">
            @if (_env.Status != LifecycleStatus.Desactive)
            {
                <div class="p-4 rounded-2xl bg-slate-900/40 border border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <div class="flex items-center gap-2 flex-wrap">
                        <span class="text-xs font-bold text-slate-300">Changer le statut :</span>
                        <div class="flex gap-1.5 flex-wrap">
                            @if (_env.Status == LifecycleStatus.Brouillon)
                            {
                                <button class="px-3 py-1 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs transition"
                                        @onclick="() => ChangerStatut(LifecycleStatus.Valide)">
                                    Passer en Validé
                                </button>
                            }
                            @if (_env.Status == LifecycleStatus.Valide)
                            {
                                <button class="px-3 py-1 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs transition"
                                        @onclick="() => ChangerStatut(LifecycleStatus.Actif)">
                                    Activer l'environnement
                                </button>
                            }
                            @if (_env.Status == LifecycleStatus.Actif)
                            {
                                <button class="px-3 py-1 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-200 font-bold text-xs transition"
                                        @onclick="() => ChangerStatut(LifecycleStatus.Desactive)">
                                    Désactiver
                                </button>
                            }
                        </div>
                    </div>
                    @if (_env.Status != LifecycleStatus.Actif)
                    {
                        <span class="text-[11px] text-slate-400">
                            L'environnement doit être <strong class="text-white">Validé</strong> ou <strong class="text-white">Actif</strong> pour autoriser les opérations.
                        </span>
                    }
                </div>
            }
        </AuthorizeView>

        @if (_messageStatut is not null)
        {
            <div class="p-3.5 rounded-xl text-xs font-semibold border @_statutEnErreurClass">@_messageStatut</div>
        }

        <!-- Import Card with Template Download & JSON Preview -->
        @if (_importOuvert)
        {
            <div class="glass-card p-6 rounded-2xl border border-slate-700 space-y-5 shadow-2xl">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-800 pb-3">
                    <h3 class="text-sm font-bold text-white flex items-center gap-2">
                        <i class="bi bi-file-earmark-code-fill text-sky-400"></i>
                        Importer l'inventaire réel depuis Navis-Config.json
                    </h3>
                    <div class="flex items-center gap-2 flex-wrap">
                        <a href="@_sampleJsonDataUri" download="Navis-Config-Modele.json"
                           class="px-3 py-1.5 rounded-lg bg-sky-500/10 hover:bg-sky-500/20 text-sky-400 border border-sky-500/30 text-xs font-bold transition flex items-center gap-1.5 shadow-sm">
                            <i class="bi bi-download"></i>
                            <span>Télécharger le modèle JSON</span>
                        </a>
                        <button class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold transition flex items-center gap-1.5"
                                @onclick="() => _afficherStructureModele = !_afficherStructureModele">
                            <i class="bi bi-code-slash"></i>
                            <span>@(_afficherStructureModele ? "Masquer la structure" : "Voir la structure")</span>
                        </button>
                    </div>
                </div>

                <p class="text-xs text-slate-400 leading-relaxed">
                    Le fichier <code class="text-sky-400">Navis-Config.json</code> alimente directement le référentiel avec vos hôtes réels, vos services Windows, vos chemins de logs et vos marqueurs de démarrage.
                </p>

                @if (_afficherStructureModele)
                {
                    <div class="p-4 rounded-xl bg-slate-950 border border-slate-800 space-y-2 text-xs">
                        <div class="flex items-center justify-between text-slate-300 font-bold border-b border-slate-800 pb-2">
                            <span class="flex items-center gap-1.5">
                                <i class="bi bi-journal-code text-amber-400"></i>
                                Modèle de structure JSON (Navis-Config.json) :
                            </span>
                            <span class="text-[10px] text-sky-400 font-mono">Format JSON standard UTF-8</span>
                        </div>
                        <pre class="p-3.5 rounded-lg bg-slate-900 text-emerald-400 font-mono text-[11px] overflow-x-auto select-all max-h-64 border border-slate-800">@_sampleJsonText</pre>
                    </div>
                }

                <div class="space-y-2">
                    <label class="block text-xs font-semibold text-slate-300">Sélectionnez votre fichier JSON rempli à importer :</label>
                    <InputFile OnChange="ChargerFichier" class="block w-full text-xs text-slate-400 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-sky-600 file:text-white hover:file:bg-sky-500 cursor-pointer" accept=".json" />
                </div>

                @if (_rapportImport is not null)
                {
                    <div class="p-4 rounded-xl text-xs space-y-2 border @_rapportImportClass">
                        <div class="font-bold">
                            @_rapportImport.ServersCreated serveur(s) créé(s), @_rapportImport.ComponentsCreated composant(s) créé(s).
                        </div>
                        @foreach (var e in _rapportImport.Errors)
                        {
                            <div class="text-rose-300">@e</div>
                        }
                    </div>
                }
            </div>
        }

        <!-- Test Report Section -->
        @if (_rapport is not null)
        {
            <div class="glass-card rounded-2xl border border-slate-800 overflow-hidden">
                <div class="p-5 border-b border-slate-800 flex items-center justify-between flex-wrap gap-2">
                    <h3 class="text-sm font-bold text-white flex items-center gap-2">
                        <i class="bi bi-shield-check text-emerald-400"></i>
                        Rapport de Test de Configuration
                    </h3>
                    <span class="text-xs font-mono text-slate-400">
                        @_rapport.Results.Count contrôle(s) en @_rapport.Duration.TotalSeconds.ToString("0.0") s
                    </span>
                </div>
                <div class="p-5 space-y-4">
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
                        <div class="p-3 rounded-xl bg-slate-900 border border-slate-800 text-center">
                            <div class="text-slate-400 text-[10px] uppercase font-bold mb-0.5">Satisfaits</div>
                            <div class="font-extrabold text-sm text-emerald-400">@_rapport.Satisfied</div>
                        </div>
                        <div class="p-3 rounded-xl bg-slate-900 border border-slate-800 text-center">
                            <div class="text-slate-400 text-[10px] uppercase font-bold mb-0.5">Avertissements</div>
                            <div class="font-extrabold text-sm text-amber-400">@_rapport.Warnings</div>
                        </div>
                        <div class="p-3 rounded-xl bg-slate-900 border border-slate-800 text-center">
                            <div class="text-slate-400 text-[10px] uppercase font-bold mb-0.5">Bloquants</div>
                            <div class="font-extrabold text-sm text-rose-400">@_rapport.Blocking</div>
                        </div>
                        <div class="p-3 rounded-xl bg-slate-900 border border-slate-800 text-center">
                            <div class="text-slate-400 text-[10px] uppercase font-bold mb-0.5">Non Vérifiables</div>
                            <div class="font-extrabold text-sm text-slate-400">@_rapport.Unverifiable</div>
                        </div>
                    </div>

                    <div class="divide-y divide-slate-800 border-t border-slate-800">
                        @foreach (var res in _rapport.Results)
                        {
                            <div class="py-3 flex items-start justify-between gap-4 text-xs">
                                <div class="space-y-0.5">
                                    <div class="font-bold text-white">@res.Target — @res.CheckName</div>
                                    <div class="text-slate-400 text-[11px]">@res.Message</div>
                                    @if (res.Recommendation is not null)
                                    {
                                        <div class="text-sky-400 text-[11px] font-mono">Recommandation : @res.Recommendation</div>
                                    }
                                </div>
                                <span class="px-2 py-0.5 rounded text-[10px] font-bold shrink-0 @(res.Outcome switch {
                                    CheckOutcome.Satisfait => "bg-emerald-500/10 text-emerald-400 border border-emerald-500/20",
                                    CheckOutcome.Avertissement => "bg-amber-500/10 text-amber-400 border border-amber-500/20",
                                    CheckOutcome.Bloquant => "bg-rose-500/10 text-rose-400 border border-rose-500/20",
                                    _ => "bg-slate-500/10 text-slate-400 border border-slate-500/20"
                                })">
                                    @res.Outcome
                                </span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Servers Table -->
        <div class="glass-card rounded-2xl border border-slate-800 overflow-hidden">
            <div class="p-5 border-b border-slate-800 flex items-center justify-between">
                <h3 class="text-sm font-bold text-white flex items-center gap-2">
                    <i class="bi bi-server text-sky-400"></i>
                    Serveurs Nœuds (@_serveurs.Count)
                </h3>
                <AuthorizeView Policy="@N4Policies.PeutAdministrerReferentiel">
                    <a href="@($"/admin/environnements/{Id}/serveurs/nouveau")"
                       class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-sky-600 hover:bg-sky-500 text-white font-semibold text-xs transition shadow-md">
                        <i class="bi bi-plus-lg"></i> Ajouter un serveur
                    </a>
                </AuthorizeView>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs text-slate-300">
                    <thead class="bg-slate-900/80 text-slate-400 text-[10px] uppercase border-b border-slate-800">
                        <tr>
                            <th class="py-3 px-4 font-bold">Nom d'hôte</th>
                            <th class="py-3 px-4 font-bold">Adresse IP</th>
                            <th class="py-3 px-4 font-bold">Port WinRM</th>
                            <th class="py-3 px-4 font-bold">Statut</th>
                            <th class="py-3 px-4 font-bold">Description</th>
                            <th class="py-3 px-4 font-bold text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-800/60">
                        @foreach (var s in _serveurs)
                        {
                            <tr class="hover:bg-slate-800/40">
                                <td class="py-3.5 px-4 font-mono font-bold text-white">@s.HostName</td>
                                <td class="py-3.5 px-4 font-mono text-slate-400">@(s.IpAddress ?? "-")</td>
                                <td class="py-3.5 px-4 font-mono text-slate-300">@s.WinRmPort</td>
                                <td class="py-3.5 px-4"><StatutBadge Statut="s.Status" /></td>
                                <td class="py-3.5 px-4 text-slate-400">@s.Description</td>
                                <td class="py-3.5 px-4 text-right whitespace-nowrap">
                                    <a href="@($"/admin/serveurs/{s.Id}")"
                                       class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-sky-400 hover:text-sky-300 font-semibold text-xs transition">
                                        <i class="bi bi-broadcast"></i> Ouvrir et tester
                                    </a>
                                </td>
                            </tr>
                        }
                        @if (_serveurs.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="py-6 px-4 text-center text-slate-400">
                                    Aucun serveur déclaré. Cliquez sur <strong class="text-white">Ajouter un serveur</strong> ou importez votre fichier <code class="text-sky-400">Navis-Config.json</code>.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Components Table -->
        <div class="glass-card rounded-2xl border border-slate-800 overflow-hidden">
            <div class="p-5 border-b border-slate-800 flex items-center justify-between">
                <h3 class="text-sm font-bold text-white flex items-center gap-2">
                    <i class="bi bi-cpu-fill text-amber-400"></i>
                    Composants N4 (@_composants.Count)
                </h3>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs text-slate-300">
                    <thead class="bg-slate-900/80 text-slate-400 text-[10px] uppercase border-b border-slate-800">
                        <tr>
                            <th class="py-3 px-4 font-bold">Ordre</th>
                            <th class="py-3 px-4 font-bold">Nom logique</th>
                            <th class="py-3 px-4 font-bold">Rôle N4</th>
                            <th class="py-3 px-4 font-bold">Hôte</th>
                            <th class="py-3 px-4 font-bold">Service Windows</th>
                            <th class="py-3 px-4 font-bold">Preuve Log</th>
                            <th class="py-3 px-4 font-bold">Statut</th>
                            <th class="py-3 px-4 font-bold text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-800/60">
                        @foreach (var c in _composants)
                        {
                            <tr class="hover:bg-slate-800/40">
                                <td class="py-3.5 px-4 font-mono text-slate-400">@(c.StartOrder == 0 ? "-" : c.StartOrder.ToString())</td>
                                <td class="py-3.5 px-4 font-bold text-white">@c.LogicalName</td>
                                <td class="py-3.5 px-4 font-semibold text-sky-400">@c.Role</td>
                                <td class="py-3.5 px-4 font-mono text-slate-300">@(c.Server?.HostName ?? "-")</td>
                                <td class="py-3.5 px-4 font-mono text-slate-400 text-[11px]">@(c.WindowsServiceName ?? "-")</td>
                                <td class="py-3.5 px-4">
                                    @if (c.Readiness.IsProvable)
                                    {
                                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20" title="@c.Readiness.LogPath">Configurée</span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-500/10 text-amber-400 border border-amber-500/20">Absente</span>
                                    }
                                </td>
                                <td class="py-3.5 px-4"><StatutBadge Statut="c.Status" /></td>
                                <td class="py-3.5 px-4 text-right">
                                    <a href="@($"/admin/composants/{c.Id}")" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-sky-400 font-semibold text-[11px] transition">
                                        Éditer
                                    </a>
                                </td>
                            </tr>
                        }
                        @if (_composants.Count == 0)
                        {
                            <tr>
                                <td colspan="8" class="py-6 px-4 text-center text-slate-400">
                                    Aucun composant déclaré dans cet environnement.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private N4Environment? _env;
    private List<N4Server> _serveurs = [];
    private List<N4Component> _composants = [];

    private EnvironmentTestReport? _rapport;
    private bool _testEnCours;

    private bool _importOuvert;
    private bool _afficherStructureModele;
    private ImportReport? _rapportImport;

    private string? _messageStatut;
    private bool _statutEnErreur;

    private static readonly string _sampleJsonText = @"{
  ""_comment"": ""Fichier de configuration Navis N4 - modifiez librement sans toucher au code PowerShell. Ajoutez ou retirez autant d'entrees que necessaire dans ClusterNodes."",

  ""CenterNode"": ""N4CENTER01"",
  ""StandbyNode"": ""N4STANDBY01"",

  ""ClusterNodes"": [
    ""N4CLUSTER01"",
    ""N4CLUSTER02"",
    ""N4CLUSTER03""
  ],

  ""_bridgeXpsNote"": ""Bridge et XPS tournent sur le meme serveur physique dans cet environnement - c'est volontaire, les deux champs pointent vers le meme hote."",
  ""BridgeHost"": ""N4XPSBRIDGE01"",
  ""XPSHost"": ""N4XPSBRIDGE01"",
  ""ECN4Host"": ""N4ECN401"",

  ""ServiceNames"": {
    ""Center"": ""Navis N4 Center Node"",
    ""Cluster"": ""Navis N4 Cluster Node"",
    ""Standby"": ""Navis N4 Center Node"",
    ""Bridge"": ""Navis XPS Bridge Daemon"",
    ""XPS"": ""Navis XPS Service"",
    ""ECN4"": ""Navis ECN4 Daemon"",
    ""ECN4Web"": ""Navis ECN4web""
  },

  ""SharedFolder"": ""\\\\N4CLUSTER01\\NavisShared"",

  ""DatabaseHost"": ""N4DB01"",
  ""DatabasePort"": 1433,
  ""DatabaseEngine"": ""SQL Server"",
  ""_databaseNote"": ""Verification de connectivite reseau (port) uniquement. Toute investigation approfondie de la base de donnees (cluster actif, charge, requetes) reste du ressort du DBA."",

  ""LocalLogFolder"": ""C:\\NavisScripts\\Logs""
}";

    private static readonly string _sampleJsonDataUri =
        "data:application/json;charset=utf-8," + Uri.EscapeDataString(_sampleJsonText);

    private string _statutEnErreurClass => _statutEnErreur
        ? "bg-rose-500/10 text-rose-300 border-rose-500/20"
        : "bg-emerald-500/10 text-emerald-300 border-emerald-500/20";

    private string _rapportImportClass => _rapportImport?.Succeeded == true
        ? "bg-emerald-500/10 text-emerald-300 border-emerald-500/20"
        : "bg-rose-500/10 text-rose-300 border-rose-500/20";

    protected override async Task OnParametersSetAsync() => await Recharger();

    private async Task Recharger()
    {
        _env = await Referential.GetEnvironmentAsync(Id);
        if (_env is null) return;

        EnvState.Set(_env);

        _serveurs = await Referential.GetServersAsync(Id);
        _composants = await Referential.GetComponentsAsync(Id);
    }

    private async Task TesterConfiguration()
    {
        _testEnCours = true;
        _rapport = null;
        try
        {
            _rapport = await Tester.TestEnvironmentAsync(Id);
        }
        finally
        {
            _testEnCours = false;
        }
    }

    private async Task ChangerStatut(LifecycleStatus cible)
    {
        var erreur = await Referential.ChangeEnvironmentStatusAsync(Id, cible);
        _statutEnErreur = erreur is not null;
        _messageStatut = erreur ?? $"Statut porté à {cible}.";
        await Recharger();
    }

    private async Task ChargerFichier(InputFileChangeEventArgs e)
    {
        _rapportImport = null;
        var fichier = e.File;
        if (fichier is null) return;

        if (fichier.Size > 512 * 1024)
        {
            _rapportImport = new ImportReport();
            _rapportImport.Errors.Add("Fichier trop volumineux (512 Ko maximum).");
            return;
        }

        using var lecteur = new StreamReader(fichier.OpenReadStream(512 * 1024));
        var json = await lecteur.ReadToEndAsync();

        _rapportImport = await Importer.ImportAsync(Id, json);
        await Recharger();
    }
}
