@page "/admin/environnements/{Id:guid}"
@using Microsoft.AspNetCore.Authorization
@using N4Sentinel.Domain
@using N4Sentinel.Infrastructure.Connectivity
@using N4Sentinel.Infrastructure.Referential
@using N4Sentinel.Web.State
@attribute [Authorize(Policy = N4Policies.PeutConsulter)]
@rendermode InteractiveServer
@inject ReferentialService Referential
@inject ConnectivityTester Tester
@inject NavisConfigImporter Importer
@inject CurrentEnvironmentState EnvState

<PageTitle>@(_env?.Code ?? "Environnement") — N4 Sentinel</PageTitle>

@if (_env is null)
{
    <div class="glass-card p-8 rounded-2xl border border-slate-800 text-center text-slate-400 text-xs">
        <div class="inline-block w-6 h-6 border-2 border-sky-500 border-t-transparent rounded-full animate-spin mb-2"></div>
        <div>Chargement des détails de l'environnement...</div>
    </div>
}
else
{
    <div class="space-y-6">
        <!-- Header & Breadcrumb -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
                <a href="/admin/environnements" class="text-xs text-sky-400 hover:text-sky-300 transition flex items-center gap-1 mb-1">
                    <i class="bi bi-arrow-left"></i> Retour aux environnements
                </a>
                <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight flex items-center gap-3">
                    <span class="font-mono text-sky-400">@_env.Code</span>
                    <span>@_env.Name</span>
                    @if (_env.IsProduction)
                    {
                        <span class="px-2 py-0.5 rounded text-xs font-extrabold bg-rose-500/20 text-rose-400 border border-rose-500/30">PROD</span>
                    }
                </h1>
                <div class="flex items-center gap-3 text-xs text-slate-400 mt-1">
                    <StatutBadge Statut="_env.Status" />
                    <span>&middot; Type @_env.Kind</span>
                    <span>&middot; Criticité @_env.Criticality</span>
                    <span>&middot; @_env.TimeZoneId</span>
                </div>
            </div>

            <div class="flex flex-wrap items-center gap-2">
                <a href="@($"/admin/environnements/{Id}/mise-en-service")"
                   class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs shadow-lg shadow-emerald-600/20 transition inline-flex items-center gap-2">
                    <i class="bi bi-list-check"></i>
                    <span>Mise en service</span>
                </a>
                <button class="px-4 py-2 rounded-xl bg-sky-600 hover:bg-sky-500 text-white font-bold text-xs shadow-lg shadow-sky-600/20 transition disabled:opacity-50 inline-flex items-center gap-2" @onclick="TesterConfiguration" disabled="@_testEnCours">
                    <i class="bi bi-play-circle-fill"></i>
                    <span>@(_testEnCours ? "Test en cours..." : "Tester la configuration")</span>
                </button>
                <AuthorizeView Policy="@N4Policies.PeutAdministrerReferentiel">
                    <button class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-xs transition inline-flex items-center gap-2" @onclick="() => _importOuvert = !_importOuvert">
                        <i class="bi bi-file-earmark-arrow-up-fill"></i>
                        <span>Importer Navis-Config.json</span>
                    </button>
                </AuthorizeView>
            </div>
        </div>

        <!-- Validation Lifecycle Status Bar -->
        <AuthorizeView Policy="@N4Policies.PeutAdministrerReferentiel">
            @{ var transitions = ReferentialService.AllowedTransitions(_env.Status); }
            @if (transitions.Count > 0)
            {
                <div class="glass-card p-4 rounded-2xl border border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <div class="flex items-center gap-2 text-xs font-semibold text-slate-300">
                        <span>Évolution du cycle de vie :</span>
                        <div class="flex gap-2">
                            @foreach (var cible in transitions)
                            {
                                <button class="px-3 py-1 rounded-lg bg-sky-500/10 hover:bg-sky-500/20 text-sky-400 border border-sky-500/30 text-xs font-bold transition"
                                        @onclick="() => ChangerStatut(cible)">@cible</button>
                            }
                        </div>
                    </div>
                    @if (_env.Status != LifecycleStatus.Actif)
                    {
                        <span class="text-[11px] text-slate-400">
                            L'environnement doit être <strong class="text-white">Validé</strong> ou <strong class="text-white">Actif</strong> pour autoriser les opérations.
                        </span>
                    }
                </div>
            }
        </AuthorizeView>

        @if (_messageStatut is not null)
        {
            <div class="p-3.5 rounded-xl text-xs font-semibold border @_statutEnErreurClass">@_messageStatut</div>
        }

        <!-- Import Card -->
        @if (_importOuvert)
        {
            <div class="glass-card p-6 rounded-2xl border border-slate-700 space-y-4">
                <h3 class="text-sm font-bold text-white flex items-center gap-2">
                    <i class="bi bi-file-earmark-code-fill text-sky-400"></i>
                    Importer l'inventaire réel depuis Navis-Config.json
                </h3>
                <p class="text-xs text-slate-400 leading-relaxed">
                    Le fichier <code class="text-sky-400">Navis-Config.json</code> de vos scripts d'exploitation contient l'inventaire réel des hôtes, des services Windows, des chemins de logs et des marqueurs de démarrage.
                </p>
                
                <InputFile OnChange="ChargerFichier" class="block w-full text-xs text-slate-400 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-sky-600 file:text-white hover:file:bg-sky-500 cursor-pointer" accept=".json" />

                @if (_rapportImport is not null)
                {
                    <div class="p-4 rounded-xl text-xs space-y-2 border @_rapportImportClass">
                        <div class="font-bold">
                            @_rapportImport.ServersCreated serveur(s) créé(s), @_rapportImport.ComponentsCreated composant(s) créé(s).
                        </div>
                        @foreach (var e in _rapportImport.Errors)
                        {
                            <div class="text-rose-300">@e</div>
                        }
                    </div>
                }
            </div>
        }

        <!-- Test Report Section -->
        @if (_rapport is not null)
        {
            <div class="glass-card rounded-2xl border border-slate-800 overflow-hidden">
                <div class="p-5 border-b border-slate-800 flex items-center justify-between flex-wrap gap-2">
                    <h3 class="text-sm font-bold text-white flex items-center gap-2">
                        <i class="bi bi-shield-check text-emerald-400"></i>
                        Rapport de Test de Configuration
                    </h3>
                    <span class="text-xs font-mono text-slate-400">
                        @_rapport.Results.Count contrôle(s) en @_rapport.Duration.TotalSeconds.ToString("0.0") s
                    </span>
                </div>
                <div class="p-5 space-y-4">
                    <div class="flex flex-wrap gap-2 text-xs font-semibold">
                        <span class="px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">@_rapport.Satisfied satisfait(s)</span>
                        <span class="px-2.5 py-1 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20">@_rapport.Warnings avertissement(s)</span>
                        <span class="px-2.5 py-1 rounded-full bg-rose-500/10 text-rose-400 border border-rose-500/20">@_rapport.Blocking bloquant(s)</span>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-xs text-slate-300">
                            <thead class="bg-slate-900/80 text-slate-400 text-[10px] uppercase border-b border-slate-800">
                                <tr>
                                    <th class="py-2.5 px-3">Cible</th>
                                    <th class="py-2.5 px-3">Contrôle</th>
                                    <th class="py-2.5 px-3">Résultat</th>
                                    <th class="py-2.5 px-3">Détail</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-800/60">
                                @foreach (var r in _rapport.Results)
                                {
                                    <tr class="hover:bg-slate-800/40">
                                        <td class="py-3 px-3 font-mono text-white font-bold">@r.Target</td>
                                        <td class="py-3 px-3 font-semibold">@r.CheckName</td>
                                        <td class="py-3 px-3">
                                            <span class="px-2 py-0.5 rounded text-[10px] font-bold @ClasseOutcome(r.Outcome)">@LibelleOutcome(r.Outcome)</span>
                                        </td>
                                        <td class="py-3 px-3 text-slate-300">@r.Message</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        <!-- Servers Table -->
        <div class="glass-card rounded-2xl border border-slate-800 overflow-hidden">
            <div class="p-5 border-b border-slate-800 flex items-center justify-between">
                <h3 class="text-sm font-bold text-white flex items-center gap-2">
                    <i class="bi bi-server text-sky-400"></i>
                    Serveurs Nœuds (@_serveurs.Count)
                </h3>
                <AuthorizeView Policy="@N4Policies.PeutAdministrerReferentiel">
                    <a href="@($"/admin/environnements/{Id}/serveurs/nouveau")"
                       class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-sky-600 hover:bg-sky-500 text-white font-semibold text-xs transition">
                        <i class="bi bi-plus-lg"></i> Ajouter un serveur
                    </a>
                </AuthorizeView>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs text-slate-300">
                    <thead class="bg-slate-900/80 text-slate-400 text-[10px] uppercase border-b border-slate-800">
                        <tr>
                            <th class="py-3 px-4 font-bold">Nom d'hôte</th>
                            <th class="py-3 px-4 font-bold">Adresse IP</th>
                            <th class="py-3 px-4 font-bold">Port WinRM</th>
                            <th class="py-3 px-4 font-bold">Statut</th>
                            <th class="py-3 px-4 font-bold">Description</th>
                            <th class="py-3 px-4 font-bold text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-800/60">
                        @foreach (var s in _serveurs)
                        {
                            <tr class="hover:bg-slate-800/40">
                                <td class="py-3.5 px-4 font-mono font-bold text-white">@s.HostName</td>
                                <td class="py-3.5 px-4 font-mono text-slate-400">@(s.IpAddress ?? "-")</td>
                                <td class="py-3.5 px-4 font-mono text-slate-300">@s.WinRmPort</td>
                                <td class="py-3.5 px-4"><StatutBadge Statut="s.Status" /></td>
                                <td class="py-3.5 px-4 text-slate-400">@s.Description</td>
                                <td class="py-3.5 px-4 text-right whitespace-nowrap">
                                    <a href="@($"/admin/serveurs/{s.Id}")"
                                       class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-sky-400 hover:text-sky-300 font-semibold text-xs transition">
                                        <i class="bi bi-broadcast"></i> Ouvrir et tester
                                    </a>
                                </td>
                            </tr>
                        }
                        @if (_serveurs.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="py-6 px-4 text-center text-slate-400">
                                    Aucun serveur déclaré. Ajoutez-en un, ou importez l'inventaire depuis
                                    <code class="text-sky-400">Navis-Config.json</code>.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Components Table -->
        <div class="glass-card rounded-2xl border border-slate-800 overflow-hidden">
            <div class="p-5 border-b border-slate-800 flex items-center justify-between">
                <h3 class="text-sm font-bold text-white flex items-center gap-2">
                    <i class="bi bi-cpu-fill text-amber-400"></i>
                    Composants N4 (@_composants.Count)
                </h3>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs text-slate-300">
                    <thead class="bg-slate-900/80 text-slate-400 text-[10px] uppercase border-b border-slate-800">
                        <tr>
                            <th class="py-3 px-4 font-bold">Ordre</th>
                            <th class="py-3 px-4 font-bold">Nom logique</th>
                            <th class="py-3 px-4 font-bold">Rôle N4</th>
                            <th class="py-3 px-4 font-bold">Hôte</th>
                            <th class="py-3 px-4 font-bold">Service Windows</th>
                            <th class="py-3 px-4 font-bold">Preuve Log</th>
                            <th class="py-3 px-4 font-bold">Statut</th>
                            <th class="py-3 px-4 font-bold text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-800/60">
                        @foreach (var c in _composants)
                        {
                            <tr class="hover:bg-slate-800/40">
                                <td class="py-3.5 px-4 font-mono text-slate-400">@(c.StartOrder == 0 ? "-" : c.StartOrder.ToString())</td>
                                <td class="py-3.5 px-4 font-bold text-white">@c.LogicalName</td>
                                <td class="py-3.5 px-4 font-semibold text-sky-400">@c.Role</td>
                                <td class="py-3.5 px-4 font-mono text-slate-300">@(c.Server?.HostName ?? "-")</td>
                                <td class="py-3.5 px-4 font-mono text-slate-400 text-[11px]">@(c.WindowsServiceName ?? "-")</td>
                                <td class="py-3.5 px-4">
                                    @if (c.Readiness.IsProvable)
                                    {
                                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20" title="@c.Readiness.LogPath">Configurée</span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-500/10 text-amber-400 border border-amber-500/20">Absente</span>
                                    }
                                </td>
                                <td class="py-3.5 px-4"><StatutBadge Statut="c.Status" /></td>
                                <td class="py-3.5 px-4 text-right">
                                    <a href="@($"/admin/composants/{c.Id}")" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-sky-400 font-semibold text-[11px] transition">
                                        Éditer
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private N4Environment? _env;
    private List<N4Server> _serveurs = [];
    private List<N4Component> _composants = [];

    private EnvironmentTestReport? _rapport;
    private bool _testEnCours;

    private bool _importOuvert;
    private ImportReport? _rapportImport;

    private string? _messageStatut;
    private bool _statutEnErreur;

    private string _statutEnErreurClass => _statutEnErreur
        ? "bg-rose-500/10 text-rose-300 border-rose-500/20"
        : "bg-emerald-500/10 text-emerald-300 border-emerald-500/20";

    private string _rapportImportClass => _rapportImport?.Succeeded == true
        ? "bg-emerald-500/10 text-emerald-300 border-emerald-500/20"
        : "bg-rose-500/10 text-rose-300 border-rose-500/20";

    protected override async Task OnParametersSetAsync() => await Recharger();

    private async Task Recharger()
    {
        _env = await Referential.GetEnvironmentAsync(Id);
        if (_env is null) return;

        // Rend l'environnement courant visible en permanence dans l'en-tete,
        // et fait apparaitre l'avertissement Production le cas echeant (SEC-004).
        EnvState.Set(_env);

        _serveurs = await Referential.GetServersAsync(Id);
        _composants = await Referential.GetComponentsAsync(Id);
    }

    private async Task TesterConfiguration()
    {
        _testEnCours = true;
        _rapport = null;
        try
        {
            _rapport = await Tester.TestEnvironmentAsync(Id);
        }
        finally
        {
            _testEnCours = false;
        }
    }

    private async Task ChangerStatut(LifecycleStatus cible)
    {
        var erreur = await Referential.ChangeEnvironmentStatusAsync(Id, cible);
        _statutEnErreur = erreur is not null;
        _messageStatut = erreur ?? $"Statut porté à {cible}.";
        await Recharger();
    }

    private async Task ChargerFichier(InputFileChangeEventArgs e)
    {
        _rapportImport = null;
        var fichier = e.File;
        if (fichier is null) return;

        if (fichier.Size > 512 * 1024)
        {
            _rapportImport = new ImportReport();
            _rapportImport.Errors.Add("Fichier trop volumineux (512 Ko maximum).");
            return;
        }

        using var lecteur = new StreamReader(fichier.OpenReadStream(512 * 1024));
        var json = await lecteur.ReadToEndAsync();

        _rapportImport = await Importer.ImportAsync(Id, json);
        await Recharger();
    }

    private static string ClasseOutcome(CheckOutcome o) => o switch
    {
        CheckOutcome.Satisfait => "bg-emerald-500/10 text-emerald-400 border border-emerald-500/20",
        CheckOutcome.Avertissement => "bg-amber-500/10 text-amber-400 border border-amber-500/20",
        CheckOutcome.Bloquant => "bg-rose-500/10 text-rose-400 border border-rose-500/20",
        _ => "bg-slate-500/10 text-slate-400 border border-slate-500/20"
    };

    private static string LibelleOutcome(CheckOutcome o) => o switch
    {
        CheckOutcome.Satisfait => "Satisfait",
        CheckOutcome.Avertissement => "Avertissement",
        CheckOutcome.Bloquant => "Bloquant",
        CheckOutcome.NonApplicable => "N/A",
        _ => "Non vérifiable"
    };
}
