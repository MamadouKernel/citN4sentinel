@page "/admin/environnements/{Id:guid}/mise-en-service"
@using Microsoft.AspNetCore.Authorization
@using N4Sentinel.Domain
@using N4Sentinel.Infrastructure.Referential
@attribute [Authorize(Policy = N4Policies.PeutConsulter)]
@rendermode InteractiveServer
@inject CommissioningStatus Commissioning

<PageTitle>Mise en service — @(_r?.EnvironmentCode ?? "")</PageTitle>

@if (_r is null)
{
    <div class="glass-card p-8 rounded-2xl border border-slate-800 text-center text-slate-400 text-xs">
        <div class="inline-block w-6 h-6 border-2 border-sky-500 border-t-transparent rounded-full animate-spin mb-2"></div>
        <div>Évaluation de l'avancement...</div>
    </div>
}
else
{
    <div class="space-y-6">

        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
            <div>
                <a href="@($"/admin/environnements/{Id}")" class="text-xs text-sky-400 hover:text-sky-300 transition flex items-center gap-1 mb-1">
                    <i class="bi bi-arrow-left"></i> Retour à l'environnement
                </a>
                <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight flex items-center gap-3">
                    Mise en service
                    <span class="font-mono text-sky-400">@_r.EnvironmentCode</span>
                    @if (_r.IsProduction)
                    {
                        <span class="px-2 py-0.5 rounded text-xs font-extrabold bg-rose-500/20 text-rose-400 border border-rose-500/30">PROD</span>
                    }
                </h1>
                <p class="text-xs text-slate-400 mt-1 max-w-2xl leading-relaxed">
                    L'avancement est recalculé à chaque affichage depuis le référentiel. Rien n'est coché
                    à la main : une case qu'on remplit soi-même finit toujours par mentir.
                </p>
            </div>

            <button class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-xs transition inline-flex items-center gap-2"
                    @onclick="Recharger">
                <i class="bi bi-arrow-clockwise"></i> Réévaluer
            </button>
        </div>

        <!-- Progression -->
        <div class="glass-card rounded-2xl border border-slate-800 p-6 space-y-4">
            <div class="flex items-end justify-between gap-4 flex-wrap">
                <div>
                    <div class="text-3xl font-extrabold text-white font-mono">@_r.Done<span class="text-slate-500">/@_r.Total</span></div>
                    <div class="text-xs text-slate-400 mt-0.5">étapes terminées</div>
                </div>
                @if (_r.Blocking > 0)
                {
                    <span class="px-3 py-1.5 rounded-full text-xs font-bold bg-rose-500/10 text-rose-400 border border-rose-500/25">
                        @_r.Blocking point(s) bloquant(s)
                    </span>
                }
                else if (_r.Done == _r.Total)
                {
                    <span class="px-3 py-1.5 rounded-full text-xs font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/25">
                        Environnement opérationnel
                    </span>
                }
            </div>

            <div class="h-2 rounded-full bg-slate-800 overflow-hidden">
                <div class="h-full transition-all duration-500 @(_r.Blocking > 0 ? "bg-rose-500" : "bg-emerald-500")"
                     style="width:@_r.PercentComplete%"></div>
            </div>

            @if (_r.NextStep is { } suivante)
            {
                <div class="p-3.5 rounded-xl bg-sky-500/10 border border-sky-500/20 flex items-start justify-between gap-3 flex-wrap">
                    <div class="text-xs">
                        <div class="font-bold text-sky-300">Prochaine étape — @suivante.Title</div>
                        <div class="text-slate-300 mt-0.5">@suivante.Detail</div>
                    </div>
                    @if (suivante.Link is not null)
                    {
                        <a href="@suivante.Link" class="px-3 py-1.5 rounded-lg bg-sky-600 hover:bg-sky-500 text-white font-semibold text-xs transition whitespace-nowrap">
                            Y aller
                        </a>
                    }
                </div>
            }
        </div>

        <!-- Étapes -->
        <div class="space-y-2">
            @foreach (var e in _r.Steps)
            {
                <div class="glass-card rounded-2xl border p-5 @BordureEtape(e.State)">
                    <div class="flex items-start gap-4">
                        <div class="w-8 h-8 rounded-xl flex items-center justify-center font-bold text-xs flex-shrink-0 @PastilleEtape(e.State)">
                            @if (e.State == StepState.Fait)
                            {
                                <i class="bi bi-check-lg"></i>
                            }
                            else if (e.State == StepState.Bloquant)
                            {
                                <i class="bi bi-exclamation-lg"></i>
                            }
                            else
                            {
                                @e.Number
                            }
                        </div>

                        <div class="flex-1 min-w-0">
                            <div class="flex items-center justify-between gap-3 flex-wrap">
                                <h3 class="text-sm font-bold text-white">@e.Title</h3>
                                <span class="px-2 py-0.5 rounded text-[10px] font-bold whitespace-nowrap @PastilleEtape(e.State)">
                                    @LibelleEtat(e.State)
                                </span>
                            </div>
                            <p class="text-xs text-slate-400 mt-1">@e.Detail</p>
                            @if (e.Hint is not null)
                            {
                                <p class="text-[11px] text-slate-500 mt-1.5 leading-relaxed">@e.Hint</p>
                            }
                        </div>

                        @if (e.Link is not null && e.State != StepState.Fait)
                        {
                            <a href="@e.Link" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-sky-400 font-semibold text-xs transition whitespace-nowrap flex-shrink-0">
                                Ouvrir
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private CommissioningReport? _r;

    protected override async Task OnParametersSetAsync() => await Recharger();

    private async Task Recharger() => _r = await Commissioning.EvaluateAsync(Id);

    private static string BordureEtape(StepState s) => s switch
    {
        StepState.Fait => "border-emerald-500/20",
        StepState.Bloquant => "border-rose-500/30",
        StepState.Avertissement => "border-amber-500/25",
        _ => "border-slate-800"
    };

    private static string PastilleEtape(StepState s) => s switch
    {
        StepState.Fait => "bg-emerald-500/15 text-emerald-400 border border-emerald-500/25",
        StepState.Bloquant => "bg-rose-500/15 text-rose-400 border border-rose-500/25",
        StepState.Avertissement => "bg-amber-500/15 text-amber-400 border border-amber-500/25",
        _ => "bg-slate-800 text-slate-400 border border-slate-700"
    };

    private static string LibelleEtat(StepState s) => s switch
    {
        StepState.Fait => "Terminé",
        StepState.Bloquant => "Bloquant",
        StepState.Avertissement => "À vérifier",
        _ => "À faire"
    };
}
