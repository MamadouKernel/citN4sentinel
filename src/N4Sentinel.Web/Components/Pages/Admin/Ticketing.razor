@page "/admin/tickets"
@using Microsoft.AspNetCore.Authorization
@using N4Sentinel.Domain
@using N4Sentinel.Infrastructure.Ticketing
@using N4Sentinel.Infrastructure.Referential
@attribute [Authorize(Policy = N4Policies.PeutExecuterActionsSensibles)]
@rendermode InteractiveServer
@inject TicketingService Tickets
@inject ReferentialService Referential
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Tickets d'incidents — N4 Sentinel</PageTitle>

<div class="space-y-5">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
        <div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Tickets d'incidents</h1>
            <p class="text-xs text-slate-400 mt-1 max-w-3xl leading-relaxed">
                S3-09. Suivi des tickets ouverts manuellement par l'exploitation ou automatiquement par le diagnostic P1,
                les APR ou le moniteur EDI. En V1, aucun envoi vers l'outil DSI n'est réalisé : remplir
                <em>External ID</em> après création dans ServiceNow / Jira / GLPI.
            </p>
        </div>
        <AuthorizeView Roles="@($"{N4Roles.AdministrateurN4},{N4Roles.OperateurN4},{N4Roles.AdministrateurSolution}")">
            <button class="btn-theme-primary text-xs px-4 py-2 rounded-xl font-bold shadow-lg shadow-purple-600/15" @onclick="OuvrirCreation">
                <i class="bi bi-plus-lg mr-1"></i> Nouveau ticket
            </button>
        </AuthorizeView>
    </div>

    @* Filtres *@
    <div class="glass-card rounded-2xl border border-slate-800 p-4 grid grid-cols-1 md:grid-cols-4 gap-3 items-end">
        <div>
            <label class="block text-[11px] text-slate-400 font-bold mb-1">Statut</label>
            <select class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white" @bind="_filtreStatut">
                <option value="">(tous)</option>
                <option value="@TicketStatus.Nouveau">Nouveau</option>
                <option value="@TicketStatus.EnCours">En cours</option>
                <option value="@TicketStatus.EnAttenteFournisseur">En attente fournisseur</option>
                <option value="@TicketStatus.Resolu">Résolu</option>
                <option value="@TicketStatus.Ferme">Fermé</option>
                <option value="@TicketStatus.Annule">Annulé</option>
            </select>
        </div>
        <div>
            <label class="block text-[11px] text-slate-400 font-bold mb-1">Priorité</label>
            <select class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white" @bind="_filtrePriorite">
                <option value="">(toutes)</option>
                <option value="@TicketPriority.P1Critique">P1 Critique</option>
                <option value="@TicketPriority.P2Majeur">P2 Majeur</option>
                <option value="@TicketPriority.P3Normal">P3 Normal</option>
                <option value="@TicketPriority.P4Mineur">P4 Mineur</option>
                <option value="@TicketPriority.P5Information">P5 Information</option>
            </select>
        </div>
        <div>
            <label class="block text-[11px] text-slate-400 font-bold mb-1">Environnement</label>
            <select class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white" @bind="_filtreEnvId">
                <option value="">(tous)</option>
                @if (_envs is not null)
                {
                    @foreach (var env in _envs)
                    {
                        <option value="@env.Id">@env.Code — @env.Name</option>
                    }
                }
            </select>
        </div>
        <div class="flex gap-2">
            <button class="btn-theme-secondary text-xs px-4 py-2 rounded-xl font-bold" @onclick="Recharger">
                <i class="bi bi-arrow-clockwise mr-1"></i> Recharger
            </button>
        </div>
    </div>

    @* Table *@
    @if (_tickets is null)
    {
        <div class="text-xs text-slate-400">Chargement des tickets…</div>
    }
    else if (_tickets.Count == 0)
    {
        <div class="p-6 rounded-2xl glass-card border border-slate-800 text-xs text-slate-400 text-center italic">
            Aucun ticket ne correspond aux filtres.
        </div>
    }
    else
    {
        <div class="glass-card rounded-2xl border border-slate-800 overflow-hidden">
            <table class="w-full text-xs">
                <thead class="bg-slate-900/60 text-slate-400 uppercase tracking-wide text-[10.5px]">
                    <tr>
                        <th class="text-left px-4 py-2.5">Code</th>
                        <th class="text-left px-4 py-2.5">Titre</th>
                        <th class="text-left px-4 py-2.5">Statut</th>
                        <th class="text-left px-4 py-2.5">Priorité / Sévérité</th>
                        <th class="text-left px-4 py-2.5">Origine</th>
                        <th class="text-left px-4 py-2.5">Assigné</th>
                        <th class="text-right px-4 py-2.5">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in _tickets)
                    {
                        <tr class="border-t border-slate-800 hover:bg-slate-900/30 transition">
                            <td class="px-4 py-3 font-mono text-sky-400">@t.Code</td>
                            <td class="px-4 py-3 text-slate-200 max-w-md truncate">
                                <div class="font-semibold truncate">@t.Title</div>
                                <div class="text-[10px] text-slate-500 mt-0.5 truncate">@t.Description</div>
                            </td>
                            <td class="px-4 py-3">
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold @BadgeStatutClasse(t.Status)">
                                    @t.Status
                                </span>
                            </td>
                            <td class="px-4 py-3">
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold @BadgePrioriteClasse(t.Priority)">
                                    @BadgePrioriteTexte(t.Priority)
                                </span>
                                <span class="ml-1.5 text-[10px] text-slate-500">@t.Severity</span>
                            </td>
                            <td class="px-4 py-3 text-slate-300">@t.Source</td>
                            <td class="px-4 py-3 text-slate-300 truncate max-w-[140px]">@(t.AssignedTo ?? "(non assigné)")</td>
                            <td class="px-4 py-3 text-right whitespace-nowrap">
                                <button class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-purple-300 hover:text-purple-200 text-[11px] font-bold"
                                        @onclick="() => OuvrirDetail(t)">
                                    Détails
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@* Modale Création *@
@if (_showCreation)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-md">
        <div class="w-full max-w-2xl rounded-2xl bg-slate-900 border border-slate-800 shadow-2xl p-6 space-y-4">
            <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                <h3 class="text-sm font-bold text-white">Nouveau ticket manuel</h3>
                <button @onclick="() => _showCreation = false" class="text-slate-400 hover:text-white transition"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs">
                <div class="md:col-span-2">
                    <label class="block text-slate-400 font-bold mb-1">Titre</label>
                    <input class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-white" @bind="_nouveauTitre" placeholder="Résumé en une ligne…" />
                </div>
                <div>
                    <label class="block text-slate-400 font-bold mb-1">Priorité</label>
                    <select class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-white" @bind="_nouvellePriorite">
                        <option value="@TicketPriority.P1Critique">P1 Critique</option>
                        <option value="@TicketPriority.P2Majeur">P2 Majeur</option>
                        <option value="@TicketPriority.P3Normal">P3 Normal</option>
                        <option value="@TicketPriority.P4Mineur">P4 Mineur</option>
                        <option value="@TicketPriority.P5Information">P5 Information</option>
                    </select>
                </div>
                <div>
                    <label class="block text-slate-400 font-bold mb-1">Sévérité</label>
                    <select class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-white" @bind="_nouvelleSeverite">
                        <option value="@TicketSeverity.Critique">Critique</option>
                        <option value="@TicketSeverity.Majeur">Majeur</option>
                        <option value="@TicketSeverity.Mineur">Mineur</option>
                        <option value="@TicketSeverity.Informatif">Informatif</option>
                    </select>
                </div>
                <div>
                    <label class="block text-slate-400 font-bold mb-1">Environnement</label>
                    <select class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-white" @bind="_nouvelEnvId">
                        <option value="">(sans environnement)</option>
                        @if (_envs is not null)
                        {
                            @foreach (var env in _envs)
                            {
                                <option value="@env.Id">@env.Code</option>
                            }
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-slate-400 font-bold mb-1">Assigné à</label>
                    <input class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-white" @bind="_nouvelAssigne" placeholder="nom.prenom ou équipe" />
                </div>
                <div class="md:col-span-2">
                    <label class="block text-slate-400 font-bold mb-1">Description détaillée</label>
                    <textarea rows="4" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-white"
                              placeholder="Contexte, états constatés, impact, hypothèses…"
                              @bind="_nouvelleDescription"></textarea>
                </div>
            </div>

            @if (_erreur is not null)
            {
                <div class="p-3 rounded-lg bg-rose-500/10 border border-rose-500/20 text-rose-300 text-[11px] font-semibold">@_erreur</div>
            }

            <div class="flex justify-end gap-2 pt-2">
                <button class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-bold transition"
                        @onclick="() => _showCreation = false">
                    Annuler
                </button>
                <button class="px-4 py-2 rounded-xl btn-theme-primary text-white text-xs font-bold transition disabled:opacity-40"
                        @onclick="CreerTicket" disabled="@_enCours">
                    @(_enCours ? "Création…" : "Créer le ticket")
                </button>
            </div>
        </div>
    </div>
}

@* Modale Détail *@
@if (_ticket is not null)
{
    <div class="fixed inset-0 z-50 flex items-start justify-center p-4 bg-slate-950/80 backdrop-blur-md overflow-auto">
        <div class="w-full max-w-3xl rounded-2xl bg-slate-900 border border-slate-800 shadow-2xl p-6 space-y-5 my-6">
            <div class="flex items-start justify-between gap-3">
                <div>
                    <div class="flex items-center gap-2 flex-wrap">
                        <h3 class="text-sm font-extrabold text-white">@_ticket.Code — @_ticket.Title</h3>
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold @BadgeStatutClasse(_ticket.Status)">@_ticket.Status</span>
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold @BadgePrioriteClasse(_ticket.Priority)">@BadgePrioriteTexte(_ticket.Priority)</span>
                    </div>
                    <div class="text-[10.5px] text-slate-400 mt-1">
                        Ouvert le @_ticket.OpenedAt.ToString("dd/MM/yyyy HH:mm") UTC — origine @_ticket.Source.
                    </div>
                </div>
                <button @onclick="FermerDetail" class="text-slate-400 hover:text-white transition"><i class="bi bi-x-lg"></i></button>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-[11px]">
                <div class="p-3 rounded-xl bg-slate-800/40 border border-slate-700 space-y-1.5">
                    <div><span class="text-slate-400 font-bold">Sévérité :</span> @_ticket.Severity</div>
                    <div><span class="text-slate-400 font-bold">Assigné à :</span> @(_ticket.AssignedTo ?? "—")</div>
                    <div><span class="text-slate-400 font-bold">ID externe (DSI) :</span>
                        <div class="mt-1 flex gap-2">
                            <input class="flex-1 bg-slate-950 border border-slate-700 rounded px-2 py-1 text-slate-100 font-mono"
                                   value="@_ticket.ExternalTicketId"
                                   @onchange="@(e => _ticket.ExternalTicketId = e.Value?.ToString())" />
                            <button class="px-2 py-0.5 rounded btn-theme-secondary font-bold" @onclick="SauverExternalId">MàJ</button>
                        </div>
                    </div>
                    <div><span class="text-slate-400 font-bold">Clos le :</span> @(_ticket.ClosedAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")</div>
                </div>
                <div class="p-3 rounded-xl bg-slate-800/40 border border-slate-700 space-y-1.5">
                    <div><span class="text-slate-400 font-bold mb-1 block">Changement de statut</span></div>
                    <div class="flex items-center gap-2 flex-wrap">
                        <select class="flex-1 bg-slate-950 border border-slate-700 rounded px-2 py-1 text-slate-100" @bind="_nouveauStatut">
                            <option value="@TicketStatus.Nouveau">Nouveau</option>
                            <option value="@TicketStatus.EnCours">En cours</option>
                            <option value="@TicketStatus.EnAttenteFournisseur">En attente fournisseur</option>
                            <option value="@TicketStatus.Resolu">Résolu</option>
                            <option value="@TicketStatus.Ferme">Fermé</option>
                            <option value="@TicketStatus.Annule">Annulé</option>
                        </select>
                        <button class="px-3 py-1 rounded btn-theme-primary font-bold" @onclick="AppliquerChangementStatut">
                            Appliquer
                        </button>
                    </div>
                </div>
            </div>

            <div class="p-3 rounded-xl bg-slate-800/30 border border-slate-700 text-[11px] text-slate-300 whitespace-pre-wrap">@_ticket.Description</div>

            <div class="space-y-2">
                <div class="flex items-center justify-between">
                    <div class="text-slate-200 font-bold text-sm">Commentaires</div>
                    <div class="text-[10.5px] text-slate-400">@_ticket.Comments.Count entrée(s)</div>
                </div>

                @if (_ticket.Comments.Count == 0)
                {
                    <div class="text-[10.5px] text-slate-500 italic">Aucun commentaire.</div>
                }
                else
                {
                    @foreach (var c in _ticket.Comments)
                    {
                        <div class="p-3 rounded-xl @(c.IsInternal ? "bg-amber-500/5 border-amber-500/20" : "bg-slate-800/30 border-slate-700") border">
                            <div class="flex items-center justify-between text-[10.5px] mb-1.5">
                                <div>
                                    <span class="font-bold text-slate-100">@c.Author</span>
                                    @if (c.IsInternal)
                                    {
                                        <span class="ml-1.5 px-1.5 py-0.5 rounded text-[9px] font-bold bg-amber-500/15 text-amber-300 border border-amber-500/30 uppercase">Interne</span>
                                    }
                                    <span class="text-slate-500 ml-2 font-mono">@c.WrittenAt.ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                            </div>
                            <div class="text-[11px] text-slate-300 whitespace-pre-wrap">@c.Text</div>
                        </div>
                    }
                }

                <div class="mt-3 p-3 rounded-xl bg-slate-800/40 border border-slate-700 space-y-2">
                    <textarea rows="2" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-white text-[11px] placeholder-slate-500"
                              placeholder="Votre commentaire…"
                              @bind="_nouveauCommentaireTexte"></textarea>
                    <div class="flex items-center justify-between gap-2 flex-wrap">
                        <label class="flex items-center gap-2 text-[10.5px] text-slate-300 cursor-pointer">
                            <input type="checkbox" class="rounded" @bind="_nouveauCommentaireInterne" />
                            Commentaire interne (équipe DSI uniquement)
                        </label>
                        <button class="px-3 py-1 rounded btn-theme-primary text-[11px] font-bold disabled:opacity-40"
                                disabled="@(string.IsNullOrWhiteSpace(_nouveauCommentaireTexte))"
                                @onclick="AjouterCommentaire">
                            Ajouter le commentaire
                        </button>
                    </div>
                </div>
            </div>

            @if (_erreur is not null)
            {
                <div class="p-3 rounded-lg bg-rose-500/10 border border-rose-500/20 text-rose-300 text-[11px] font-semibold">@_erreur</div>
            }
            @if (_succes is not null)
            {
                <div class="p-3 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-300 text-[11px] font-semibold">@_succes</div>
            }
        </div>
    </div>
}

@code {
    private List<Ticket>? _tickets;
    private List<N4Environment>? _envs;
    private TicketStatus? _filtreStatut;
    private TicketPriority? _filtrePriorite;
    private string? _filtreEnvId;

    private Ticket? _ticket;
    private bool _showCreation;
    private bool _enCours;
    private string? _erreur;
    private string? _succes;

    // création
    private string _nouveauTitre = string.Empty;
    private string _nouvelleDescription = string.Empty;
    private TicketPriority _nouvellePriorite = TicketPriority.P3Normal;
    private TicketSeverity _nouvelleSeverite = TicketSeverity.Mineur;
    private string? _nouvelEnvId;
    private string _nouvelAssigne = string.Empty;

    // modif
    private TicketStatus _nouveauStatut = TicketStatus.Nouveau;
    private string _nouveauCommentaireTexte = string.Empty;
    private bool _nouveauCommentaireInterne = true;

    protected override async Task OnInitializedAsync()
    {
        _envs = await Referential.GetEnvironmentsAsync();
        await Recharger();
    }

    private async Task Recharger()
    {
        var envId = string.IsNullOrWhiteSpace(_filtreEnvId) ? default : Guid.Parse(_filtreEnvId);
        _tickets = await Tickets.ListAsync(_filtreStatut, _filtrePriorite,
            envId == default ? null : envId);
    }

    private static string BadgeStatutClasse(TicketStatus s) => s switch
    {
        TicketStatus.Nouveau => "bg-slate-500/10 text-slate-300 border border-slate-500/30",
        TicketStatus.EnCours => "bg-sky-500/10 text-sky-300 border border-sky-500/30",
        TicketStatus.EnAttenteFournisseur => "bg-purple-500/10 text-purple-300 border border-purple-500/30",
        TicketStatus.Resolu => "bg-emerald-500/10 text-emerald-300 border border-emerald-500/30",
        TicketStatus.Ferme => "bg-slate-800 text-slate-400 border border-slate-700",
        TicketStatus.Annule => "bg-slate-800 text-slate-500 border border-slate-700",
        _ => "bg-slate-700 text-slate-300"
    };

    private static string BadgePrioriteClasse(TicketPriority p) => p switch
    {
        TicketPriority.P1Critique => "bg-rose-500/15 text-rose-300 border border-rose-500/30",
        TicketPriority.P2Majeur => "bg-orange-500/15 text-orange-300 border border-orange-500/30",
        TicketPriority.P3Normal => "bg-sky-500/15 text-sky-300 border border-sky-500/30",
        TicketPriority.P4Mineur => "bg-slate-500/15 text-slate-300 border border-slate-500/30",
        TicketPriority.P5Information => "bg-slate-800 text-slate-300 border border-slate-700",
        _ => "bg-slate-700 text-slate-300"
    };

    private static string BadgePrioriteTexte(TicketPriority p) => p switch
    {
        TicketPriority.P1Critique => "P1 CRITIQUE",
        TicketPriority.P2Majeur => "P2 MAJEUR",
        TicketPriority.P3Normal => "P3 NORMAL",
        TicketPriority.P4Mineur => "P4 MINEUR",
        TicketPriority.P5Information => "P5 INFO",
        _ => p.ToString()
    };

    private void OuvrirCreation()
    {
        _erreur = null;
        _succes = null;
        _nouveauTitre = string.Empty;
        _nouvelleDescription = string.Empty;
        _nouvellePriorite = TicketPriority.P3Normal;
        _nouvelleSeverite = TicketSeverity.Mineur;
        _nouvelEnvId = null;
        _nouvelAssigne = string.Empty;
        _showCreation = true;
    }

    private async Task CreerTicket()
    {
        _enCours = true;
        _erreur = null;
        try
        {
            var etat = await AuthProvider.GetAuthenticationStateAsync();
            var acteur = etat.User.Identity?.Name ?? "inconnu";
            Guid? envGuid = string.IsNullOrWhiteSpace(_nouvelEnvId) ? null : Guid.Parse(_nouvelEnvId);
            var (t, err) = await Tickets.OuvrirManuelAsync(
                acteur, _nouveauTitre, _nouvelleDescription,
                _nouvellePriorite, _nouvelleSeverite, envGuid,
                string.IsNullOrWhiteSpace(_nouvelAssigne) ? null : _nouvelAssigne);
            if (err is not null) { _erreur = err; return; }
            _showCreation = false;
            await Recharger();
        }
        finally
        {
            _enCours = false;
        }
    }

    private void OuvrirDetail(Ticket t)
    {
        _erreur = null;
        _succes = null;
        _ticket = t;
        _nouveauStatut = t.Status;
        _nouveauCommentaireTexte = string.Empty;
        _nouveauCommentaireInterne = true;
    }

    private void FermerDetail()
    {
        _ticket = null;
        _erreur = null;
        _succes = null;
    }

    private async Task SauverExternalId()
    {
        if (_ticket is null) return;
        var etat = await AuthProvider.GetAuthenticationStateAsync();
        var acteur = etat.User.Identity?.Name ?? "inconnu";
        _erreur = await Tickets.DefinirIdExterneAsync(_ticket.Id, _ticket.ExternalTicketId, acteur);
        _succes = _erreur is null ? "Identifiant externe mis à jour." : null;
    }

    private async Task AppliquerChangementStatut()
    {
        if (_ticket is null) return;
        var etat = await AuthProvider.GetAuthenticationStateAsync();
        var acteur = etat.User.Identity?.Name ?? "inconnu";
        _erreur = await Tickets.MettreAJourStatutAsync(_ticket.Id, _nouveauStatut, acteur);
        if (_erreur is null)
        {
            _ticket = await Tickets.GetByIdAsync(_ticket.Id);
            if (_ticket is not null) _nouveauStatut = _ticket.Status;
            _succes = "Statut mis à jour.";
            await Recharger();
        }
    }

    private async Task AjouterCommentaire()
    {
        if (_ticket is null || string.IsNullOrWhiteSpace(_nouveauCommentaireTexte)) return;
        var etat = await AuthProvider.GetAuthenticationStateAsync();
        var acteur = etat.User.Identity?.Name ?? "inconnu";
        _erreur = await Tickets.CommenterAsync(_ticket.Id, acteur, _nouveauCommentaireTexte, _nouveauCommentaireInterne);
        if (_erreur is null)
        {
            _ticket = await Tickets.GetByIdAsync(_ticket.Id);
            _nouveauCommentaireTexte = string.Empty;
            _succes = "Commentaire ajouté.";
        }
    }
}
