@page "/operations"
@using Microsoft.AspNetCore.Authorization
@using N4Sentinel.Domain
@using N4Sentinel.Infrastructure.Orchestration
@using N4Sentinel.Infrastructure.Referential
@attribute [Authorize(Policy = N4Policies.PeutConsulter)]
@rendermode InteractiveServer
@inject WorkflowService Workflows
@inject ExecutionService Executions
@inject EnvironmentLockService Locks
@inject ReferentialService Referential
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav

<PageTitle>Opérations — N4 Sentinel</PageTitle>

<div class="space-y-6">

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Opérations</h1>
            <p class="text-xs sm:text-sm text-slate-400 mt-1 max-w-3xl leading-relaxed">
                Lancement et suivi des séquences d'exploitation.
                <strong class="text-white">Une seule opération mutative à la fois par environnement</strong> —
                les diagnostics en lecture, eux, restent toujours possibles.
            </p>
        </div>

        <div class="flex items-center gap-3">
            <select class="bg-slate-900 border border-slate-700 text-white rounded-xl px-3 py-2 text-xs font-semibold focus:ring-2 focus:ring-sky-500 focus:outline-none"
                    @bind="_envId" @bind:after="Recharger">
                <option value="@Guid.Empty">Choisir un environnement…</option>
                @foreach (var e in _environnements)
                {
                    <option value="@e.Id">@e.Code — @e.Name</option>
                }
            </select>

            <AuthorizeView Policy="@N4Policies.PeutExecuter">
                <a href="/operations/ponctuelle"
                   class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs transition whitespace-nowrap">
                    <i class="bi bi-lightning-charge"></i> Opération ponctuelle
                </a>
            </AuthorizeView>
        </div>
    </div>

    @if (_message is not null)
    {
        <div class="p-3.5 rounded-xl text-xs font-semibold border @_messageClass">@_message</div>
    }

    @if (_envId != Guid.Empty && _verrou is not null)
    {
        <div class="p-4 rounded-xl bg-amber-500/10 border border-amber-500/25 text-amber-200 text-xs leading-relaxed flex items-start gap-3">
            <i class="bi bi-lock-fill text-base mt-0.5"></i>
            <div>
                <strong>Environnement verrouillé.</strong>
                « @_verrou.Reason », par @_verrou.HeldBy depuis @_verrou.AcquiredAt.ToLocalTime().ToString("HH:mm").
                Aucune autre opération mutative ne peut être lancée tant que celle-ci n'est pas terminée.
                <a href="@($"/operations/{_verrou.ExecutionId}")" class="underline font-semibold ml-1">Voir l'opération en cours</a>
            </div>
        </div>
    }

    <!-- Lancement -->
    <AuthorizeView Policy="@N4Policies.PeutExecuter">
        @if (_envId != Guid.Empty)
        {
            <div class="glass-card rounded-2xl border border-slate-800 overflow-hidden">
                <div class="p-5 border-b border-slate-800">
                    <h3 class="text-sm font-bold text-white flex items-center gap-2">
                        <i class="bi bi-play-circle text-sky-400"></i> Lancer une opération
                    </h3>
                </div>

                @if (_lancables.Count == 0)
                {
                    <div class="p-6 text-xs text-slate-400 space-y-2">
                        <p>Aucun workflow validé pour cet environnement.</p>
                        <a href="/admin/workflows" class="text-theme-primary hover:underline font-semibold">
                            Définir un workflow →
                        </a>
                    </div>
                }
                else
                {
                    <div class="p-5 space-y-4 text-xs">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-slate-400 font-semibold mb-1">Workflow</label>
                                <select class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-white"
                                        @bind="_workflowId">
                                    <option value="@Guid.Empty">Choisir…</option>
                                    @foreach (var w in _lancables)
                                    {
                                        <option value="@w.Id">@w.Name (v@w.Version) — @w.Steps.Count étape(s)</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label class="block text-slate-400 font-semibold mb-1">Référence de ticket</label>
                                <input class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-white"
                                       placeholder="INC-1234 (facultatif)" @bind="_ticket" />
                            </div>
                        </div>

                        <div>
                            <label class="block text-slate-400 font-semibold mb-1">
                                Motif <span class="text-rose-400">obligatoire</span>
                            </label>
                            <textarea rows="2" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-white"
                                      placeholder="Pourquoi cette opération, maintenant." @bind="_motif"></textarea>
                            <p class="text-[10px] text-slate-500 mt-1">
                                Une opération sans motif est une opération que personne ne saura expliquer trois mois plus tard.
                            </p>
                        </div>

                        <label class="flex items-center gap-2 text-slate-300 cursor-pointer">
                            <input type="checkbox" class="rounded bg-slate-900 border-slate-700" @bind="_simulation" />
                            <span>
                                <strong>Simulation</strong> — aucune commande n'est émise, la séquence est déroulée à blanc.
                            </span>
                        </label>

                        @if (_apercu is not null)
                        {
                            <div class="p-3.5 rounded-xl bg-slate-900/60 border border-slate-700 space-y-2">
                                <div class="font-bold text-white">Impact attendu</div>
                                <p class="text-slate-300 leading-relaxed">@_apercu</p>
                            </div>
                        }

                        <button class="px-4 py-2.5 rounded-xl btn-theme-primary text-white font-bold text-xs transition disabled:opacity-40 inline-flex items-center gap-2"
                                disabled="@(_workflowId == Guid.Empty || string.IsNullOrWhiteSpace(_motif) || _enCours)"
                                @onclick="Preparer">
                            <i class="bi bi-play-fill"></i>
                            @(_enCours ? "Préparation…" : _simulation ? "Lancer la simulation" : "Préparer l'opération")
                        </button>
                    </div>
                }
            </div>
        }
    </AuthorizeView>

    <!-- Historique -->
    <div class="glass-card rounded-2xl border border-slate-800 overflow-hidden">
        <div class="p-5 border-b border-slate-800">
            <h3 class="text-sm font-bold text-white flex items-center gap-2">
                <i class="bi bi-clock-history text-sky-400"></i> Opérations récentes
            </h3>
        </div>

        @if (_recentes.Count == 0)
        {
            <div class="p-8 text-center text-slate-400 text-xs">Aucune opération enregistrée.</div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-xs">
                    <thead class="bg-slate-900/60 text-slate-400 uppercase text-[10px] tracking-wider">
                        <tr>
                            <th class="text-left px-5 py-3 font-bold">Opération</th>
                            <th class="text-left px-5 py-3 font-bold">Demandeur</th>
                            <th class="text-left px-5 py-3 font-bold">Lancée</th>
                            <th class="text-left px-5 py-3 font-bold">Durée</th>
                            <th class="text-center px-5 py-3 font-bold">État</th>
                            <th class="text-right px-5 py-3 font-bold"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-800">
                        @foreach (var x in _recentes)
                        {
                            <tr class="hover:bg-white/[0.02] transition">
                                <td class="px-5 py-3.5">
                                    <div class="font-bold text-white flex items-center gap-2">
                                        @x.WorkflowName
                                        <span class="font-mono text-[10px] text-slate-500">v@x.WorkflowVersion</span>
                                        @if (x.IsSimulation)
                                        {
                                            <span class="px-2 py-0.5 rounded-md bg-slate-700/50 text-slate-300 text-[10px] font-bold">SIMULATION</span>
                                        }
                                    </div>
                                    <div class="text-[10px] text-slate-500 font-mono">@x.EnvironmentCode &middot; @x.CorrelationId</div>
                                </td>
                                <td class="px-5 py-3.5 text-slate-300">@x.RequestedBy</td>
                                <td class="px-5 py-3.5 text-slate-400">
                                    @(x.StartedAt?.ToLocalTime().ToString("dd/MM HH:mm") ?? "—")
                                </td>
                                <td class="px-5 py-3.5 text-slate-400">
                                    @(x.Duration is { } d ? StepExecutor.Formater(d) : "—")
                                </td>
                                <td class="px-5 py-3.5 text-center">
                                    <span class="px-2.5 py-1 rounded-full text-[10px] font-bold @PastilleEtat(x.Status)">
                                        @LibelleEtat(x.Status)
                                    </span>
                                </td>
                                <td class="px-5 py-3.5 text-right">
                                    <a href="@($"/operations/{x.Id}")"
                                       class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold transition">
                                        <i class="bi bi-eye"></i> Suivre
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private List<N4Environment> _environnements = [];
    private List<Workflow> _lancables = [];
    private List<WorkflowExecution> _recentes = [];
    private EnvironmentLock? _verrou;

    private Guid _envId;
    private Guid _workflowId;
    private string _motif = string.Empty;
    private string _ticket = string.Empty;
    private bool _simulation;
    private bool _enCours;

    private string? _apercu;
    private string? _message;
    private string _messageClass = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _environnements = await Referential.GetEnvironmentsAsync();
        if (_environnements.Count == 1) _envId = _environnements[0].Id;
        await Recharger();
    }

    private async Task Recharger()
    {
        _recentes = await Executions.GetRecentAsync(_envId == Guid.Empty ? null : _envId);

        if (_envId == Guid.Empty)
        {
            _lancables = [];
            _verrou = null;
            return;
        }

        _lancables = await Workflows.GetRunnableAsync(_envId);
        _verrou = await Locks.GetAsync(_envId);
        if (_verrou is { IsExpired: true }) _verrou = null;
    }

    private async Task Preparer()
    {
        _enCours = true;
        _message = null;

        var etat = await AuthProvider.GetAuthenticationStateAsync();
        var acteur = etat.User.Identity?.Name ?? "inconnu";

        var prep = await Executions.PrepareAsync(
            _workflowId, acteur, _motif,
            string.IsNullOrWhiteSpace(_ticket) ? null : _ticket.Trim(), _simulation);

        _enCours = false;

        if (!prep.Succeeded)
        {
            Signaler(prep.Error!, false);
            return;
        }

        Nav.NavigateTo($"/operations/{prep.ExecutionId}");
    }

    private void Signaler(string message, bool succes)
    {
        _message = message;
        _messageClass = succes
            ? "bg-emerald-500/10 border-emerald-500/20 text-emerald-300"
            : "bg-rose-500/10 border-rose-500/20 text-rose-300";
    }

    public static string LibelleEtat(ExecutionStatus s) => s switch
    {
        ExecutionStatus.EnPreparation => "En préparation",
        ExecutionStatus.EnAttenteApprobation => "Attend approbation",
        ExecutionStatus.EnCours => "En cours",
        ExecutionStatus.EnPause => "En pause",
        ExecutionStatus.AnnulationDemandee => "Annulation demandée",
        ExecutionStatus.ReconciliationRequise => "Réconciliation requise",
        ExecutionStatus.TermineSucces => "Terminée",
        ExecutionStatus.TermineAvecAvertissements => "Terminée avec réserves",
        ExecutionStatus.Echec => "En échec",
        ExecutionStatus.Annule => "Annulée",
        _ => s.ToString()
    };

    public static string PastilleEtat(ExecutionStatus s) => s switch
    {
        ExecutionStatus.TermineSucces => "bg-emerald-500/10 text-emerald-400 border border-emerald-500/20",
        ExecutionStatus.TermineAvecAvertissements => "bg-amber-500/10 text-amber-400 border border-amber-500/20",
        ExecutionStatus.Echec => "bg-rose-500/10 text-rose-400 border border-rose-500/20",
        ExecutionStatus.EnCours => "bg-sky-500/10 text-sky-400 border border-sky-500/20",
        ExecutionStatus.EnPause or ExecutionStatus.ReconciliationRequise
            => "bg-amber-500/10 text-amber-400 border border-amber-500/20",
        ExecutionStatus.EnAttenteApprobation => "bg-violet-500/10 text-violet-300 border border-violet-500/20",
        _ => "bg-slate-800 text-slate-400 border border-slate-700"
    };
}
