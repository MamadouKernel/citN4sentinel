<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\N4Sentinel.Domain\N4Sentinel.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Les ordres de demarrage et d'arret N4 (WorkflowService.RangDemarrage /
         RangArret) sont internes : ils n'ont pas a etre appeles depuis
         l'interface. Ils doivent en revanche etre TESTES, car ils encodent une
         procedure editeur dont l'inversion silencieuse produirait un arret
         incorrect sur un terminal reel. -->
    <InternalsVisibleTo Include="N4Sentinel.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- N4SignInManager et UserAdministrationService (comptes et roles, FR-091)
         ont besoin de SignInManager/IEmailSender<T>/IAuthenticationSchemeProvider,
         qui vivent dans le framework partage plutot que dans un paquet NuGet
         independant comme UserManager/RoleManager. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.6.4" />
    <PackageReference Include="PdfPig" Version="0.1.15" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
