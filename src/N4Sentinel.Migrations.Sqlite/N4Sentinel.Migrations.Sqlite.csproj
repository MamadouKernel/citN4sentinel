<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Migrations SQLite, dans un assemblage SEPARE.

    EF Core decouvre toutes les classes Migration presentes dans l'assemblage
    de migrations, sans distinguer le fournisseur. Laisser les deux jeux
    ensemble ferait tenter d'appliquer a SQLite des migrations qui parlent de
    nvarchar, d'uniqueidentifier et de rowversion : elles echoueraient, et
    l'echec surviendrait au demarrage, chez le client.

    Ce projet ne contient donc QUE des migrations. Aucun code metier.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>N4Sentinel.Migrations.Sqlite</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\N4Sentinel.Infrastructure\N4Sentinel.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Epinglage de securite. L'outillage EF Core Design tire transitivement
      System.Security.Cryptography.Xml 10.0.6, qui porte cinq vulnerabilites de
      gravite elevee. Il n'est PAS embarque a l'execution - verifie sur la
      publication : la DLL est absente du paquet - mais laisser un
      avertissement de securite permanent au build apprend a ignorer les
      avertissements, et c'est ainsi qu'on rate le suivant.

      PrivateAssets : l'epinglage ne concerne que la compilation de ce projet
      et ne se propage pas.
    -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.11" PrivateAssets="all" />

    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
